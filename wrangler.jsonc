{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "qrivo",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"PUBLIC_SUPABASE_URL": "https://julfsqeucjdsnsuqvpzv.supabase.co",
		"PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_JAWTqsntLFC5_98ZjGLgRA_hpknzcN9",
		"IMAGEKIT_PUBLIC_KEY": "public_Wz0GcrXI1qkDaRi/KpadEIzsuDE=",
		// IMAGEKIT_PRIVATE_KEY is a secret. Never put it here.
		// Local: add it to .env (see .env.example).
		// Production: npx wrangler secret put IMAGEKIT_PRIVATE_KEY
		"IMAGEKIT_URL_ENDPOINT":"https://ik.imagekit.io/vv3nigxnf"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
  {
    "binding": "SESSION",
    "id": "9c7de11fac2949769d373b0b46a50199"
  }
	]
}
