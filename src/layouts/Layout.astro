---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  brandColor?: string;
  hideNav?: boolean;
}

const {
  title = 'Qrivo | Smart QR Counter Cards for Google Reviews',
  description = 'Transform customer counter scans into verified 5-star Google reviews and direct WhatsApp inquiries in 10 seconds.',
  brandColor = '#4f46e5',
  hideNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content={brandColor} />
    <style define:vars={{ brand: brandColor }}>
      :root {
        --brand: var(--brand);
      }
    </style>
  </head>
  <body>
    {!hideNav && (
      <header class="site-nav no-print">
        <div class="container site-nav-inner">
          <a href="/" class="brand-badge">
            <div class="brand-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f5c518" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <span>Qrivo</span>
          </a>

          <nav>
            <a href="/artisan-cafe" class="btn btn-outline btn-sm site-nav-demo" title="View live counter demo">
              ☕ Live Demo
            </a>
            <a href="/admin" class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M7 7h10v10H7z"></path>
              </svg>
              Admin Portal
            </a>
          </nav>
        </div>
      </header>
    )}

    <main>
      <slot />
    </main>
  </body>
</html>
