---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { DEMO_BUSINESSES } from '../lib/demo-businesses';
import { DatabaseService } from '../lib/supabase';
import type { Business } from '../types';

let business: Business = DEMO_BUSINESSES.find((b) => b.slug === 'review-hub') || {
  id: 'demo-review-hub',
  name: 'ReviewHub',
  slug: 'review-hub',
  logo_url: '/review-hub-logo.svg',
  brand_color: '#6366f1',
  tagline: 'Smart QR Counter Cards for Google Reviews & Instant Connections',
  google_review_url: 'https://search.google.com/local/writereview?placeid=ChIJN1t_tDeuEmsRUsoyG83frY4',
  whatsapp_number: '+15550192834',
  whatsapp_message: 'Hi ReviewHub! I would like to get smart QR counter cards for my business.',
  phone_number: '+15550192834',
  instagram_url: 'https://instagram.com/reviewhubapp',
  facebook_url: 'https://facebook.com/reviewhubapp',
  custom_message: 'Turn counter scans into 5-star Google reviews in seconds. Update destinations anytime without reprinting physical QR stands!',
  is_active: true,
  created_at: new Date().toISOString(),
};

try {
  if (DatabaseService.isConfigured()) {
    const fromDb = await DatabaseService.getBusinessBySlug('review-hub');
    if (fromDb) {
      business = fromDb;
    }
  }
} catch (e) {
  // Use default ReviewHub configuration if Supabase is unavailable during build
}

const brandColor = business?.brand_color || '#6366f1';
const pageTitle = `${business.name} | Smart QR Counter Cards & Reviews`;
---

<Layout title={pageTitle} brandColor={brandColor} hideNav={true}>
  <div class="counter-page-wrapper" id="counterPageWrapper" data-slug="review-hub" data-biz-id={business?.id || ''}>
    
    <!-- Active Business Counter View -->
    <div class="counter-card" id="activeBizCard" style={business && !business.is_active ? 'display: none;' : ''}>
      
      <!-- Brand Logo -->
      <div class="biz-logo-container">
        <img
          id="bizLogoImg"
          src={business?.logo_url || '/review-hub-logo.svg'}
          alt={business?.name || 'ReviewHub Logo'}
          class="biz-logo-img"
          loading="eager"
        />
      </div>

      <!-- Verified Badge -->
      <div>
        <span class="verified-pill">
          <Icon name="shield-check" size={13} fill="#60a5fa" />
          <span>Verified Platform Hub</span>
        </span>
      </div>

      <!-- Business Name & Tagline -->
      <h1 class="biz-title" id="bizTitle">{business?.name || 'ReviewHub'}</h1>
      <p class="biz-tagline" id="bizTagline">{business?.tagline || 'Smart QR Counter Cards for Google Reviews'}</p>

      <!-- 5-Star Experience Rating Bar -->
      <div class="rating-prompt-card">
        <div class="rating-prompt-title">How was your experience today?</div>
        <div class="stars-row" id="starsRow" title="Tap 5 stars to leave a review on Google">
          <button type="button" class="star-btn" data-rating="1" aria-label="Rate 1 star">★</button>
          <button type="button" class="star-btn" data-rating="2" aria-label="Rate 2 stars">★</button>
          <button type="button" class="star-btn" data-rating="3" aria-label="Rate 3 stars">★</button>
          <button type="button" class="star-btn" data-rating="4" aria-label="Rate 4 stars">★</button>
          <button type="button" class="star-btn" data-rating="5" aria-label="Rate 5 stars">★</button>
        </div>
      </div>

      <!-- Primary CTA: Rate us on Google -->
      <a
        id="googleCtaBtn"
        href={business?.google_review_url || 'https://search.google.com/local/writereview?placeid=ChIJN1t_tDeuEmsRUsoyG83frY4'}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary-google"
      >
        <Icon name="google" size={24} />
        <div style="text-align: left; flex: 1;">
          <div style="font-size: 1.0625rem; font-weight: 700; line-height: 1.2;">Rate us on Google</div>
          <div style="font-size: 0.75rem; color: #6b7280; font-weight: 500;">Takes 10 seconds · Direct link</div>
        </div>
        <div class="stars-badge-mini">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
      </a>

      <!-- Secondary CTA: WhatsApp (Optional) -->
      <a
        id="whatsappCtaBtn"
        href={`https://wa.me/${(business?.whatsapp_number || '+15550192834').replace(/\D/g, '')}${business?.whatsapp_message ? `?text=${encodeURIComponent(business.whatsapp_message)}` : ''}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary-wa"
        style={business?.whatsapp_number ? 'display: flex;' : 'display: none;'}
      >
        <Icon name="whatsapp" size={20} fill="#ffffff" />
        <span>Chat with us on WhatsApp</span>
      </a>

      <!-- Quick Social & Contact Action Grid -->
      <div class="social-grid">
        <a id="phoneBtn" href={`tel:${(business?.phone_number || '+15550192834').replace(/\s+/g, '')}`} class="social-action-btn" title="Call Us">
          <div class="social-icon-box">
            <Icon name="phone" size={18} fill="#38bdf8" />
          </div>
          <span>Call</span>
        </a>

        <a id="waGridBtn" href={`https://wa.me/${(business?.whatsapp_number || '+15550192834').replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="social-action-btn" title="WhatsApp">
          <div class="social-icon-box">
            <Icon name="whatsapp" size={18} fill="#22c55e" />
          </div>
          <span>WhatsApp</span>
        </a>

        <a id="instagramBtn" href={business?.instagram_url || 'https://instagram.com'} target="_blank" rel="noopener noreferrer" class="social-action-btn" title="Instagram">
          <div class="social-icon-box">
            <Icon name="instagram" size={18} fill="#e1306c" />
          </div>
          <span>Instagram</span>
        </a>

        <a id="facebookBtn" href={business?.facebook_url || 'https://facebook.com'} target="_blank" rel="noopener noreferrer" class="social-action-btn" title="Facebook">
          <div class="social-icon-box">
            <Icon name="facebook" size={18} fill="#1877f2" />
          </div>
          <span>Facebook</span>
        </a>
      </div>

      <!-- Owner Thank-You Message -->
      <div id="customMessage" class="custom-note">
        {business?.custom_message || 'Turn counter scans into 5-star Google reviews in seconds. Update destinations anytime without reprinting physical QR stands!'}
      </div>

      <!-- Quick Links: Admin & Live Demo Stand -->
      <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-subtle); display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/admin" class="btn btn-outline btn-sm" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem;">
          <Icon name="settings" size={14} />
          <span>Admin Portal</span>
        </a>
        <a href="/artisan-cafe" class="btn btn-outline btn-sm" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem;">
          <Icon name="sparkles" size={14} />
          <span>Demo Businesses</span>
        </a>
      </div>

      <!-- Reusable QR Powered by ReviewHub Footer -->
      <div class="counter-footer">
        <span>Powered by</span>
        <a href="/">ReviewHub</a>
        <span>· Reusable Counter Stand</span>
      </div>
    </div>

    <!-- Inactive State -->
    <div class="counter-card" id="inactiveBizCard" style={business && !business.is_active ? 'display: block;' : 'display: none;'}>
      <div style="padding: 2.5rem 1rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">🏷️</div>
        <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem; color: #ffffff;">
          Counter Stand Temporarily Unavailable
        </h2>
        <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.5rem;">
          This business card is currently paused or undergoing updates by the administrator.
        </p>
        <a href="/admin" class="btn btn-primary btn-sm">
          Open Admin Portal
        </a>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { DatabaseService } from '../lib/supabase';
  import type { Business, EventType } from '../types';

  const slug = 'review-hub';

  // Elements
  const activeCard = document.getElementById('activeBizCard');
  const inactiveCard = document.getElementById('inactiveBizCard');

  const bizLogoImg = document.getElementById('bizLogoImg') as HTMLImageElement;
  const bizTitle = document.getElementById('bizTitle');
  const bizTagline = document.getElementById('bizTagline');
  const customMessage = document.getElementById('customMessage');

  const googleCtaBtn = document.getElementById('googleCtaBtn') as HTMLAnchorElement;
  const whatsappCtaBtn = document.getElementById('whatsappCtaBtn') as HTMLAnchorElement;
  const phoneBtn = document.getElementById('phoneBtn') as HTMLAnchorElement;
  const waGridBtn = document.getElementById('waGridBtn') as HTMLAnchorElement;
  const instagramBtn = document.getElementById('instagramBtn') as HTMLAnchorElement;
  const facebookBtn = document.getElementById('facebookBtn') as HTMLAnchorElement;
  const starsRow = document.getElementById('starsRow');

  let currentBusiness: Business | null = null;

  async function resolveBusiness() {
    let biz: Business | null = null;
    try {
      biz = await DatabaseService.getBusinessBySlug(slug);
    } catch (error) {
      console.warn('Unable to load ReviewHub from Supabase, using defaults:', error);
    }

    if (!biz) {
      // Use fallback defaults
      return;
    }

    currentBusiness = biz;

    if (!biz.is_active) {
      if (activeCard) activeCard.style.display = 'none';
      if (inactiveCard) inactiveCard.style.display = 'block';
      return;
    }

    // Apply branding
    document.title = `${biz.name} | Smart QR Counter Cards & Reviews`;
    if (biz.brand_color) {
      document.documentElement.style.setProperty('--brand', biz.brand_color);
      document.documentElement.style.setProperty('--brand-glow', `${biz.brand_color}40`);
    }

    if (bizLogoImg && biz.logo_url) {
      bizLogoImg.src = biz.logo_url;
      bizLogoImg.alt = biz.name;
    }
    if (bizTitle) bizTitle.textContent = biz.name;
    if (bizTagline) bizTagline.textContent = biz.tagline || 'Smart QR Counter Cards for Google Reviews';

    if (customMessage && biz.custom_message) {
      customMessage.textContent = biz.custom_message;
    }

    if (googleCtaBtn && biz.google_review_url) {
      googleCtaBtn.href = biz.google_review_url;
    }

    const waUrl = biz.whatsapp_number
      ? `https://wa.me/${biz.whatsapp_number.replace(/\D/g, '')}${
          biz.whatsapp_message ? `?text=${encodeURIComponent(biz.whatsapp_message)}` : ''
        }`
      : '#';

    if (whatsappCtaBtn) {
      if (biz.whatsapp_number) {
        whatsappCtaBtn.href = waUrl;
        whatsappCtaBtn.style.display = 'flex';
      } else {
        whatsappCtaBtn.style.display = 'none';
      }
    }

    if (phoneBtn) {
      if (biz.phone_number) {
        phoneBtn.href = `tel:${biz.phone_number.replace(/\s+/g, '')}`;
        phoneBtn.style.display = 'flex';
      } else {
        phoneBtn.style.display = 'none';
      }
    }

    if (waGridBtn) {
      if (biz.whatsapp_number) {
        waGridBtn.href = waUrl;
        waGridBtn.style.display = 'flex';
      } else {
        waGridBtn.style.display = 'none';
      }
    }

    if (instagramBtn) {
      if (biz.instagram_url) {
        instagramBtn.href = biz.instagram_url;
        instagramBtn.style.display = 'flex';
      } else {
        instagramBtn.style.display = 'none';
      }
    }

    if (facebookBtn) {
      if (biz.facebook_url) {
        facebookBtn.href = biz.facebook_url;
        facebookBtn.style.display = 'flex';
      } else {
        facebookBtn.style.display = 'none';
      }
    }

    track('page_view');
  }

  function track(eventType: EventType) {
    if (!currentBusiness) return;
    void DatabaseService.trackEvent({
      business_id: currentBusiness.id,
      slug: currentBusiness.slug,
      event_type: eventType,
    }).catch((error) => console.warn('Supabase analytics error:', error));
  }

  googleCtaBtn?.addEventListener('click', () => {
    track('google_review_click');
  });

  whatsappCtaBtn?.addEventListener('click', () => {
    track('whatsapp_click');
  });

  waGridBtn?.addEventListener('click', () => {
    track('whatsapp_click');
  });

  phoneBtn?.addEventListener('click', () => {
    track('call_click');
  });

  instagramBtn?.addEventListener('click', () => {
    track('instagram_click');
  });

  facebookBtn?.addEventListener('click', () => {
    track('facebook_click');
  });

  starsRow?.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.star-btn');
    if (!target) return;

    target.animate([
      { transform: 'scale(1)' },
      { transform: 'scale(1.4) rotate(15deg)' },
      { transform: 'scale(1)' }
    ], { duration: 350 });

    track('google_review_click');

    const reviewUrl = currentBusiness?.google_review_url || googleCtaBtn?.href;
    if (reviewUrl && reviewUrl !== '#') {
      setTimeout(() => {
        window.open(reviewUrl, '_blank', 'noopener,noreferrer');
      }, 250);
    }
  });

  resolveBusiness();
</script>
