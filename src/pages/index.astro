---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { DEMO_BUSINESSES } from '../lib/demo-businesses';
---

<Layout title="ReviewHub | Smart QR Counter Cards for Google Reviews & Social Engagement">
  <div style="overflow-hidden;">
    
    <!-- Hero Section -->
    <section style="padding: 5rem 1rem 4rem 1rem; text-align: center; background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.2) 0%, rgba(9, 13, 22, 1) 70%);">
      <div class="container" style="max-width: 860px;">
        
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: var(--radius-full); padding: 0.35rem 0.95rem; font-size: 0.8125rem; font-weight: 600; color: #a5b4fc; margin-bottom: 1.5rem;">
          <Icon name="sparkles" size={15} />
          <span>Reusable Counter QR Cards for Local Businesses</span>
        </div>

        <h1 style="font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 900; line-height: 1.15; letter-spacing: -0.03em; color: #ffffff; margin-bottom: 1.25rem;">
          Turn Counter Scans into <br />
          <span style="background: linear-gradient(135deg, #60a5fa, #818cf8, #fbbf24); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            5-Star Google Reviews
          </span>
          in Seconds
        </h1>

        <p style="font-size: 1.125rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 2.25rem; max-width: 680px; margin-left: auto; margin-right: auto;">
          Place a sleek QR stand at your counter. Customers scan with their phone and land on a fast, branded page where they can rate you on Google with 1 tap, start a WhatsApp chat, and follow your socials.
        </p>

        <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 3.5rem;">
          <a href="/admin" class="btn btn-primary" style="padding: 0.9rem 1.75rem; font-size: 1.0625rem;">
            <Icon name="settings" size={18} />
            <span>Open Admin Dashboard</span>
          </a>
          <a href="/artisan-cafe" class="btn btn-outline" style="padding: 0.9rem 1.75rem; font-size: 1.0625rem;">
            <span>☕ Test Live Counter Page</span>
          </a>
        </div>

        <!-- Counter QR Problem & Solution Highlight Banner -->
        <div class="glass-card" style="padding: 1.5rem 2rem; border-color: rgba(99, 102, 241, 0.3); text-align: left; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
          <div style="font-size: 2.5rem; background: rgba(99, 102, 241, 0.15); border-radius: 16px; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            ♻️
          </div>
          <div style="flex: 1; min-width: 260px;">
            <h3 style="font-size: 1.0625rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">
              Never Reprint Physical Counter Stands Again
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">
              The QR code points to a dynamic slug (<code>https://reviewhub.example.com/slug</code>). If the business changes Google links, updates WhatsApp, rejects the service, or is replaced by another business, you update the slug destination in the admin panel instantly without reprinting!
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Live Counter Demos Showcase -->
    <section style="padding: 4rem 1rem; background: var(--bg-surface); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
      <div class="container">
        
        <div style="text-align: center; margin-bottom: 3rem;">
          <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; margin-bottom: 0.5rem;">
            Explore Live Business Counter Cards
          </h2>
          <p style="font-size: 0.9375rem; color: var(--text-muted);">
            Click any demo business below to experience the mobile-first customer flow:
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
          {DEMO_BUSINESSES.map((b) => (
            <div class="glass-card" style={`padding: 1.75rem; border-top: 4px solid ${b.brand_color}; display: flex; flex-direction: column; justify-content: space-between;`}>
              <div>
                <div style="display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1rem;">
                  <img
                    src={b.logo_url}
                    alt={b.name}
                    style={`width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid ${b.brand_color};`}
                  />
                  <div>
                    <h3 style="font-size: 1.125rem; font-weight: 700; color: #ffffff; line-height: 1.2;">
                      {b.name}
                    </h3>
                    <span style="font-size: 0.75rem; color: #818cf8; font-family: monospace;">/{b.slug}</span>
                  </div>
                </div>

                <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
                  {b.tagline}
                </p>

              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
                <span style="font-size: 0.8125rem; color: #fbbf24; font-weight: 600;">
                  ★★★★★ 5.0 Rating
                </span>
                <a href={`/${b.slug}`} class="btn btn-primary btn-sm">
                  <span>Open Page ↗</span>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- How It Works Flow -->
    <section style="padding: 4.5rem 1rem;">
      <div class="container">
        
        <div style="text-align: center; margin-bottom: 3.5rem;">
          <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; margin-bottom: 0.5rem;">
            How ReviewHub Works
          </h2>
          <p style="font-size: 0.9375rem; color: var(--text-muted);">
            Simple 3-step loop designed for busy counter checkouts
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
          
          <div class="glass-card" style="padding: 2rem; text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">1️⃣</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">
              Print Reusable Counter QR
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">
              In the Admin Portal, select your business and click "Print Counter Tent Stand" or download the high-res PNG/SVG. Place it at the counter or register.
            </p>
          </div>

          <div class="glass-card" style="padding: 2rem; text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">2️⃣</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">
              Customer Scans at Checkout
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">
              Customer scans with their phone camera. They land instantly on a fast, mobile-first page styled with your brand colors, logo, and active promotions.
            </p>
          </div>

          <div class="glass-card" style="padding: 2rem; text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">3️⃣</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">
              1-Tap 5-Star Reviews & Chats
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">
              Tapping "Rate us on Google" or any rating star launches the direct Google review form in a new tab. Customers can also initiate a WhatsApp chat or follow social links.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- Footer -->
    <footer style="padding: 2.5rem 1rem; border-top: 1px solid var(--border-subtle); text-align: center; font-size: 0.875rem; color: var(--text-muted);">
      <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <strong>ReviewHub</strong> · Smart QR Counter Cards & Review Acceleration
        </div>
        <div style="display: flex; gap: 1.5rem;">
          <a href="/admin" style="color: #818cf8;">Admin Portal</a>
          <a href="/artisan-cafe" style="color: var(--text-muted);">Sample Cafe</a>
          <a href="/downtown-smiles" style="color: var(--text-muted);">Sample Clinic</a>
          <a href="/apex-auto" style="color: var(--text-muted);">Sample Auto</a>
        </div>
      </div>
    </footer>

  </div>
</Layout>
