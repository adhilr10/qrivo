---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="ReviewHub Admin Sign In" hideNav={true}>
  <main class="auth-shell">
    <section class="auth-card" aria-labelledby="auth-title">
      <a href="/" class="auth-brand">ReviewHub</a>
      <p class="auth-kicker">ADMIN PORTAL</p>
      <h1 id="auth-title">Sign in to manage businesses</h1>
      <p class="auth-copy">Use the administrator email and password created in Supabase to access business settings and analytics.</p>

      <form id="authForm" class="auth-form">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required placeholder="admin@example.com" />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required minlength="6" placeholder="At least 6 characters" />

        <p id="authMessage" class="auth-message" role="status" aria-live="polite"></p>

        <button id="signInBtn" class="btn btn-primary" type="submit">Sign in</button>
      </form>

      <p class="auth-footnote">Only accounts already created in Supabase Authentication can sign in.</p>
    </section>
  </main>
</Layout>

<style>
  .auth-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.5rem;
    background: #fffdf5;
    background-image:
      linear-gradient(rgba(10,10,10,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10,10,10,.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .auth-card {
    width: min(100%, 440px);
    padding: 2.25rem;
    border: 2.5px solid #0a0a0a;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 8px 8px 0 #0a0a0a;
  }

  .auth-brand {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 800;
    color: #0a0a0a;
    text-decoration: none;
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
  }

  .auth-kicker {
    margin: 0 0 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a4a4a;
  }

  h1 {
    margin: 0 0 0.5rem;
    color: #0a0a0a;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .auth-copy, .auth-footnote {
    color: #4a4a4a;
    font-size: 0.875rem;
    line-height: 1.55;
    font-weight: 500;
  }

  .auth-form {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .auth-form label {
    color: #0a0a0a;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 0.5rem;
  }

  .auth-form input {
    width: 100%;
    box-sizing: border-box;
    border: 2.5px solid #0a0a0a;
    border-radius: 6px;
    padding: 0.75rem 0.875rem;
    color: #0a0a0a;
    background: #fffdf5;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    box-shadow: 3px 3px 0 #0a0a0a;
    transition: box-shadow 0.12s;
  }

  .auth-form input:focus {
    outline: none;
    box-shadow: 5px 5px 0 #0a0a0a;
  }

  .auth-form button {
    justify-content: center;
    margin-top: 0.75rem;
    width: 100%;
    padding: 0.875rem 1.25rem;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 2.5px solid #0a0a0a;
    border-radius: 6px;
    background: #f5c518;
    color: #0a0a0a;
    cursor: pointer;
    box-shadow: 4px 4px 0 #0a0a0a;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .auth-form button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #0a0a0a;
  }

  .auth-form button:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #0a0a0a;
  }

  .auth-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .auth-message {
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
    color: #e63946;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .auth-message.success {
    color: #15803d;
  }

  .auth-footnote {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    border-top: 2.5px solid #0a0a0a;
    padding-top: 1rem;
  }

  /* Divider above form */
  .auth-divider {
    border: none;
    border-top: 2.5px solid #0a0a0a;
    margin: 1.5rem 0 0;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('authForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const message = document.getElementById('authMessage');
  const signInBtn = document.getElementById('signInBtn') as HTMLButtonElement;

  function setMessage(text: string, success = false) {
    if (!message) return;
    message.textContent = text;
    message.classList.toggle('success', success);
  }

  function setBusy(busy: boolean) {
    signInBtn.disabled = busy;
    signInBtn.textContent = busy ? 'Please wait…' : 'Sign in';
  }

  async function redirectIfAuthenticated() {
    if (!supabase) return;
    const { data } = await supabase.auth.getUser();
    if (data.user) window.location.replace('/admin');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase) {
      setMessage('Supabase is not configured. Add the public URL and anon key to .env.');
      return;
    }
    setBusy(true);
    setMessage('');
    const { error } = await supabase.auth.signInWithPassword({
      email: emailInput.value.trim(),
      password: passwordInput.value,
    });
    setBusy(false);
    if (error) {
      setMessage(error.message);
      return;
    }
    window.location.replace('/admin');
  });

  redirectIfAuthenticated();
</script>
