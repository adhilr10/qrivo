  // ── Data loading ────────────────────────────────────────────────────────
  async function loadData() {
    if (!supabase) { window.location.replace('/admin/login'); return; }

    const { data: authData, error: authError } = await supabase.auth.getUser();
    if (authError || !authData.user) { window.location.replace('/admin/login'); return; }
    if (adminUserEmail) adminUserEmail.textContent = authData.user.email || 'Signed in';

    const config = getSupabaseConfig();
    if (backendStatusPill && backendStatusText) {
      if (config.isConfigured) {
        backendStatusPill.className = 'status-pill online';
        backendStatusText.textContent = 'Supabase Connected';
      } else {
        backendStatusPill.className = 'status-pill local';
        backendStatusText.textContent = 'Not configured';
      }
    }

    try {
      businesses = await DatabaseService.getBusinesses();
      // QR codes are created in bulk and assigned later; never auto-create one
      // behind the admin's back, or a stand gets printed that nobody ordered.
      try {
        unassignedShortLinks = await DatabaseService.getUnassignedShortLinks();
      } catch { unassignedShortLinks = []; }
    } catch (error) {
      console.error('Unable to load businesses:', error);
      if (backendStatusPill && backendStatusText) {
        backendStatusPill.className = 'status-pill local';
        backendStatusText.textContent = 'Supabase unavailable';
      }
      if (businessListContainer) {
        businessListContainer.innerHTML = `<div class="loading-placeholder">Unable to load Supabase data. Check .env and schema, then refresh.</div>`;
      }
      return;
    }

    const count = String(businesses.length);
    if (bizCountBadge)  bizCountBadge.textContent  = count;
    if (mobileBizBadge) mobileBizBadge.textContent = count;

    renderBusinessesList();
    renderQrStock();
    populateQrStudio();

    await loadMoneyData();
  }

  // ── Business cards ──────────────────────────────────────────────────────
  // A sale is linked by id when picked from the dropdown; older manual entries
  // only carry the name, so fall back to a name match for those.
  function saleBelongsToBusiness(sale: QrSale, biz: Business): boolean {
    if (sale.business_id) return sale.business_id === biz.id;
    const saleName = (sale.business_name || '').trim().toLowerCase();
    return saleName !== '' && saleName === (biz.name || '').trim().toLowerCase();
  }

  function businessPaymentInfo(biz: Business) {
    const bizSales = sales.filter(sale => saleBelongsToBusiness(sale, biz));
    const paidSales = bizSales.filter(sale => sale.status === 'paid');
    const pendingSales = bizSales.filter(sale => sale.status === 'pending');
    const sumBy = (rows: QrSale[], key: 'amount' | 'quantity') =>
      rows.reduce((total, sale) => total + (Number(sale[key]) || 0), 0);

    return {
      status: (paidSales.length ? 'paid' : pendingSales.length ? 'pending' : 'unsold') as
        | 'paid'
        | 'pending'
        | 'unsold',
      paidAmount: sumBy(paidSales, 'amount'),
      paidUnits: sumBy(paidSales, 'quantity'),
      pendingAmount: sumBy(pendingSales, 'amount'),
      pendingUnits: sumBy(pendingSales, 'quantity'),
    };
  }

  function updateBizPayFilterCounts() {
    let paidCount = 0;
    for (const biz of businesses) {
      if (businessPaymentInfo(biz).status === 'paid') paidCount += 1;
    }
    const all = businesses.length;
    if (bizPayAllCount) bizPayAllCount.textContent = String(all);
    if (bizPayPaidCount) bizPayPaidCount.textContent = String(paidCount);
    if (bizPayUnpaidCount) bizPayUnpaidCount.textContent = String(all - paidCount);
  }

  function renderBusinessesList(filter = '') {
    if (!businessListContainer) return;
    const q = filter.toLowerCase().trim();
    const filtered = businesses.filter(b => {
      const matchesSearch =
        !q ||
        b.name.toLowerCase().includes(q) ||
        b.slug.toLowerCase().includes(q) ||
        (b.short_code || '').toLowerCase().includes(q) ||
        (b.owner_email || '').toLowerCase().includes(q);
      if (!matchesSearch) return false;
      if (bizPayFilter === 'all') return true;

      const isPaid = businessPaymentInfo(b).status === 'paid';
      return bizPayFilter === 'paid' ? isPaid : !isPaid;
    });

    updateBizPayFilterCounts();

    if (filtered.length === 0) {
      const hint = q || bizPayFilter !== 'all'
        ? ''
        : `<p style="font-size:.8rem;margin-top:.75rem;color:#767676;font-weight:500;max-width:34rem;margin-left:auto;margin-right:auto;">
             Missing a business another admin created? Open <strong>SQL</strong> in the top bar and run the policies once — they open the workspace to every signed-in admin.
           </p>`;
      businessListContainer.innerHTML = `
        <div style="grid-column:1/-1;text-align:center;padding:4rem 1rem;color:#4a4a4a;">
          <div style="font-size:2.5rem;margin-bottom:.5rem;">🏢</div>
          <div style="font-size:1rem;font-weight:800;color:#0a0a0a;">No businesses found</div>
          <p style="font-size:.875rem;margin-top:.25rem;font-weight:500;">${
            q || bizPayFilter !== 'all'
              ? 'Try adjusting your search or payment filter.'
              : 'Add a new business to get started.'
          }</p>
          ${hint}
        </div>`;
      return;
    }

    businessListContainer.innerHTML = filtered.map(b => {
      const fullUrl    = qrUrlFor(b);
      const shortPath  = b.short_code ? `/s/${b.short_code}` : '';
      const ownerEmail = b.owner_email || '';
      const initial    = ownerInitial(ownerEmail);
      const created    = b.created_at
        ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : '';
      const qrMeta = shortPath
        ? `<a href="${shortPath}" target="_blank" class="biz-card-short-link" title="Permanent QR link">${shortPath} ↗</a>`
        : `<span class="biz-card-no-qr">No QR assigned</span>`;
      const locationLine = businessLocationLine(b.place_name, b.road);

      const pay = businessPaymentInfo(b);
      const payClass =
        pay.status === 'paid' ? 'is-paid' : pay.status === 'pending' ? 'is-pending' : 'is-unsold';
      const payLabel =
        pay.status === 'paid' ? '✓ Paid' : pay.status === 'pending' ? '⏳ Pending' : 'Not paid';
      const payDetail =
        pay.status === 'paid'
          ? `${formatMoney(pay.paidAmount)} · ${pay.paidUnits} QR${pay.paidUnits === 1 ? '' : 's'}${
              pay.pendingAmount > 0 ? ` · ${formatMoney(pay.pendingAmount)} pending` : ''
            }`
          : pay.status === 'pending'
            ? `${formatMoney(pay.pendingAmount)} due`
            : 'No QR sold yet';
      const payTitle =
        pay.status === 'paid'
          ? `Paid ${formatMoney(pay.paidAmount)} for ${pay.paidUnits} QR${pay.paidUnits === 1 ? '' : 's'}${pay.pendingAmount > 0 ? `; ${formatMoney(pay.pendingAmount)} still pending` : ''}`
          : pay.status === 'pending'
            ? `${formatMoney(pay.pendingAmount)} payment pending for ${pay.pendingUnits} QR${pay.pendingUnits === 1 ? '' : 's'}`
            : 'No QR sale recorded for this business';

      return `
        <div class="biz-card-item" style="--card-brand:${b.brand_color};">

          <div class="biz-card-body">
            <!-- Logo + name + status -->
            <div class="biz-card-top">
              <img
                src="${b.logo_url || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=120&auto=format&fit=crop&q=80'}"
                alt="${b.name}"
                class="biz-card-logo"
              />
              <div class="biz-card-meta">
                <div class="biz-card-name" title="${b.name}">${b.name}</div>
                ${b.category || b.tagline ? `<div class="biz-card-category">${b.category || b.tagline}</div>` : ''}
                ${locationLine ? `<div class="biz-card-location" title="${locationLine}">📍 ${locationLine}</div>` : ''}
                ${qrMeta}
              </div>
              <span class="status-pill ${b.is_active ? 'online' : 'local'} biz-card-status">
                ${b.is_active ? 'Active' : 'Paused'}
              </span>
            </div>

            <!-- Owner -->
            <div class="biz-card-owner-row">
              <div class="biz-card-owner-avatar" title="${ownerEmail || 'unknown'}">${initial}</div>
              <div class="biz-card-owner-info">
                <span class="biz-card-owner-label">Created by</span>
                <span class="biz-card-owner-email" title="${ownerEmail}">${ownerShortName(ownerEmail) || 'Unknown admin'}</span>
              </div>
              ${created ? `<span class="biz-card-created-date">${created}</span>` : ''}
            </div>

            <!-- Payment: did this business actually buy a QR stand? -->
            <div class="biz-card-pay-row" title="${payTitle}">
              <span class="biz-card-pay ${payClass}">${payLabel}</span>
              <span class="biz-card-pay-detail">${payDetail}</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="biz-card-footer">
            <button
              class="btn btn-outline btn-sm copy-slug-btn"
              data-url="${fullUrl}"
              title="Copy QR short link"
              ${shortPath ? '' : 'disabled'}
            >
              📋 Copy QR
            </button>
            <div class="biz-card-action-group">
              <button class="btn btn-outline btn-sm open-qr-btn" data-id="${b.id}" title="QR Studio" ${shortPath ? '' : 'disabled'}>QR</button>
              <button class="btn btn-secondary btn-sm edit-biz-btn" data-id="${b.id}" title="Edit">Edit</button>
              <button class="btn btn-danger btn-sm delete-biz-btn" data-id="${b.id}" data-name="${b.name}" title="Delete">✕</button>
            </div>
          </div>

        </div>`;
    }).join('');

    attachCardListeners();
  }

  function attachCardListeners() {
    document.querySelectorAll('.copy-slug-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const el  = e.currentTarget as HTMLElement;
        const url = el.dataset.url || '';
        navigator.clipboard.writeText(url);
        const orig = el.innerHTML;
        el.innerHTML = '✓ Copied!';
        setTimeout(() => { el.innerHTML = orig; }, 1500);
      });
    });

    document.querySelectorAll('.edit-biz-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const biz = businesses.find(b => b.id === id);
        if (biz) openEditModal(biz);
      });
    });

    document.querySelectorAll('.open-qr-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const biz = businesses.find(b => b.id === id);
        if (biz) {
          switchTab('qrStudioTab');
          if (qrBizSelect) { qrBizSelect.value = biz.id; updateQrStudio(biz); }
        }
      });
    });

    document.querySelectorAll('.delete-biz-btn').forEach(btn => {
      btn.addEventListener('click', async e => {
        const el   = e.currentTarget as HTMLElement;
        const id   = el.dataset.id;
        const name = el.dataset.name;
        if (!id) return;
        const ok = window.confirm(
          `Remove "${name}"?\n\nThe printed QR short link stays available for reassignment — no reprint needed.`
        );
        if (ok) {
          try {
            await DatabaseService.deleteBusiness(id);
            await loadData();
          } catch (error) {
            alert(`Delete failed.\n\n${getSupabaseErrorMessage(error)}`);
          }
        }
      });
    });
  }

  // ── Tab switching ───────────────────────────────────────────────────────
  function switchTab(tabId: string) {
    activeTabName = tabId;

    // Update all tab button sets
    document.querySelectorAll('.tab-btn, .mobile-tab-btn').forEach(btn => {
      const target = btn.getAttribute('data-tab');
      btn.classList.toggle('active', target === tabId);
    });

    tabContents.forEach(content => {
      (content as HTMLElement).style.display = content.id === tabId ? 'block' : 'none';
    });
  }

  // Attach to all tab buttons (desktop + mobile)
  document.querySelectorAll('.tab-btn, .mobile-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) switchTab(tabId);
    });
  });

  searchBizInput?.addEventListener('input', e => {
    renderBusinessesList((e.target as HTMLInputElement).value);
  });

  document.querySelectorAll<HTMLElement>('.biz-pay-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.payFilter;
      if (value !== 'all' && value !== 'paid' && value !== 'unpaid') return;
      bizPayFilter = value;
      document
        .querySelectorAll<HTMLElement>('.biz-pay-filter-btn')
        .forEach(other => other.classList.toggle('is-active', other === btn));
      renderBusinessesList(searchBizInput?.value || '');
    });
  });

  // Bulk-upgrade old name-only URLs. Printed /s/ codes are untouched.
  fixSlugsBtn?.addEventListener('click', async () => {
    const changes = businesses
      .map(business => ({
        business,
        slug: descriptiveSlug(
          business.name,
          business.category || business.tagline || '',
          business.place_name || '',
          business.road || '',
        ),
      }))
      .filter(({ business, slug }) => slug !== '' && slug !== business.slug);

    if (changes.length === 0) {
      alert('All business URLs are already descriptive.');
      return;
    }

    if (!window.confirm(
      `Update ${changes.length} business URL${changes.length === 1 ? '' : 's'} to descriptive slugs?\n\n` +
      'Printed QR codes use /s/CODE and keep working. Only the web address changes.',
    )) return;

    const original = fixSlugsBtn.textContent;
    fixSlugsBtn.disabled = true;
    let done = 0;
    const errors: string[] = [];

    for (const { business, slug } of changes) {
      fixSlugsBtn.textContent = `Updating ${done + 1}/${changes.length}…`;
      const { short_code, short_link_error, schema_warning, ...rest } = business;
      try {
        await DatabaseService.saveBusiness({ ...rest, slug });
        done += 1;
      } catch (error) {
        errors.push(`${business.name}: ${getSupabaseErrorMessage(error)}`);
      }
    }

    fixSlugsBtn.textContent = original;
    fixSlugsBtn.disabled = false;
    await loadData();

    if (errors.length > 0) {
      alert(`Updated ${done} URL(s).\n\nCould not update:\n${errors.join('\n')}`);
    } else {
      alert(`Updated ${done} business URL${done === 1 ? '' : 's'}.`);
    }
  });

  // ── Modals ──────────────────────────────────────────────────────────────
  function openCreateModal() {
    if (!bizModal) return;
    if (modalTitle) modalTitle.textContent = 'Add New Business';
    formBizId.value = '';
    slugTouched = false;
    formName.value = '';
    formSlug.value = '';
    setLogoValue('');
    setLogoStatus(LOGO_HELP_TEXT);
    formBrandColor.value = '#2563eb';
    formBrandColorText.value = '#2563eb';
    formCategory.value = '';
    formPlaceName.value = '';
    formRoad.value = '';
    formGoogleUrl.value = '';
    formWaNumber.value = DEFAULT_COUNTRY_CODE;
    formWaMessage.value = DEFAULT_WA_GREETING;
    formPhone.value = DEFAULT_COUNTRY_CODE;
    formInsta.value = '';
    formFb.value = '';
    formCustomMsg.value = 'Thank you for visiting! Your Google review helps our local team grow.';
    formIsActive.checked = true;
    if (reassignSlugNotice)  reassignSlugNotice.style.display  = 'none';
    fillQrSelect('');
    syncPhonePreview();
    bizModal.style.display = 'flex';
  }

  function openEditModal(biz: Business) {
    if (!bizModal) return;
    if (modalTitle) modalTitle.textContent = `Edit — ${biz.name}`;
    formBizId.value          = biz.id;
    formName.value           = biz.name;
    slugTouched              = true;
    formSlug.value           = biz.slug;
    setLogoValue(biz.logo_url || '');
    setLogoStatus(biz.logo_url ? 'Current logo — upload a new file to replace it.' : LOGO_HELP_TEXT);
    formBrandColor.value     = biz.brand_color || '#2563eb';
    formBrandColorText.value = biz.brand_color || '#2563eb';
    formCategory.value       = biz.category || biz.tagline || '';
    formPlaceName.value      = biz.place_name || '';
    formRoad.value           = biz.road || '';
    // Upgrade legacy name-only slugs (e.g. /chaya-kada) to descriptive ones
    // when the form is saved. Printed QR codes use /s/CODE, so this is safe.
    if (biz.slug === slugifyName(biz.name)) {
      const improved = descriptiveSlug(biz.name, formCategory.value, formPlaceName.value, formRoad.value);
      if (improved) formSlug.value = improved;
    }
    formGoogleUrl.value      = biz.google_review_url || '';
    formWaNumber.value       = biz.whatsapp_number || DEFAULT_COUNTRY_CODE;
    formWaMessage.value      = biz.whatsapp_message || DEFAULT_WA_GREETING;
    formPhone.value          = biz.phone_number || DEFAULT_COUNTRY_CODE;
    formInsta.value          = socialHandleFromUrl(biz.instagram_url, /^https?:\/\/(www\.)?instagram\.com\/?/i);
    formFb.value             = socialHandleFromUrl(biz.facebook_url, /^https?:\/\/(www\.)?facebook\.com\/?/i);
    formCustomMsg.value      = biz.custom_message || '';
    formIsActive.checked     = biz.is_active;

    fillQrSelect(biz.short_code || '');
    if (reassignSlugNotice) reassignSlugNotice.style.display = 'block';

    syncPhonePreview();
    bizModal.style.display = 'flex';
  }

  // ── QR chooser in the business form ─────────────────────────────────────
  function fillQrSelect(currentCode: string) {
    if (!formQrCode) return;
    const options: string[] = [];

    options.push(
      currentCode
        ? '<option value="">— Remove QR from this business —</option>'
        : '<option value="">— No QR yet (assign later) —</option>',
    );

    if (currentCode) {
      options.push(`<option value="${currentCode}">/s/${currentCode} — currently on this business</option>`);
    }

    const stock = unassignedShortLinks.filter(link => link.code !== currentCode);
    if (stock.length > 0) {
      options.push(`<optgroup label="Unassigned QR stock (${stock.length})">`);
      for (const link of stock) {
        const label = link.last_label ? `was ${link.last_label}` : 'blank stand';
        options.push(`<option value="${link.code}">/s/${link.code} — ${label}</option>`);
      }
      options.push('</optgroup>');
    }

    formQrCode.innerHTML = options.join('');
    formQrCode.value = currentCode;
    updateQrFormBanner();
  }

  function updateQrFormBanner() {
    if (!formQrBanner || !formQrCode) return;
    const code = formQrCode.value;
    const editing = Boolean(formBizId.value);

    formQrBanner.className = 'qr-form-banner';

    if (code) {
      formQrBanner.hidden = false;
      formQrBanner.classList.add('is-ok');
      formQrBanner.innerHTML =
        `This business will use <strong>/s/${code}</strong> — the printed stand works as soon as you save.`;
      return;
    }

    if (editing) {
      formQrBanner.hidden = false;
      formQrBanner.classList.add('is-warn');
      formQrBanner.innerHTML =
        'Saving now releases the printed stand back to stock. The business will have no QR until you assign one.';
      return;
    }

    if (unassignedShortLinks.length === 0) {
      formQrBanner.hidden = false;
      formQrBanner.classList.add('is-warn');
      formQrBanner.innerHTML =
        'No blank QR stock yet. Create codes in <strong>QR Codes → Bulk QR Stands</strong>, then assign one here.';
      return;
    }

    formQrBanner.hidden = true;
    formQrBanner.innerHTML = '';
  }

  function closeModal() {
    if (bizModal) bizModal.style.display = 'none';
  }

  openNewBizBtn?.addEventListener('click', openCreateModal);
  mobileAddBizBtn?.addEventListener('click', openCreateModal);
  closeModalBtn?.addEventListener('click', closeModal);
  cancelFormBtn?.addEventListener('click', closeModal);

  // Close modal on backdrop click
  bizModal?.addEventListener('click', e => { if (e.target === bizModal) closeModal(); });

  // ── Descriptive slug from name + category + area + road ──────────────────
  function refreshDescriptiveSlug() {
    formSlug.value = descriptiveSlug(
      formName.value,
      formCategory.value,
      formPlaceName.value,
      formRoad.value,
    );
  }

  [formName, formCategory, formPlaceName, formRoad].forEach(el => {
    el?.addEventListener('input', () => {
      if (!formBizId.value && !slugTouched) refreshDescriptiveSlug();
      syncPhonePreview();
    });
  });

  formSlug?.addEventListener('input', () => {
    slugTouched = true;
  });

  descriptiveSlugBtn?.addEventListener('click', () => {
    slugTouched = false;
    refreshDescriptiveSlug();
  });

  formBrandColor?.addEventListener('input', () => {
    formBrandColorText.value = formBrandColor.value;
    syncPhonePreview();
  });

  formBrandColorText?.addEventListener('input', () => {
    if (/^#[0-9a-fA-F]{6}$/.test(formBrandColorText.value)) {
      formBrandColor.value = formBrandColorText.value;
      syncPhonePreview();
    }
  });

  document.querySelectorAll('.color-preset-dot').forEach(dot => {
    dot.addEventListener('click', e => {
      const col = (e.currentTarget as HTMLElement).dataset.color;
      if (col) { formBrandColor.value = col; formBrandColorText.value = col; syncPhonePreview(); }
    });
  });

  [formName, formSlug, formLogoUrl, formCategory, formPlaceName, formRoad, formCustomMsg, formWaNumber, formIsActive]
    .forEach(el => el?.addEventListener('input', syncPhonePreview));

  function businessLocationLine(place?: string, road?: string): string {
    return [place, road]
      .map(part => (part || '').trim())
      .filter(Boolean)
      .join(' · ');
  }

  function syncPhonePreview() {
    const col     = formBrandColor.value || '#2563eb';
    const name    = formName.value || 'Business Name';
    const category = formCategory.value || 'Shop category appears here';
    const logo    = formLogoUrl.value || DEFAULT_LOGO_URL;
    if (prevImg)     prevImg.src          = logo;
    if (prevName)    prevName.textContent = name;
    if (prevLocation) {
      const location = businessLocationLine(formPlaceName.value, formRoad.value);
      prevLocation.textContent = location;
      prevLocation.hidden = !location;
    }
    if (prevCategory) prevCategory.textContent = category;
    if (prevWa)      prevWa.style.display = normalizePhone(formWaNumber.value) ? 'block' : 'none';
    if (prevMsg)     prevMsg.textContent  = formCustomMsg.value || '';
    document.getElementById('livePhoneMockup')?.style.setProperty('--brand', col);
  }

  // ── Logo upload (ImageKit) ──────────────────────────────────────────────
  const LOGO_HELP_TEXT = 'PNG, JPG, WebP or SVG · up to 5 MB';

  function setLogoStatus(message: string, tone: 'idle' | 'ok' | 'error' = 'idle') {
    if (!logoUploadStatus) return;
    logoUploadStatus.textContent = message;
    logoUploadStatus.classList.toggle('is-ok', tone === 'ok');
    logoUploadStatus.classList.toggle('is-error', tone === 'error');
  }

  function setLogoValue(url: string) {
    formLogoUrl.value = url;
    if (logoUploadImg && logoUploadEmpty) {
      if (url) {
        logoUploadImg.src = url;
        logoUploadImg.hidden = false;
        logoUploadEmpty.hidden = true;
      } else {
        logoUploadImg.removeAttribute('src');
        logoUploadImg.hidden = true;
        logoUploadEmpty.hidden = false;
      }
    }
    if (logoRemoveBtn) logoRemoveBtn.hidden = !url;
    syncPhonePreview();
  }

  logoUploadBtn?.addEventListener('click', () => formLogoFile?.click());

  formLogoFile?.addEventListener('change', async () => {
    const file = formLogoFile.files?.[0];
    // Reset the picker so choosing the same file again still fires `change`.
    formLogoFile.value = '';
    if (!file || logoUploading) return;

    if (!supabase) {
      setLogoStatus('Supabase is not configured, so uploads are unavailable.', 'error');
      return;
    }

    const { data: sessionData } = await supabase.auth.getSession();
    const accessToken = sessionData.session?.access_token;
    if (!accessToken) {
      setLogoStatus('Your session expired. Sign in again to upload.', 'error');
      return;
    }

    logoUploading = true;
    if (logoUploadBtn) {
      logoUploadBtn.disabled = true;
      logoUploadBtn.textContent = 'Uploading…';
    }
    setLogoStatus('Uploading to ImageKit… 0%');

    try {
      const uploaded = await uploadLogo(file, accessToken, (percent) => {
        setLogoStatus(`Uploading to ImageKit… ${percent}%`);
      });
      setLogoValue(uploaded.url);
      setLogoStatus('Logo uploaded to ImageKit ✓', 'ok');
    } catch (error) {
      setLogoStatus(error instanceof Error ? error.message : String(error), 'error');
    } finally {
      logoUploading = false;
      if (logoUploadBtn) {
        logoUploadBtn.disabled = false;
        logoUploadBtn.textContent = '⬆ Upload image';
      }
    }
  });

  logoRemoveBtn?.addEventListener('click', () => {
    setLogoValue('');
    setLogoStatus(`Logo removed — the default logo will be used. ${LOGO_HELP_TEXT}`);
  });

  // ── Save form ───────────────────────────────────────────────────────────
  bizForm?.addEventListener('submit', async e => {
    e.preventDefault();
    const id   = formBizId.value || undefined;
    const name = formName.value.trim();
    const slug = formSlug.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
    if (!name || !slug) { alert('Please provide both Business Name and URL Slug.'); return; }
    if (RESERVED_SLUGS.has(slug)) { alert(`The slug "${slug}" is reserved. Choose another.`); return; }

    const payload: Partial<Business> & { name: string; slug: string } = {
      id, name, slug,
      // Always send the choice: a code assigns the printed stand, an empty
      // string releases it, so nothing is auto-generated behind the scenes.
      short_code:       formQrCode?.value || '',
      logo_url:         formLogoUrl.value.trim() || DEFAULT_LOGO_URL,
      brand_color:      formBrandColor.value,
      category:         formCategory.value.trim(),
      place_name:       formPlaceName.value.trim(),
      road:             formRoad.value.trim(),
      google_review_url:formGoogleUrl.value.trim(),
      whatsapp_number:  normalizePhone(formWaNumber.value),
      whatsapp_message: formWaMessage.value.trim() || DEFAULT_WA_GREETING,
      phone_number:     normalizePhone(formPhone.value),
      instagram_url:    normalizeSocialHandle(formInsta.value, INSTAGRAM_BASE),
      facebook_url:     normalizeSocialHandle(formFb.value, FACEBOOK_BASE),
      custom_message:   formCustomMsg.value.trim(),
      is_active:        formIsActive.checked,
    };

    const submitBtn = document.getElementById('saveBizSubmitBtn') as HTMLButtonElement | null;
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Saving…'; }

    try {
      const saved = await DatabaseService.saveBusiness(payload);
      closeModal();
      await loadData();
      if (saved.short_link_error) {
        alert(`Business saved, but its QR could not be linked.\n\n${saved.short_link_error}`);
      }
    } catch (error) {
      alert(`Unable to save.\n\n${getSupabaseErrorMessage(error)}`);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Save Business</span>';
      }
    }
  });

  formQrCode?.addEventListener('change', updateQrFormBanner);

  // ── QR Studio ───────────────────────────────────────────────────────────
  function populateQrStudio() {
    if (!qrBizSelect) return;
    // Only businesses that own a printed stand can be rendered here; otherwise
    // the QR would encode a slug page that may not exist until the next build.
    const withQr = businesses.filter(b => b.short_code);
    if (withQr.length === 0) {
      qrBizSelect.innerHTML = '<option value="">No QR assigned yet</option>';
      selectedBizForQr = null;
      if (qrEncodedUrlInput) qrEncodedUrlInput.value = '';
      if (qrPreviewContainer) qrPreviewContainer.innerHTML = '';
      if (qrPreviewBizName) qrPreviewBizName.textContent = 'No QR assigned';
      if (qrPreviewTagline) qrPreviewTagline.textContent = 'Create blank QR stock, then assign one to a business';
      return;
    }
    qrBizSelect.innerHTML = withQr
      .map(b => `<option value="${b.id}">${b.name} (/s/${b.short_code})</option>`)
      .join('');
    const b = withQr.find(x => x.id === qrBizSelect.value) || withQr[0];
    updateQrStudio(b);
  }

  qrBizSelect?.addEventListener('change', () => {
    const b = businesses.find(x => x.id === qrBizSelect.value);
    if (b) updateQrStudio(b);
  });

  function updateQrStudio(biz: Business) {
    selectedBizForQr = biz;
    const fullUrl = qrUrlFor(biz);
    if (qrEncodedUrlInput) qrEncodedUrlInput.value = fullUrl;
    if (qrPreviewBizName)  qrPreviewBizName.textContent  = biz.name;
    if (qrPreviewTagline)  qrPreviewTagline.textContent  = biz.short_code ? `/s/${biz.short_code}` : `/${biz.slug}`;
    void renderQrCode();
  }

  async function renderQrCode() {
    if (!selectedBizForQr || !qrPreviewContainer) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const color   = qrColorPicker?.value || '#000000';

    // SVG preview
    try {
      const svgString = await QRCodeLib.toString(fullUrl, {
        type: 'svg',
        color: { dark: color, light: '#ffffff' },
        margin: 2,
        width: 240,
        errorCorrectionLevel: 'M',
      });
      qrPreviewContainer.innerHTML = svgString;
    } catch (err) {
      console.error('QR SVG render failed:', err);
    }
  }

  qrColorPicker?.addEventListener('input', () => { void renderQrCode(); });
  qrMatchBrandBtn?.addEventListener('click', () => {
    if (selectedBizForQr && qrColorPicker) { qrColorPicker.value = selectedBizForQr.brand_color || '#2563eb'; void renderQrCode(); }
  });
  qrResetBlackBtn?.addEventListener('click', () => {
    if (qrColorPicker) { qrColorPicker.value = '#000000'; void renderQrCode(); }
  });
