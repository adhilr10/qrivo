  padding: 0.2rem;
  background: #ffffff;
  border: 2.5px solid #0a0a0a;
  border-radius: 7px;
  box-shadow: 3px 3px 0 #0a0a0a;
}

.biz-pay-filter-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem 0.7rem;
  background: transparent;
  border: none;
  border-radius: 4px;
  color: #4a4a4a;
  font-family: inherit;
  font-size: 0.78rem;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.12s, color 0.12s;
  white-space: nowrap;
}

.biz-pay-filter-btn:hover {
  background: #f5f0e4;
  color: #0a0a0a;
}

.biz-pay-filter-btn.is-active {
  background: #0a0a0a;
  color: #ffffff;
}

.biz-pay-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 1.25rem;
  padding: 0.05rem 0.3rem;
  background: #f0ede4;
  border-radius: 999px;
  color: #0a0a0a;
  font-size: 0.66rem;
  font-weight: 800;
  line-height: 1.4;
}

.biz-pay-filter-btn.is-active .biz-pay-count {
  background: #f5c518;
  color: #0a0a0a;
}

/* ── Business cards grid ─────────────────────────────────────────────────── */
.business-list-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1rem;
  align-items: stretch;
}

.loading-placeholder {
  text-align: center;
  padding: 3rem;
  color: #4a4a4a;
  font-weight: 600;
}

/* ── Shared panel headings ───────────────────────────────────────────────── */
.section-title {
  font-size: 1.0625rem;
  font-weight: 800;
  color: #0a0a0a;
  margin-bottom: 1.125rem;
  letter-spacing: -0.01em;
}

.section-desc {
  font-size: 0.875rem;
  color: #4a4a4a;
  margin-bottom: 1.5rem;
  line-height: 1.55;
  font-weight: 500;
}

/* ── QR Studio ───────────────────────────────────────────────────────────── */
.qr-studio-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  align-items: start;
}

.qr-panel {
  padding: 1.5rem;
  background: #ffffff;
  border: 2.5px solid #0a0a0a;
  border-radius: 8px;
  box-shadow: 4px 4px 0 #0a0a0a;
}

.qr-preview-panel {
  padding: 1.5rem;
  text-align: center;
  background: #ffffff;
  border: 2.5px solid #0a0a0a;
  border-radius: 8px;
  box-shadow: 4px 4px 0 #0a0a0a;
}

.qr-preview-label {
  font-size: 0.6875rem;
  font-weight: 700;
  color: #4a4a4a;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.qr-preview-frame {
  display: inline-block;
  padding: 1rem;
  background: #fff;
  border: 2.5px solid #0a0a0a;
  border-radius: 8px;
  box-shadow: 4px 4px 0 #0a0a0a;
  margin-bottom: 1rem;
}

.qr-preview-inner {
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 200px;
  min-height: 200px;
}

.qr-biz-name {
  font-size: 0.9375rem;
  font-weight: 800;
  color: #0a0a0a;
}

.qr-biz-tag {
  font-size: 0.8rem;
  color: #767676;
  margin-top: 0.2rem;
  font-weight: 500;
}

.qr-action-stack {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.color-input {
  width: 44px;
  height: 36px;
  border-radius: 6px;
  border: 2.5px solid #0a0a0a;
  background: none;
  cursor: pointer;
  padding: 0;
  box-shadow: 2px 2px 0 #0a0a0a;
}

/* ── Bulk QR stock ───────────────────────────────────────────────────────── */
.qr-stock-panel {
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  background: #ffffff;
  border: 2.5px solid #0a0a0a;
  border-radius: 8px;
  box-shadow: 4px 4px 0 #0a0a0a;
}

.qr-stock-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.qr-stock-heading { flex: 1; min-width: 220px; }

.qr-stock-badge {
  flex-shrink: 0;
  font-size: 0.72rem;
  font-weight: 800;
  color: #0a0a0a;
  background: #fff8e7;
  border: 2px solid #0a0a0a;
  border-radius: 999px;
  padding: 0.25rem 0.7rem;
  box-shadow: 2px 2px 0 #0a0a0a;
  white-space: nowrap;
}

.qr-bulk-row {
  display: flex;
  align-items: flex-end;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding: 0.875rem;
  background: #fffdf5;
  border: 2px solid #0a0a0a;
  border-radius: 6px;
  margin-bottom: 1rem;
}

.qr-bulk-row .form-group {
  flex: 1 1 160px;
  margin-bottom: 0;
}

.qr-bulk-submit { flex-shrink: 0; }

.qr-bulk-cost {
  margin: -0.5rem 0 1rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: #4a4a4a;
}

.qr-stock-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.6rem;
  flex-wrap: wrap;
}

.qr-stock-toolbar-actions {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.qr-stock-batch {
  border: 2px solid #0a0a0a;
  border-radius: 8px;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 3px 3px 0 #0a0a0a;
}

.qr-stock-batch-head {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  padding: 0.45rem 0.65rem;
  background: #fff8e7;
  border-bottom: 2px solid #0a0a0a;
}

.qr-stock-batch-name {
  font-size: 0.8rem;
  font-weight: 800;
  color: #0a0a0a;
  word-break: break-word;
}

.qr-stock-batch-count {
  font-size: 0.68rem;
  font-weight: 700;
  color: #4a4a4a;
  background: #ffffff;
  border: 1.5px solid #0a0a0a;
  border-radius: 999px;
  padding: 0.05rem 0.45rem;
}

.qr-stock-batch-download {
  margin-left: auto;
  font-size: 0.7rem;
  padding: 0.25rem 0.6rem;
}

.qr-stock-batch .qr-stock-item {
  border: 0;
  border-bottom: 1.5px solid #e5e1d8;
  border-radius: 0;
  box-shadow: none;
  background: #ffffff;
}

.qr-stock-batch .qr-stock-item:last-child {
  border-bottom: 0;
}

.qr-bulk-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.65rem;
  flex-wrap: wrap;
  padding: 0.65rem 0.8rem;
  margin-bottom: 1rem;
  background: #f0fdf4;
  border: 2px solid #15803d;
  border-radius: 6px;
  box-shadow: 2px 2px 0 #0a0a0a;
}

.qr-bulk-result-text {
  flex: 1;
  min-width: 200px;
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1.5;
  color: #14532d;
}

.qr-stock-toolbar-label {
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #4a4a4a;
}

.qr-stock-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-height: 340px;
  overflow-y: auto;
}

.qr-stock-empty {
  text-align: center;
  padding: 1.5rem 1rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: #767676;
  background: #fffdf5;
  border: 2px dashed #c9c4b8;
  border-radius: 6px;
}

.qr-stock-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  flex-wrap: wrap;
  padding: 0.6rem 0.75rem;
  background: #ffffff;
  border: 2px solid #0a0a0a;
  border-radius: 6px;
  box-shadow: 2px 2px 0 #0a0a0a;
}

.qr-stock-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.85rem;
  font-weight: 800;
  color: #15803d;
  white-space: nowrap;
}

.qr-stock-meta {
  flex: 1;
  min-width: 120px;
  font-size: 0.7rem;
  color: #767676;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qr-stock-actions {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
  margin-left: auto;
}

.qr-stock-actions .btn {
  font-size: 0.7rem;
  padding: 0.3rem 0.55rem;
}

/* QR chooser inside the business form */
.qr-form-banner {
  margin-top: 0.5rem;
  padding: 0.5rem 0.65rem;
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.45;
  color: #0a0a0a;
  background: #fff8e7;
  border: 2px solid #0a0a0a;
  border-radius: 6px;
}

.qr-form-banner.is-warn {
  color: #92400e;
  background: #fef3c7;
  border-color: #b45309;
}

.qr-form-banner.is-ok {
  color: #15803d;
  background: #f0fdf4;
  border-color: #15803d;
}

/* ── QR scanner modal ────────────────────────────────────────────────────── */
.qr-scan-dialog {
  max-width: 520px;
}

.qr-scan-body {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  padding: 1.25rem;
}

.qr-scan-help {
  font-size: 0.8rem;
  line-height: 1.5;
  color: #4a4a4a;
  font-weight: 500;
}

.qr-scan-video-wrap {
  position: relative;
  aspect-ratio: 4 / 3;
  background: #0a0a0a;
  border: 2.5px solid #0a0a0a;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 4px 4px 0 #0a0a0a;
}

.qr-scan-video-wrap video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.qr-scan-frame {
  position: absolute;
  inset: 18%;
  border: 3px dashed rgba(245, 197, 24, 0.9);
  border-radius: 10px;
  pointer-events: none;
}

.qr-scan-status {
  font-size: 0.78rem;
  font-weight: 700;
  color: #4a4a4a;
  text-align: center;
}

.qr-scan-result {
  padding: 0.75rem;
  background: #fffdf5;
  border: 2px solid #0a0a0a;
  border-radius: 6px;
  font-size: 0.8rem;
  line-height: 1.5;
  color: #0a0a0a;
  box-shadow: 3px 3px 0 #0a0a0a;
}

.qr-scan-result .qr-scan-result-code {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.95rem;
  font-weight: 800;
  color: #15803d;
  margin-bottom: 0.15rem;
  word-break: break-all;
}

.qr-scan-result .qr-scan-result-actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-top: 0.6rem;
}

.qr-scan-manual {
  display: flex;
  gap: 0.5rem;
}

.qr-scan-manual .form-input { flex: 1; min-width: 0; }

/* ── Assign stock QR modal ───────────────────────────────────────────────── */
.assign-dialog { max-width: 520px; }

.assign-body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.25rem;
}

.assign-qr-preview {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  background: #fffdf5;
  border: 2px solid #0a0a0a;
  border-radius: 6px;
  box-shadow: 3px 3px 0 #0a0a0a;
}

.assign-qr-preview canvas,
.assign-qr-preview svg {
  width: 84px;
  height: 84px;
  flex-shrink: 0;
  background: #fff;
}

.assign-qr-preview .assign-qr-text {
  min-width: 0;
  font-size: 0.8rem;
  color: #4a4a4a;
  line-height: 1.45;
}

.assign-qr-preview .assign-qr-code {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.95rem;
  font-weight: 800;
  color: #15803d;
  margin-bottom: 0.2rem;
  word-break: break-all;
}

.assign-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
}

/* ── Mobile bottom tab bar ───────────────────────────────────────────────── */
.mobile-bottom-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #fffdf5;
  border-top: 2.5px solid #0a0a0a;
  padding: 0 0 env(safe-area-inset-bottom, 0);
  flex-direction: row;
  align-items: stretch;
}

.mobile-tab-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  padding: 0.625rem 0.25rem;
  color: #767676;
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  position: relative;
  transition: color 0.15s, background 0.15s;
  border-top: 3px solid transparent;
}

.mobile-tab-btn.active {
  color: #0a0a0a;
  background: #fff8e7;
  border-top-color: #0a0a0a;
}

.mobile-tab-icon {
  font-size: 1.25rem;
  line-height: 1;
}

.mobile-tab-label { line-height: 1; }

.mobile-tab-badge {
  position: absolute;
  top: 6px;
  right: calc(50% - 18px);
  background: #f5c518;
  color: #0a0a0a;
  font-size: 0.6rem;
  font-weight: 800;
  padding: 0.1rem 0.35rem;
  border-radius: 999px;
  min-width: 16px;
  text-align: center;
  line-height: 1.4;
  border: 1.5px solid #0a0a0a;
}

/* ── Modal ───────────────────────────────────────────────────────────────── */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(10,10,10,0.6);
  z-index: 100;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 1rem;
  overflow-y: auto;
}

.modal-dialog {
  width: 100%;
  max-width: 980px;
  background: #ffffff;
  border: 2.5px solid #0a0a0a;
  border-radius: 10px;
  box-shadow: 8px 8px 0 #0a0a0a;
  overflow: hidden;
  margin: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  border-bottom: 2.5px solid #0a0a0a;
  background: #fff8e7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.modal-title {
  font-size: 1.125rem;
  font-weight: 800;
  color: #0a0a0a;
  letter-spacing: -0.01em;
}

.modal-close-btn {
  color: #0a0a0a;
  font-size: 1.5rem;
  line-height: 1;
  padding: 0.25rem 0.5rem;
  border: 2px solid #0a0a0a;
  border-radius: 4px;
  background: #fffdf5;
  cursor: pointer;
  font-weight: 700;
  box-shadow: 2px 2px 0 #0a0a0a;
  transition: transform 0.1s;
}

.modal-close-btn:hover {
  transform: translate(-1px, -1px);
}

.modal-body-split {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  padding: 1.5rem;
  overflow-y: auto;
  max-height: calc(90vh - 60px);
}

.biz-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.slug-prefix {
  background: #fff8e7;
  padding: 0.7rem 0.875rem;
  border: 2.5px solid #0a0a0a;
  border-right: none;
  border-radius: 6px 0 0 6px;
  font-size: 0.9375rem;
  font-weight: 700;
  color: #4a4a4a;
}

.slug-row {
  display: flex;
  align-items: stretch;
  gap: 0.4rem;
}

.slug-field {
  display: flex;
  align-items: stretch;
  flex: 1;
  min-width: 0;
}

.slug-input {
  border-radius: 0 6px 6px 0;
  min-width: 0;
}

.slug-descriptive-btn {
  white-space: nowrap;
  flex-shrink: 0;
}

.notice-banner {
  background: #fef9e7;
  border: 2px solid #f5c518;
  border-radius: 6px;
  padding: 0.65rem 0.875rem;
  font-size: 0.8125rem;
  color: #0a0a0a;
  font-weight: 600;
  box-shadow: 2px 2px 0 #0a0a0a;
}

.active-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 1rem;
  background: #fffdf5;
  border-radius: 6px;
  border: 2.5px solid #0a0a0a;
  box-shadow: 3px 3px 0 #0a0a0a;
}

.active-toggle-title {
  font-weight: 800;
  font-size: 0.9375rem;
  color: #0a0a0a;
}

.active-toggle-desc {
  font-size: 0.75rem;
  color: #767676;
  font-weight: 500;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  padding-top: 0.5rem;
}

/* ── Logo upload (ImageKit) ──────────────────────────────────────────────── */
.logo-upload-row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.6rem;
  background: #fffdf5;
  border: 2.5px solid #0a0a0a;
  border-radius: 8px;
  box-shadow: 3px 3px 0 #0a0a0a;
}

.logo-upload-preview {
  flex: 0 0 auto;
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #ffffff;
  border: 2px solid #0a0a0a;
  border-radius: 8px;
}

.logo-upload-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.logo-upload-empty {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #767676;
  text-align: center;
}

.logo-upload-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem;
  min-width: 0;
}

.logo-upload-actions .form-helper {
  flex: 1 1 100%;
  line-height: 1.35;
}

.logo-upload-actions .form-helper.is-error { color: #b91c1c; }
.logo-upload-actions .form-helper.is-ok { color: #15803d; }

@media (max-width: 479px) {
  .logo-upload-row { align-items: flex-start; }
  .logo-upload-preview { width: 56px; height: 56px; }
  .logo-upload-actions { flex: 1 1 0; }
  .logo-upload-actions .btn { flex: 1 1 auto; }
}

/* Phone mockup */
.phone-mockup-wrapper {
  display: none;
}

.phone-mockup-label {
  text-align: center;
  font-size: 0.6875rem;
  color: #4a4a4a;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.75rem;
}

.smartphone-frame {
  width: 100%;
  max-width: 240px;
  height: 470px;
  margin: 0 auto;
  background: #0a0a0a;
  border: 5px solid #0a0a0a;
  border-radius: 28px;
  overflow: hidden;
  padding: 8px 6px;
  box-shadow: 6px 6px 0 #0a0a0a;
}

.smartphone-screen {
  width: 100%;
  height: 100%;
  background: #fffdf5;
  border-radius: 20px;
  padding: 1rem 0.65rem;
  text-align: center;
  overflow-y: auto;
}

.preview-logo-wrap {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  margin: 0 auto 0.65rem;
  border: 2.5px solid #0a0a0a;
  overflow: hidden;
  background: #f0ede4;
}

.preview-logo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Toggle switch */
.switch {
  position: relative;
  display: inline-block;
  width: 48px;
  height: 26px;
}
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute;
  cursor: pointer;
  inset: 0;
  background: #d0ccc4;
  border: 2px solid #0a0a0a;
  border-radius: 34px;
  transition: 0.2s;
}
.slider:before {
  position: absolute;
  content: "";
  height: 18px;
  width: 18px;
  left: 2px;
  bottom: 2px;
  background: #0a0a0a;
  border-radius: 50%;
  transition: 0.2s;
}
input:checked + .slider { background: #f5c518; }
input:checked + .slider:before { transform: translateX(22px); }

/* Color preset */
.color-preset-dot {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid #0a0a0a;
  transition: transform 0.12s, box-shadow 0.12s;
}
.color-preset-dot:hover {
  transform: scale(1.2);
  box-shadow: 2px 2px 0 #0a0a0a;
}

/* SQL textarea */
.sql-textarea {
  width: 100%;
  font-family: monospace;
  font-size: 0.8125rem;
  background: #0a0a0a;
  color: #f5c518;
  border: 2.5px solid #0a0a0a;
