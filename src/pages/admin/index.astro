  const prevTagline = document.getElementById('prevTagline');
  const prevWa      = document.getElementById('prevWa');
  const prevMsg     = document.getElementById('prevMsg');

  const qrBizSelect       = document.getElementById('qrBizSelect') as HTMLSelectElement;
  const qrEncodedUrlInput = document.getElementById('qrEncodedUrlInput') as HTMLInputElement;
  const qrColorPicker     = document.getElementById('qrColorPicker') as HTMLInputElement;
  const qrPreviewContainer= document.getElementById('qrPreviewContainer');
  const qrPreviewBizName  = document.getElementById('qrPreviewBizName');
  const qrPreviewTagline  = document.getElementById('qrPreviewTagline');
  const qrExportCanvas    = document.getElementById('qrExportCanvas') as HTMLCanvasElement;
  const copyQrUrlBtn      = document.getElementById('copyQrUrlBtn');
  const qrMatchBrandBtn   = document.getElementById('qrMatchBrandBtn');
  const qrResetBlackBtn   = document.getElementById('qrResetBlackBtn');
  const downloadPngBtn    = document.getElementById('downloadPngBtn');
  const downloadSvgBtn    = document.getElementById('downloadSvgBtn');
  const openPrintCardBtn  = document.getElementById('openPrintCardBtn');

  const statTotalViews    = document.getElementById('statTotalViews');
  const statReviewClicks  = document.getElementById('statReviewClicks');
  const statWaClicks      = document.getElementById('statWaClicks');
  const statSocialClicks  = document.getElementById('statSocialClicks');
  const statAvgConversion = document.getElementById('statAvgConversion');
  const analyticsTableBody= document.getElementById('analyticsTableBody');
  const liveActivityFeed  = document.getElementById('liveActivityFeed');

  const supabaseSetupModalBtn  = document.getElementById('supabaseSetupModalBtn');
  const supabaseModal          = document.getElementById('supabaseModal');
  const closeSupabaseModalBtn  = document.getElementById('closeSupabaseModalBtn');
  const copySqlBtn             = document.getElementById('copySqlBtn');
  const copySqlBtnText         = document.getElementById('copySqlBtnText');
  const sqlCodeTextarea        = document.getElementById('sqlCodeTextarea') as HTMLTextAreaElement;

  const printCardLogo    = document.getElementById('printCardLogo') as HTMLImageElement;
  const printCardTitle   = document.getElementById('printCardTitle');
  const printCardTagline = document.getElementById('printCardTagline');
  const printCardQrBox   = document.getElementById('printCardQrBox');
  const printCardUrl     = document.getElementById('printCardUrl');

  // ── Data loading ────────────────────────────────────────────────────────
  async function loadData() {
    if (!supabase) { window.location.replace('/admin/login'); return; }

    const { data: authData, error: authError } = await supabase.auth.getUser();
    if (authError || !authData.user) { window.location.replace('/admin/login'); return; }
    if (adminUserEmail) adminUserEmail.textContent = authData.user.email || 'Signed in';

    const config = getSupabaseConfig();
    if (backendStatusPill && backendStatusText) {
      if (config.isConfigured) {
        backendStatusPill.className = 'status-pill online';
        backendStatusText.textContent = 'Supabase Connected';
      } else {
        backendStatusPill.className = 'status-pill local';
        backendStatusText.textContent = 'Not configured';
      }
    }

    try {
      businesses = await DatabaseService.getBusinesses();
      businesses = await DatabaseService.ensureShortLinks(businesses);
      try {
        unassignedShortLinks = await DatabaseService.getUnassignedShortLinks();
      } catch { unassignedShortLinks = []; }
    } catch (error) {
      console.error('Unable to load businesses:', error);
      if (backendStatusPill && backendStatusText) {
        backendStatusPill.className = 'status-pill local';
        backendStatusText.textContent = 'Supabase unavailable';
      }
      if (businessListContainer) {
        businessListContainer.innerHTML = `<div class="loading-placeholder">Unable to load Supabase data. Check .env and schema, then refresh.</div>`;
      }
      return;
    }

    const count = String(businesses.length);
    if (bizCountBadge)  bizCountBadge.textContent  = count;
    if (mobileBizBadge) mobileBizBadge.textContent = count;

    renderBusinessesList();
    populateQrStudio();
    if (activeTabName === 'analyticsTab') renderAnalytics();
  }

  // ── Business cards ──────────────────────────────────────────────────────
  function renderBusinessesList(filter = '') {
    if (!businessListContainer) return;
    const q = filter.toLowerCase().trim();
    const filtered = businesses.filter(b =>
      b.name.toLowerCase().includes(q) ||
      b.slug.toLowerCase().includes(q) ||
      (b.short_code || '').toLowerCase().includes(q) ||
      (b.owner_email || '').toLowerCase().includes(q)
    );

    if (filtered.length === 0) {
      businessListContainer.innerHTML = `
        <div style="grid-column:1/-1;text-align:center;padding:4rem 1rem;color:var(--text-muted);">
          <div style="font-size:2.5rem;margin-bottom:.5rem;">🏢</div>
          <div style="font-size:1rem;font-weight:600;color:#fff;">No businesses found</div>
          <p style="font-size:.875rem;margin-top:.25rem;">Try adjusting your search or add a new business.</p>
        </div>`;
      return;
    }

    businessListContainer.innerHTML = filtered.map(b => {
      const fullUrl    = qrUrlFor(b);
      const shortPath  = b.short_code ? `/s/${b.short_code}` : `/${b.slug}`;
      const ownerEmail = b.owner_email || '';
      const initial    = ownerInitial(ownerEmail);
      const created    = b.created_at
        ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : '';

      return `
        <div class="biz-card-item" style="--card-brand:${b.brand_color};">

          <div class="biz-card-body">
            <!-- Logo + name + status -->
            <div class="biz-card-top">
              <img
                src="${b.logo_url || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=120&auto=format&fit=crop&q=80'}"
                alt="${b.name}"
                class="biz-card-logo"
              />
              <div class="biz-card-meta">
                <div class="biz-card-name" title="${b.name}">${b.name}</div>
                <a href="${shortPath}" target="_blank" class="biz-card-short-link" title="Permanent QR link">${shortPath} ↗</a>
              </div>
              <span class="status-pill ${b.is_active ? 'online' : 'local'} biz-card-status">
                ${b.is_active ? 'Active' : 'Paused'}
              </span>
            </div>

            <!-- Owner -->
            <div class="biz-card-owner-row">
              <div class="biz-card-owner-avatar" title="${ownerEmail || 'unknown'}">${initial}</div>
              <div class="biz-card-owner-info">
                <span class="biz-card-owner-label">Created by</span>
                <span class="biz-card-owner-email" title="${ownerEmail}">${ownerShortName(ownerEmail) || 'Unknown admin'}</span>
              </div>
              ${created ? `<span class="biz-card-created-date">${created}</span>` : ''}
            </div>
          </div>

          <!-- Footer -->
          <div class="biz-card-footer">
            <button class="btn btn-outline btn-sm copy-slug-btn" data-url="${fullUrl}" title="Copy QR short link">
              📋 Copy QR
            </button>
            <div class="biz-card-action-group">
              <button class="btn btn-outline btn-sm open-qr-btn" data-id="${b.id}" title="QR Studio">QR</button>
              <button class="btn btn-secondary btn-sm edit-biz-btn" data-id="${b.id}" title="Edit">Edit</button>
              <button class="btn btn-danger btn-sm delete-biz-btn" data-id="${b.id}" data-name="${b.name}" title="Delete">✕</button>
            </div>
          </div>

        </div>`;
    }).join('');

    attachCardListeners();
  }

  function attachCardListeners() {
    document.querySelectorAll('.copy-slug-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const el  = e.currentTarget as HTMLElement;
        const url = el.dataset.url || '';
        navigator.clipboard.writeText(url);
        const orig = el.innerHTML;
        el.innerHTML = '✓ Copied!';
        setTimeout(() => { el.innerHTML = orig; }, 1500);
      });
    });

    document.querySelectorAll('.edit-biz-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const biz = businesses.find(b => b.id === id);
        if (biz) openEditModal(biz);
      });
    });

    document.querySelectorAll('.open-qr-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const biz = businesses.find(b => b.id === id);
        if (biz) {
          switchTab('qrStudioTab');
          if (qrBizSelect) { qrBizSelect.value = biz.id; updateQrStudio(biz); }
        }
      });
    });

    document.querySelectorAll('.delete-biz-btn').forEach(btn => {
      btn.addEventListener('click', async e => {
        const el   = e.currentTarget as HTMLElement;
        const id   = el.dataset.id;
        const name = el.dataset.name;
        if (!id) return;
        const ok = window.confirm(
          `Remove "${name}"?\n\nThe printed QR short link stays available for reassignment — no reprint needed.`
        );
        if (ok) {
          try {
            await DatabaseService.deleteBusiness(id);
            await loadData();
          } catch (error) {
            alert(`Delete failed.\n\n${getSupabaseErrorMessage(error)}`);
          }
        }
      });
    });
  }

  // ── Tab switching ───────────────────────────────────────────────────────
  function switchTab(tabId: string) {
    activeTabName = tabId;

    // Update all tab button sets
    document.querySelectorAll('.tab-btn, .mobile-tab-btn').forEach(btn => {
      const target = btn.getAttribute('data-tab');
      btn.classList.toggle('active', target === tabId);
    });

    tabContents.forEach(content => {
      (content as HTMLElement).style.display = content.id === tabId ? 'block' : 'none';
    });

    if (tabId === 'analyticsTab') renderAnalytics();
  }

  // Attach to all tab buttons (desktop + mobile)
  document.querySelectorAll('.tab-btn, .mobile-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) switchTab(tabId);
    });
  });

  searchBizInput?.addEventListener('input', e => {
    renderBusinessesList((e.target as HTMLInputElement).value);
  });

  // ── Modals ──────────────────────────────────────────────────────────────
  function openCreateModal() {
    if (!bizModal) return;
    if (modalTitle) modalTitle.textContent = 'Add New Business';
    formBizId.value = '';
    formName.value = '';
    formSlug.value = '';
    formLogoUrl.value = 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=200&auto=format&fit=crop&q=80';
    formBrandColor.value = '#2563eb';
    formBrandColorText.value = '#2563eb';
    formTagline.value = '';
    formGoogleUrl.value = '';
    formWaNumber.value = '';
    formWaMessage.value = 'Hi! I visited your counter and would like to chat.';
    formPhone.value = '';
    formInsta.value = '';
    formFb.value = '';
    formCustomMsg.value = 'Thank you for visiting! Your Google review helps our local team grow.';
    formIsActive.checked = true;
    if (reassignSlugNotice)  reassignSlugNotice.style.display  = 'none';
    if (shortLinkCreateGroup) shortLinkCreateGroup.style.display = 'block';
    if (shortLinkEditGroup)   shortLinkEditGroup.style.display   = 'none';
    if (formShortLinkDisplay) formShortLinkDisplay.value = '';
    if (formReuseShortCode) {
      formReuseShortCode.innerHTML = [
        '<option value="">Auto-generate a new permanent code</option>',
        ...unassignedShortLinks.map(link =>
          `<option value="${link.code}">Reuse /s/${link.code}${link.last_label ? ` — was ${link.last_label}` : ''}</option>`
        ),
      ].join('');
      formReuseShortCode.value = '';
    }
    syncPhonePreview();
    bizModal.style.display = 'flex';
  }

  function openEditModal(biz: Business) {
    if (!bizModal) return;
    if (modalTitle) modalTitle.textContent = `Edit — ${biz.name}`;
    formBizId.value          = biz.id;
    formName.value           = biz.name;
    formSlug.value           = biz.slug;
    formLogoUrl.value        = biz.logo_url || '';
    formBrandColor.value     = biz.brand_color || '#2563eb';
    formBrandColorText.value = biz.brand_color || '#2563eb';
    formTagline.value        = biz.tagline || '';
    formGoogleUrl.value      = biz.google_review_url || '';
    formWaNumber.value       = biz.whatsapp_number || '';
    formWaMessage.value      = biz.whatsapp_message || '';
    formPhone.value          = biz.phone_number || '';
    formInsta.value          = biz.instagram_url || '';
    formFb.value             = biz.facebook_url || '';
    formCustomMsg.value      = biz.custom_message || '';
    formIsActive.checked     = biz.is_active;

    if (shortLinkCreateGroup)  shortLinkCreateGroup.style.display  = 'none';
    if (shortLinkEditGroup)    shortLinkEditGroup.style.display    = 'block';
    if (formShortLinkDisplay) {
      formShortLinkDisplay.value = biz.short_code
        ? shortLinkUrl(window.location.origin, biz.short_code)
        : 'Short link will be created on save';
    }
    if (reassignSlugNotice) reassignSlugNotice.style.display = 'block';

    syncPhonePreview();
    bizModal.style.display = 'flex';
  }

  function closeModal() { if (bizModal) bizModal.style.display = 'none'; }

  openNewBizBtn?.addEventListener('click', openCreateModal);
  mobileAddBizBtn?.addEventListener('click', openCreateModal);
  closeModalBtn?.addEventListener('click', closeModal);
  cancelFormBtn?.addEventListener('click', closeModal);

  // Close modal on backdrop click
  bizModal?.addEventListener('click', e => { if (e.target === bizModal) closeModal(); });

  // ── Auto-slug from name ──────────────────────────────────────────────────
  formName?.addEventListener('input', () => {
    if (!formBizId.value) {
      formSlug.value = formName.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    }
    syncPhonePreview();
  });

  formBrandColor?.addEventListener('input', () => {
    formBrandColorText.value = formBrandColor.value;
    syncPhonePreview();
  });

  formBrandColorText?.addEventListener('input', () => {
    if (/^#[0-9a-fA-F]{6}$/.test(formBrandColorText.value)) {
      formBrandColor.value = formBrandColorText.value;
      syncPhonePreview();
    }
  });

  document.querySelectorAll('.color-preset-dot').forEach(dot => {
    dot.addEventListener('click', e => {
      const col = (e.currentTarget as HTMLElement).dataset.color;
      if (col) { formBrandColor.value = col; formBrandColorText.value = col; syncPhonePreview(); }
    });
  });

  [formName, formSlug, formLogoUrl, formTagline, formCustomMsg, formWaNumber, formIsActive]
    .forEach(el => el?.addEventListener('input', syncPhonePreview));

  function syncPhonePreview() {
    const col     = formBrandColor.value || '#2563eb';
    const name    = formName.value || 'Business Name';
    const tagline = formTagline.value || 'Tagline appears here';
    const logo    = formLogoUrl.value || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=200&auto=format&fit=crop&q=80';
    if (prevImg)     prevImg.src          = logo;
    if (prevName)    prevName.textContent = name;
    if (prevTagline) prevTagline.textContent = tagline;
    if (prevWa)      prevWa.style.display = formWaNumber.value ? 'block' : 'none';
    if (prevMsg)     prevMsg.textContent  = formCustomMsg.value || '';
    document.getElementById('livePhoneMockup')?.style.setProperty('--brand', col);
  }

  // ── Save form ───────────────────────────────────────────────────────────
  bizForm?.addEventListener('submit', async e => {
    e.preventDefault();
    const id   = formBizId.value || undefined;
    const name = formName.value.trim();
    const slug = formSlug.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
    if (!name || !slug) { alert('Please provide both Business Name and URL Slug.'); return; }
    if (RESERVED_SLUGS.has(slug)) { alert(`The slug "${slug}" is reserved. Choose another.`); return; }

    const payload: Partial<Business> & { name: string; slug: string } = {
      id, name, slug,
      short_code:       id ? undefined : formReuseShortCode?.value || undefined,
      logo_url:         formLogoUrl.value.trim(),
      brand_color:      formBrandColor.value,
      tagline:          formTagline.value.trim(),
      google_review_url:formGoogleUrl.value.trim(),
      whatsapp_number:  formWaNumber.value.trim(),
      whatsapp_message: formWaMessage.value.trim(),
      phone_number:     formPhone.value.trim(),
      instagram_url:    formInsta.value.trim(),
      facebook_url:     formFb.value.trim(),
      custom_message:   formCustomMsg.value.trim(),
      is_active:        formIsActive.checked,
    };

    try {
      await DatabaseService.saveBusiness(payload);
      closeModal();
      await loadData();
    } catch (error) {
      alert(`Unable to save.\n\n${getSupabaseErrorMessage(error)}`);
    }
  });

  // ── QR Studio ───────────────────────────────────────────────────────────
  function populateQrStudio() {
    if (!qrBizSelect) return;
    qrBizSelect.innerHTML = businesses
      .map(b => `<option value="${b.id}">${b.name} (${b.short_code ? `/s/${b.short_code}` : `/${b.slug}`})</option>`)
      .join('');
    if (businesses.length > 0) {
      const b = businesses.find(x => x.id === qrBizSelect.value) || businesses[0];
      updateQrStudio(b);
    }
  }

  qrBizSelect?.addEventListener('change', () => {
    const b = businesses.find(x => x.id === qrBizSelect.value);
    if (b) updateQrStudio(b);
  });

  function updateQrStudio(biz: Business) {
    selectedBizForQr = biz;
    const fullUrl = qrUrlFor(biz);
    if (qrEncodedUrlInput) qrEncodedUrlInput.value = fullUrl;
    if (qrPreviewBizName)  qrPreviewBizName.textContent  = biz.name;
    if (qrPreviewTagline)  qrPreviewTagline.textContent  = biz.short_code ? `/s/${biz.short_code}` : `/${biz.slug}`;
    void renderQrCode();
  }

  async function renderQrCode() {
    if (!selectedBizForQr || !qrPreviewContainer) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const color   = qrColorPicker?.value || '#000000';

    // SVG preview
    try {
      const svgString = await QRCodeLib.toString(fullUrl, {
        type: 'svg',
        color: { dark: color, light: '#ffffff' },
        margin: 2,
        width: 240,
        errorCorrectionLevel: 'M',
      });
      qrPreviewContainer.innerHTML = svgString;
    } catch (err) {
      console.error('QR SVG render failed:', err);
    }

    // High-res canvas for PNG download
    if (qrExportCanvas) {
      try {
        await QRCodeLib.toCanvas(qrExportCanvas, fullUrl, {
          color: { dark: color, light: '#ffffff' },
          margin: 3,
          width: 1024,
          errorCorrectionLevel: 'M',
        });
      } catch (err) {
        console.error('QR canvas render failed:', err);
      }
    }
  }

  qrColorPicker?.addEventListener('input', () => { void renderQrCode(); });
  qrMatchBrandBtn?.addEventListener('click', () => {
    if (selectedBizForQr && qrColorPicker) { qrColorPicker.value = selectedBizForQr.brand_color || '#2563eb'; void renderQrCode(); }
  });
  qrResetBlackBtn?.addEventListener('click', () => {
    if (qrColorPicker) { qrColorPicker.value = '#000000'; void renderQrCode(); }
  });
  copyQrUrlBtn?.addEventListener('click', () => {
    if (qrEncodedUrlInput) { navigator.clipboard.writeText(qrEncodedUrlInput.value); alert('Copied: ' + qrEncodedUrlInput.value); }
  });
  downloadPngBtn?.addEventListener('click', async () => {
    if (!selectedBizForQr) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const color   = qrColorPicker?.value || '#000000';
    try {
      const dataUrl = await QRCodeLib.toDataURL(fullUrl, {
        type: 'image/png',
        color: { dark: color, light: '#ffffff' },
        margin: 3,
        width: 1024,
        errorCorrectionLevel: 'M',
      });
      const a = document.createElement('a');
      a.download = `reviewhub-qr-${selectedBizForQr.short_code || selectedBizForQr.slug}.png`;
      a.href = dataUrl as string;
      a.click();
    } catch (err) {
      alert('Failed to generate PNG: ' + String(err));
    }
  });
  downloadSvgBtn?.addEventListener('click', async () => {
    if (!selectedBizForQr) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const color   = qrColorPicker?.value || '#000000';
    try {
      const svgString = await QRCodeLib.toString(fullUrl, {
        type: 'svg',
        color: { dark: color, light: '#ffffff' },
        margin: 2,
        width: 512,
        errorCorrectionLevel: 'M',
      });
      const a = document.createElement('a');
      a.download = `reviewhub-qr-${selectedBizForQr.short_code || selectedBizForQr.slug}.svg`;
      a.href = URL.createObjectURL(new Blob([svgString], { type: 'image/svg+xml' }));
      a.click();
    } catch (err) {
      alert('Failed to generate SVG: ' + String(err));
    }
  });
  openPrintCardBtn?.addEventListener('click', async () => {
    if (!selectedBizForQr) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    try {
      const svgString = await QRCodeLib.toString(fullUrl, {
        type: 'svg',
        color: { dark: '#000000', light: '#ffffff' },
        margin: 2,
        width: 260,
        errorCorrectionLevel: 'M',
      });
      if (printCardLogo)    printCardLogo.src             = selectedBizForQr.logo_url || '';
      if (printCardTitle)   printCardTitle.textContent    = selectedBizForQr.name;
      if (printCardTagline) printCardTagline.textContent  = selectedBizForQr.tagline || 'Specialty Local Service';
      if (printCardQrBox)   printCardQrBox.innerHTML      = svgString;
      if (printCardUrl)     printCardUrl.textContent      = fullUrl;
      window.print();
    } catch (err) {
      alert('Failed to generate print QR: ' + String(err));
    }
  });

  // ── Analytics ────────────────────────────────────────────────────────────
  async function renderAnalytics() {
    let totalViews = 0, totalReviews = 0, totalWa = 0, totalCalls = 0, totalSocials = 0;
    const summaries: AnalyticsSummary[] = [];

    for (const biz of businesses) {
      const s = await DatabaseService.getAnalytics(biz.id, biz.slug);
      summaries.push(s);
      totalViews   += s.page_views;
      totalReviews += s.google_review_clicks;
      totalWa      += s.whatsapp_clicks;
      totalCalls   += s.call_clicks;
      totalSocials += s.instagram_clicks + s.facebook_clicks;
    }

    if (statTotalViews)    statTotalViews.textContent    = String(totalViews);
    if (statReviewClicks)  statReviewClicks.textContent  = String(totalReviews);
    if (statWaClicks)      statWaClicks.textContent      = String(totalWa);
    if (statSocialClicks)  statSocialClicks.textContent  = String(totalCalls + totalSocials);
    if (statAvgConversion) statAvgConversion.textContent = totalViews > 0 ? `${Math.round((totalReviews/totalViews)*100)}%` : '0%';

    if (analyticsTableBody) {
      analyticsTableBody.innerHTML = summaries.map(s => {
        const biz = businesses.find(b => b.id === s.business_id);
        return `
          <tr style="border-bottom:1px solid var(--border-subtle);">
            <td style="padding:.875rem;">
              <div style="font-weight:700;color:#fff;">${biz ? biz.name : s.slug}</div>
              <div style="font-size:.72rem;color:#818cf8;font-family:monospace;">/${s.slug}</div>
              ${biz?.owner_email ? `<div style="font-size:.68rem;color:var(--text-dim);margin-top:.15rem;">👤 ${ownerShortName(biz.owner_email)}</div>` : ''}
            </td>
            <td style="padding:.875rem;text-align:center;font-weight:600;">${s.page_views}</td>
            <td style="padding:.875rem;text-align:center;font-weight:700;color:#60a5fa;">${s.google_review_clicks}</td>
            <td style="padding:.875rem;text-align:center;font-weight:600;color:#4ade80;">${s.whatsapp_clicks}</td>
            <td style="padding:.875rem;text-align:center;font-weight:600;color:#38bdf8;" class="hide-sm">${s.call_clicks+s.instagram_clicks+s.facebook_clicks}</td>
            <td style="padding:.875rem;text-align:center;">
              <div style="display:flex;align-items:center;justify-content:center;gap:.4rem;">
                <div style="width:50px;height:5px;background:#374151;border-radius:3px;overflow:hidden;">
                  <div style="width:${Math.min(100,s.conversion_rate)}%;height:100%;background:#fbbf24;"></div>
                </div>
                <span style="font-weight:700;color:#fde047;">${s.conversion_rate}%</span>
              </div>
            </td>
          </tr>`;
      }).join('');
    }

    if (liveActivityFeed) {
      const items: string[] = [];
      summaries.forEach(s => {
        const name = businesses.find(b => b.id === s.business_id)?.name || s.slug;
        if (s.google_review_clicks > 0) items.push(`<span>⭐</span><span>5-star Google review — <strong>${name}</strong></span>`);
        if (s.whatsapp_clicks > 0)      items.push(`<span>💬</span><span>WhatsApp chat started — <strong>${name}</strong></span>`);
        if (s.page_views > 0)           items.push(`<span>📱</span><span>QR scanned at counter — <strong>${name}</strong></span>`);
      });
      liveActivityFeed.innerHTML = items.length === 0
        ? `<div style="text-align:center;color:var(--text-muted);padding:1.5rem;">No interactions yet. Scan a counter card!</div>`
        : items.map(i => `
            <div style="display:flex;align-items:center;gap:.75rem;padding:.65rem .875rem;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.05);border-radius:8px;font-size:.84rem;color:#e5e7eb;">
              ${i}
            </div>`).join('');
    }
  }

  // ── Supabase modal ───────────────────────────────────────────────────────
  supabaseSetupModalBtn?.addEventListener('click', () => { if (supabaseModal) supabaseModal.style.display = 'flex'; });
  closeSupabaseModalBtn?.addEventListener('click', () => { if (supabaseModal) supabaseModal.style.display = 'none'; });
  supabaseModal?.addEventListener('click', e => { if (e.target === supabaseModal) supabaseModal.style.display = 'none'; });
  copySqlBtn?.addEventListener('click', () => {
    if (sqlCodeTextarea && copySqlBtnText) {
      navigator.clipboard.writeText(sqlCodeTextarea.value);
      copySqlBtnText.textContent = '✓ Copied!';
      setTimeout(() => { copySqlBtnText.textContent = 'Copy SQL'; }, 2000);
    }
  });

  signOutBtn?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signOut();
    window.location.replace('/admin/login');
  });

  // ── Boot ─────────────────────────────────────────────────────────────────
  loadData();
</script>