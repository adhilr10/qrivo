  // ── Money: sales, expenses, profit ──────────────────────────────────────
  const MONEY_FORMATTER = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 2 });

  function formatMoney(value: number): string {
    const amount = Number(value) || 0;
    return `${amount < 0 ? '-' : ''}₹${MONEY_FORMATTER.format(Math.abs(amount))}`;
  }

  function formatMoneyCompact(value: number): string {
    const amount = Number(value) || 0;
    const abs = Math.abs(amount);
    const sign = amount < 0 ? '-' : '';
    if (abs >= 10000000) return `${sign}₹${(abs / 10000000).toFixed(1)}Cr`;
    if (abs >= 100000) return `${sign}₹${(abs / 100000).toFixed(1)}L`;
    if (abs >= 1000) return `${sign}₹${(abs / 1000).toFixed(abs >= 10000 ? 0 : 1)}k`;
    return `${sign}₹${Math.round(abs)}`;
  }

  function todayInputValue(): string {
    const now = new Date();
    const pad = (value: number) => String(value).padStart(2, '0');
    return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  }

  function formatShortDate(value?: string): string {
    if (!value) return '';
    const parsed = new Date(value.length === 10 ? `${value}T00:00:00` : value);
    if (Number.isNaN(parsed.getTime())) return value;
    return parsed.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function slugifyName(value: string): string {
    return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  // /chaya-kada + Cafe + EVP + Bus Stand → /chaya-kada-cafe-evp-bus-stand
  function descriptiveSlug(name: string, category: string, place: string, road: string): string {
    const tokens: string[] = [];
    const seen = new Set<string>();
    for (const part of [name, category, place, road]) {
      for (const token of slugifyName(part).split('-')) {
        if (token && !seen.has(token)) {
          seen.add(token);
          tokens.push(token);
        }
      }
    }
    return tokens.join('-').slice(0, 90).replace(/-+$/g, '');
  }

  function loadMoneySettings() {
    try {
      const raw = localStorage.getItem(MONEY_SETTINGS_KEY);
      if (raw) {
        const parsed = JSON.parse(raw) as { salePrice?: number; unitCost?: number };
        if (Number.isFinite(parsed.salePrice) && Number(parsed.salePrice) >= 0) {
          moneySettings.salePrice = Number(parsed.salePrice);
        }
        if (Number.isFinite(parsed.unitCost) && Number(parsed.unitCost) >= 0) {
          moneySettings.unitCost = Number(parsed.unitCost);
        }
      }
    } catch { /* localStorage can be blocked; defaults still work */ }

    if (defaultSalePriceInput) defaultSalePriceInput.value = String(moneySettings.salePrice);
    if (defaultUnitCostInput) defaultUnitCostInput.value = String(moneySettings.unitCost);
    updateDefaultMargin();
    updateBulkCostHint();
  }

  function updateBulkCostHint() {
    if (!qrBulkCostHint) return;
    const count = Math.max(0, Math.floor(Number(qrBulkCount?.value) || 0));
    const unitCost = Math.max(0, Number(moneySettings.unitCost) || 0);
    if (count < 1) {
      qrBulkCostHint.textContent = `Making cost ${formatMoney(unitCost)} per QR.`;
      return;
    }
    qrBulkCostHint.textContent =
      `${count} QR ${count === 1 ? 'stand' : 'stands'} × ${formatMoney(unitCost)} = ${formatMoney(count * unitCost)} added to expenses automatically.`;
  }

  function saveMoneySettings() {
    try {
      localStorage.setItem(MONEY_SETTINGS_KEY, JSON.stringify(moneySettings));
    } catch { /* ignore quota/privacy errors */ }
  }

  function updateDefaultMargin() {
    if (!defaultMargin) return;
    const margin = moneySettings.salePrice - moneySettings.unitCost;
    defaultMargin.textContent = margin >= 0
      ? `Profit ${formatMoney(margin)} per QR`
      : `Loss ${formatMoney(Math.abs(margin))} per QR`;
    defaultMargin.style.color = margin >= 0 ? '#14532d' : '#991b1b';
  }

  function updateSalePreview() {
    if (!salePreview) return;
    const quantity = Math.max(1, Math.floor(Number(saleQtyInput?.value) || 1));
    const price = Math.max(0, Number(salePriceInput?.value) || 0);
    const cost = Math.max(0, Number(saleCostInput?.value) || 0);
    const amount = quantity * price;
    const totalCost = quantity * cost;
    const profit = amount - totalCost;
    salePreview.textContent = `Sale ${formatMoney(amount)} · Cost ${formatMoney(totalCost)} · Profit ${formatMoney(profit)}`;
    salePreview.classList.toggle('is-loss', profit < 0);
  }

