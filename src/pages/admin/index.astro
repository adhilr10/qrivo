  function renderMoneyChart() {
    if (!moneyChart) return;
    const monthCount = Number(moneyChartMonths?.value) === 12 ? 12 : 6;
    const now = new Date();
    const buckets = Array.from({ length: monthCount }, (_, index) => {
      const date = new Date(now.getFullYear(), now.getMonth() - (monthCount - 1 - index), 1);
      return {
        key: `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`,
        label: date.toLocaleDateString('en-US', { month: 'short' }),
        revenue: 0,
        spend: 0,
        profit: 0,
      };
    });

    const byMonth = new Map(buckets.map(bucket => [bucket.key, bucket]));
    for (const sale of sales) {
      if (sale.status === 'pending') continue;
      const bucket = byMonth.get((sale.sale_date || '').slice(0, 7));
      if (!bucket) continue;
      bucket.revenue += Number(sale.amount) || 0;
      bucket.spend += Number(sale.cost) || 0;
    }
    for (const expense of expenses) {
      const bucket = byMonth.get((expense.expense_date || '').slice(0, 7));
      if (!bucket) continue;
      bucket.spend += Number(expense.amount) || 0;
    }
    for (const bucket of buckets) bucket.profit = bucket.revenue - bucket.spend;

    const width = 760;
    const height = 280;
    const padLeft = 56;
    const padRight = 16;
    const padTop = 16;
    const padBottom = 44;
    const plotWidth = width - padLeft - padRight;
    const plotHeight = height - padTop - padBottom;

    let maxValue = Math.max(0, ...buckets.map(b => Math.max(b.revenue, b.spend, b.profit)));
    let minValue = Math.min(0, ...buckets.map(b => Math.min(0, b.profit)));
    if (maxValue === minValue) maxValue = minValue + 100;
    const span = maxValue - minValue;
    const niceMax = maxValue + span * 0.12;
    const niceMin = minValue < 0 ? minValue - span * 0.12 : 0;
    const range = niceMax - niceMin || 1;

    const scaleY = (value: number) => padTop + ((niceMax - value) / range) * plotHeight;
    const zeroY = scaleY(0);
    const groupWidth = plotWidth / buckets.length;
    const barWidth = Math.min(20, (groupWidth * 0.7) / 3);
    const barGap = 2;
    const groupBarsWidth = barWidth * 3 + barGap * 2;

    const parts: string[] = [];
    parts.push(`<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Monthly revenue, cost and profit">`);

    // Horizontal grid + value labels
    for (let tick = 0; tick <= 4; tick++) {
      const value = niceMin + (range * tick) / 4;
      const y = scaleY(value);
      const cls = Math.abs(value) < 0.001 ? 'chart-zero' : 'chart-grid';
      parts.push(`<line class="${cls}" x1="${padLeft}" y1="${y.toFixed(1)}" x2="${width - padRight}" y2="${y.toFixed(1)}" />`);
      parts.push(`<text class="chart-label" x="${padLeft - 8}" y="${(y + 3.5).toFixed(1)}" text-anchor="end">${formatMoneyCompact(value)}</text>`);
    }

    // Grouped bars: revenue, cost + expenses, profit
    buckets.forEach((bucket, index) => {
      const startX = padLeft + groupWidth * index + (groupWidth - groupBarsWidth) / 2;
      const values: Array<{ value: number; color: string; name: string }> = [
        { value: bucket.revenue, color: '#22c55e', name: 'Revenue' },
        { value: bucket.spend, color: '#ef4444', name: 'Cost + expenses' },
        { value: bucket.profit, color: '#3b82f6', name: 'Profit' },
      ];

      values.forEach((bar, barIndex) => {
        const x = startX + barIndex * (barWidth + barGap);
        const y = scaleY(bar.value);
        const top = Math.min(y, zeroY);
        const barHeight = Math.max(Math.abs(y - zeroY), bar.value === 0 ? 0 : 1.5);
        parts.push(
          `<rect x="${x.toFixed(1)}" y="${top.toFixed(1)}" width="${barWidth.toFixed(1)}" height="${barHeight.toFixed(1)}" rx="2" fill="${bar.color}">` +
          `<title>${bucket.label}: ${bar.name} ${formatMoney(bar.value)}</title></rect>`,
        );
      });

      const showLabel = monthCount <= 6 || index % 2 === 0;
      if (showLabel) {
        const centerX = padLeft + groupWidth * index + groupWidth / 2;
        parts.push(`<text class="chart-month" x="${centerX.toFixed(1)}" y="${height - padBottom + 20}" text-anchor="middle">${bucket.label}</text>`);
      }
    });

    parts.push('</svg>');
    moneyChart.innerHTML = parts.join('');
  }

  function startSaleEdit(sale: QrSale) {
    if (!saleForm) return;
    if (saleIdInput) saleIdInput.value = sale.id;
    if (saleBusinessInput) saleBusinessInput.value = sale.business_id || '';
    if (saleNameInput) saleNameInput.value = sale.business_name || '';
    if (saleQtyInput) saleQtyInput.value = String(sale.quantity || 1);
    if (salePriceInput) salePriceInput.value = String(Number(sale.unit_price) || 0);
    if (saleCostInput) saleCostInput.value = String(Number(sale.unit_cost) || 0);
    if (saleDateInput) saleDateInput.value = (sale.sale_date || todayInputValue()).slice(0, 10);
    if (saleStatusInput) saleStatusInput.value = sale.status === 'pending' ? 'pending' : 'paid';
    if (saleNoteInput) saleNoteInput.value = sale.note || '';
    if (saleSubmitBtn) saleSubmitBtn.textContent = 'Update sale';
    updateSalePreview();
    if (saleModal) saleModal.style.display = 'flex';
  }

  async function deleteSale(id: string) {
    if (!id) return;
    const sale = sales.find(item => item.id === id);
    if (!window.confirm(`Delete the sale for "${sale?.business_name || 'this customer'}"?`)) return;
    try {
      await DatabaseService.deleteSale(id);
      await loadMoneyData();
    } catch (error) {
      alert(`Could not delete the sale.\n\n${getSupabaseErrorMessage(error)}`);
    }
  }

  function startExpenseEdit(expense: QrExpense) {
    if (!expenseForm) return;
    if (expenseIdInput) expenseIdInput.value = expense.id;
    if (expenseTitleInput) expenseTitleInput.value = expense.title || '';
    if (expenseCategoryInput) expenseCategoryInput.value = expense.category || 'Other';
    if (expenseAmountInput) expenseAmountInput.value = String(Number(expense.amount) || 0);
    if (expenseDateInput) expenseDateInput.value = (expense.expense_date || todayInputValue()).slice(0, 10);
    if (expenseNoteInput) expenseNoteInput.value = expense.note || '';
    if (expenseSubmitBtn) expenseSubmitBtn.textContent = 'Update expense';
    if (expenseModal) expenseModal.style.display = 'flex';
  }

  async function deleteExpense(id: string) {
    if (!id) return;
    const expense = expenses.find(item => item.id === id);
    if (!window.confirm(`Delete "${expense?.title || 'this expense'}"?`)) return;
    try {
      await DatabaseService.deleteExpense(id);
      await loadMoneyData();
    } catch (error) {
      alert(`Could not delete the expense.\n\n${getSupabaseErrorMessage(error)}`);
    }
  }

  function handleMoneySaveError(error: unknown) {
    if (error instanceof MissingTableError) {
      alert('Could not save — the sales and expenses tables are missing in Supabase.');
      return;
    }
    alert(`Unable to save.\n\n${getSupabaseErrorMessage(error)}`);
  }

  saleForm?.addEventListener('submit', async event => {
    event.preventDefault();
    const name = saleNameInput?.value.trim() || '';
    if (!name) { alert('Enter the customer or shop name.'); return; }

    const quantity = Math.max(1, Math.floor(Number(saleQtyInput?.value) || 1));
    const unitPrice = Math.max(0, Number(salePriceInput?.value) || 0);
    const unitCost = Math.max(0, Number(saleCostInput?.value) || 0);

    if (saleSubmitBtn) { saleSubmitBtn.disabled = true; saleSubmitBtn.textContent = 'Saving…'; }

    try {
      await DatabaseService.saveSale({
        id: saleIdInput?.value || undefined,
        business_id: saleBusinessInput?.value || null,
        business_name: name,
        quantity,
        unit_price: unitPrice,
        unit_cost: unitCost,
        status: saleStatusInput?.value === 'pending' ? 'pending' : 'paid',
        sale_date: saleDateInput?.value || todayInputValue(),
        note: saleNoteInput?.value.trim() || '',
      });
      resetSaleForm();
      await loadMoneyData();
    } catch (error) {
      handleMoneySaveError(error);
    } finally {
      if (saleSubmitBtn) {
        saleSubmitBtn.disabled = false;
        saleSubmitBtn.textContent = saleIdInput?.value ? 'Update sale' : 'Save sale';
      }
    }
  });

  expenseForm?.addEventListener('submit', async event => {
    event.preventDefault();
    const title = expenseTitleInput?.value.trim() || '';
    const amount = Number(expenseAmountInput?.value) || 0;
    if (!title) { alert('Enter what the expense was for.'); return; }
    if (amount <= 0) { alert('Enter an amount greater than zero.'); return; }

    if (expenseSubmitBtn) { expenseSubmitBtn.disabled = true; expenseSubmitBtn.textContent = 'Saving…'; }

    try {
      await DatabaseService.saveExpense({
        id: expenseIdInput?.value || undefined,
        title,
        category: expenseCategoryInput?.value || 'Other',
        amount,
        expense_date: expenseDateInput?.value || todayInputValue(),
        note: expenseNoteInput?.value.trim() || '',
      });
      resetExpenseForm();
      await loadMoneyData();
    } catch (error) {
      handleMoneySaveError(error);
    } finally {
      if (expenseSubmitBtn) {
        expenseSubmitBtn.disabled = false;
        expenseSubmitBtn.textContent = expenseIdInput?.value ? 'Update expense' : 'Save expense';
      }
    }
  });

  openSaleModalBtn?.addEventListener('click', () => {
    resetSaleForm();
    if (saleModal) saleModal.style.display = 'flex';
  });
  openExpenseModalBtn?.addEventListener('click', () => {
    resetExpenseForm();
    if (expenseModal) expenseModal.style.display = 'flex';
  });
  document.querySelectorAll<HTMLElement>('[data-money-close]').forEach(button => {
    button.addEventListener('click', () => {
      if (button.dataset.moneyClose === 'saleModal') resetSaleForm();
      else resetExpenseForm();
    });
  });
  [saleModal, expenseModal].forEach(modal => {
    modal?.addEventListener('click', event => {
      if (event.target !== modal) return;
      if (modal === saleModal) resetSaleForm();
      else resetExpenseForm();
    });
  });
  salesFilter?.addEventListener('change', renderSales);
  moneyChartMonths?.addEventListener('change', renderMoneyChart);
  goRecordsBtn?.addEventListener('click', () => switchTab('recordsTab'));

  [saleQtyInput, salePriceInput, saleCostInput].forEach(input => {
    input?.addEventListener('input', updateSalePreview);
  });

  saleBusinessInput?.addEventListener('change', () => {
    const biz = businesses.find(item => item.id === saleBusinessInput.value);
    if (biz && !saleNameInput.value.trim()) saleNameInput.value = biz.name;
  });

  defaultSalePriceInput?.addEventListener('input', () => {
    const previous = moneySettings.salePrice;
    const next = Math.max(0, Number(defaultSalePriceInput.value) || 0);
    moneySettings.salePrice = next;
    saveMoneySettings();
    updateDefaultMargin();
    if (!saleIdInput?.value && Number(salePriceInput?.value) === previous) {
      if (salePriceInput) salePriceInput.value = String(next);
      updateSalePreview();
    }
  });

  defaultUnitCostInput?.addEventListener('input', () => {
    const previous = moneySettings.unitCost;
    const next = Math.max(0, Number(defaultUnitCostInput.value) || 0);
    moneySettings.unitCost = next;
    saveMoneySettings();
    updateDefaultMargin();
    updateBulkCostHint();
    if (!saleIdInput?.value && Number(saleCostInput?.value) === previous) {
      if (saleCostInput) saleCostInput.value = String(next);
      updateSalePreview();
    }
  });

  qrBulkCount?.addEventListener('input', updateBulkCostHint);

  // Restore saved pricing, then seed the forms.
  loadMoneySettings();
  resetSaleForm();
  resetExpenseForm();

  // ── Supabase modal ───────────────────────────────────────────────────────
  supabaseSetupModalBtn?.addEventListener('click', () => { if (supabaseModal) supabaseModal.style.display = 'flex'; });
  closeSupabaseModalBtn?.addEventListener('click', () => { if (supabaseModal) supabaseModal.style.display = 'none'; });
  supabaseModal?.addEventListener('click', e => { if (e.target === supabaseModal) supabaseModal.style.display = 'none'; });
  copySqlBtn?.addEventListener('click', () => {
    if (sqlCodeTextarea && copySqlBtnText) {
      navigator.clipboard.writeText(sqlCodeTextarea.value);
      copySqlBtnText.textContent = '✓ Copied!';
      setTimeout(() => { copySqlBtnText.textContent = 'Copy SQL'; }, 2000);
    }
  });

  signOutBtn?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signOut();
    window.location.replace('/admin/login');
  });

  // ── Boot ─────────────────────────────────────────────────────────────────
  loadData();
</script>
