---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="ReviewHub Admin | Manage Businesses & Counter QR Codes" hideNav={false}>
  <div class="admin-page-container">
    
    <!-- Admin Top Header Banner -->
    <div class="admin-header no-print">
      <div class="container admin-header-flex">
        <div>
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem;">
            <h1 style="font-size: 1.5rem; font-weight: 800; color: #ffffff;">Admin Management Portal</h1>
            <span id="backendStatusPill" class="status-pill local">
              <span class="status-dot"></span>
              <span id="backendStatusText">Checking Backend...</span>
            </span>
          </div>
          <p style="font-size: 0.875rem; color: var(--text-muted);">
            Manage counter QR destinations, brand landing pages, and review conversion analytics.
          </p>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <span id="adminUserEmail" style="font-size: 0.8125rem; color: var(--text-muted);"></span>
          <button id="signOutBtn" class="btn btn-outline btn-sm" title="Sign out of the admin portal">
            Sign out
          </button>
          <button id="supabaseSetupModalBtn" class="btn btn-outline btn-sm" title="View Supabase Database Setup & SQL">
            <Icon name="settings" size={15} />
            <span>Supabase SQL</span>
          </button>
          <button id="openNewBizBtn" class="btn btn-primary btn-sm">
            <Icon name="plus" size={16} />
            <span>Add New Business</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Container -->
    <div class="container" style="padding-top: 1.5rem; padding-bottom: 4rem;">

      <!-- Nav Tabs -->
      <div class="admin-tabs no-print">
        <button class="tab-btn active" data-tab="businessesTab">
          <Icon name="shield-check" size={17} />
          <span>Businesses (<span id="bizCountBadge">0</span>)</span>
        </button>
        <button class="tab-btn" data-tab="analyticsTab">
          <Icon name="bar-chart" size={17} />
          <span>Analytics & Conversions</span>
        </button>
        <button class="tab-btn" data-tab="qrStudioTab">
          <Icon name="qrcode" size={17} />
          <span>QR Studio & Counter Tent Card</span>
        </button>
      </div>

      <!-- ======================================================================
           TAB 1: BUSINESSES DIRECTORY & MANAGEMENT
           ====================================================================== -->
      <div id="businessesTab" class="tab-content">
        <!-- Search & Filter bar -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
          <div style="position: relative; max-width: 380px; width: 100%;">
            <input
              type="text"
              id="searchBizInput"
              placeholder="Search by business name or slug..."
              class="form-input"
              style="padding-left: 2.5rem;"
            />
            <span style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-dim);">🔍</span>
          </div>

          <div style="font-size: 0.875rem; color: var(--text-muted);">
            💡 <em>Tip: The printed /s/ short link never changes. Reassign it after a business is rejected — no QR reprint.</em>
          </div>
        </div>

        <!-- Business Cards Grid -->
        <div class="business-list-grid" id="businessListContainer">
          <!-- Dynamically populated via script -->
          <div style="text-align: center; padding: 3rem; color: var(--text-muted);">
            Loading businesses...
          </div>
        </div>
      </div>

      <!-- ======================================================================
           TAB 2: ANALYTICS DASHBOARD
           ====================================================================== -->
      <div id="analyticsTab" class="tab-content" style="display: none;">
        <!-- Top Stats Cards -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-card-title">
              <span>TOTAL SCANS / VIEWS</span>
              <span>📱</span>
            </div>
            <div class="stat-card-value" id="statTotalViews">0</div>
            <div class="stat-card-change">Across all active counter cards</div>
          </div>

          <div class="stat-card" style="border-color: rgba(66, 133, 244, 0.3);">
            <div class="stat-card-title">
              <span>GOOGLE REVIEW CLICKS</span>
              <span style="color: #4285f4;">⭐</span>
            </div>
            <div class="stat-card-value" id="statReviewClicks" style="color: #60a5fa;">0</div>
            <div class="stat-card-change">High-intent customers rated on Google</div>
          </div>

          <div class="stat-card" style="border-color: rgba(37, 211, 102, 0.3);">
            <div class="stat-card-title">
              <span>WHATSAPP INQUIRIES</span>
              <span style="color: #25d366;">💬</span>
            </div>
            <div class="stat-card-value" id="statWaClicks" style="color: #4ade80;">0</div>
            <div class="stat-card-change">Direct customer chat starts</div>
          </div>

          <div class="stat-card">
            <div class="stat-card-title">
              <span>PHONE CALLS & SOCIALS</span>
              <span>📞</span>
            </div>
            <div class="stat-card-value" id="statSocialClicks">0</div>
            <div class="stat-card-change">Calls, Instagram & Facebook taps</div>
          </div>

          <div class="stat-card" style="border-color: rgba(245, 158, 11, 0.3);">
            <div class="stat-card-title">
              <span>REVIEW CONVERSION RATE</span>
              <span style="color: #fbbf24;">🎯</span>
            </div>
            <div class="stat-card-value" id="statAvgConversion" style="color: #fde047;">0%</div>
            <div class="stat-card-change">Scan-to-Google Review conversion</div>
          </div>
        </div>

        <!-- Business Breakdown Analytics Table -->
        <div class="glass-card" style="padding: 1.5rem; margin-bottom: 2rem;">
          <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 1.25rem; color: #ffffff;">
            Business Conversion Breakdown
          </h2>
          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border-subtle); color: var(--text-muted);">
                  <th style="padding: 0.75rem 1rem;">BUSINESS / SLUG</th>
                  <th style="padding: 0.75rem 1rem; text-align: center;">VIEWS</th>
                  <th style="padding: 0.75rem 1rem; text-align: center;">GOOGLE REVIEWS</th>
                  <th style="padding: 0.75rem 1rem; text-align: center;">WHATSAPP</th>
                  <th style="padding: 0.75rem 1rem; text-align: center;">CALLS / SOCIAL</th>
                  <th style="padding: 0.75rem 1rem; text-align: center;">CONVERSION RATE</th>
                </tr>
              </thead>
              <tbody id="analyticsTableBody">
                <!-- Populated via script -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Live Activity Stream -->
        <div class="glass-card" style="padding: 1.5rem;">
          <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; color: #ffffff; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚡ Recent Anonymous Customer Interactions</span>
          </h2>
          <div id="liveActivityFeed" style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 350px; overflow-y: auto;">
            <!-- Populated via script -->
          </div>
        </div>
      </div>

      <!-- ======================================================================
           TAB 3: QR CODE STUDIO & PRINTABLE COUNTER TENT CARD
           ====================================================================== -->
      <div id="qrStudioTab" class="tab-content" style="display: none;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start;">
          
          <!-- Left: QR Customization Form -->
          <div class="glass-card" style="padding: 1.75rem;">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #ffffff;">
              Dynamic QR Code Studio
            </h2>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem;">
              Generate high-resolution PNG & SVG QR codes for physical counter stands.
              The matrix always encodes the permanent short link (<code>/s/xxxxxx</code>), so rejecting a business and assigning a new slug never breaks printed cards.
            </p>

            <div class="form-group" style="margin-bottom: 1.25rem;">
              <label class="form-label" for="qrBizSelect">Select Business Destination</label>
              <select id="qrBizSelect" class="form-select">
                <!-- Populated via script -->
              </select>
            </div>

            <div class="form-group" style="margin-bottom: 1.25rem;">
              <label class="form-label">Destination URL Preview</label>
              <div style="display: flex; gap: 0.5rem;">
                <input type="text" id="qrEncodedUrlInput" class="form-input" readonly />
                <button type="button" id="copyQrUrlBtn" class="btn btn-secondary btn-sm" title="Copy URL">
                  <Icon name="copy" size={16} />
                </button>
              </div>
              <span class="form-helper">This shortener URL is encoded in the QR matrix and stays the same even if the business page slug changes.</span>
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
              <label class="form-label">QR Code Foreground Color</label>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <input type="color" id="qrColorPicker" value="#000000" style="width: 48px; height: 38px; border-radius: 8px; border: 1px solid var(--border-subtle); background: none; cursor: pointer;" />
                <button type="button" class="btn btn-outline btn-sm" id="qrMatchBrandBtn">Match Brand Color</button>
                <button type="button" class="btn btn-outline btn-sm" id="qrResetBlackBtn">Classic Black</button>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <button type="button" id="downloadPngBtn" class="btn btn-primary" style="width: 100%;">
                <Icon name="download" size={18} />
                <span>Download High-Res Print PNG (1024x1024)</span>
              </button>

              <button type="button" id="downloadSvgBtn" class="btn btn-secondary" style="width: 100%;">
                <Icon name="download" size={18} />
                <span>Download Vector SVG (For Sign Makers)</span>
              </button>

              <button type="button" id="openPrintCardBtn" class="btn btn-outline" style="width: 100%; border-color: #6366f1; color: #a5b4fc;">
                <span>🖨️ Print Counter Tent Stand (1-Click)</span>
              </button>
            </div>
          </div>

          <!-- Right: Live QR Preview & Counter Tent Mockup -->
          <div class="glass-card" style="padding: 1.75rem; text-align: center;">
            <div style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">
              Live QR Preview
            </div>

            <div style="display: inline-block; padding: 1.25rem; background: #ffffff; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.4); margin-bottom: 1.25rem;">
              <div id="qrPreviewContainer" style="display: flex; justify-content: center; align-items: center; min-width: 240px; min-height: 240px;">
                <!-- QR SVG rendered here -->
              </div>
            </div>

            <div style="font-size: 1rem; font-weight: 700; color: #ffffff;" id="qrPreviewBizName">
              Select a business
            </div>
            <div style="font-size: 0.8125rem; color: var(--text-dim); margin-top: 0.25rem;" id="qrPreviewTagline">
              Point phone camera to test
            </div>

            <!-- Hidden canvas for high-res PNG export -->
            <canvas id="qrExportCanvas" style="display: none;"></canvas>
          </div>

        </div>
      </div>

    </div>

    <!-- ======================================================================
         MODAL: CREATE / EDIT BUSINESS WITH LIVE SMARTPHONE PREVIEW
         ====================================================================== -->
    <div id="bizModal" class="modal-backdrop" style="display: none;">
      <div class="modal-dialog">
        <div class="modal-header">
          <h2 id="modalTitle" style="font-size: 1.25rem; font-weight: 700; color: #ffffff;">Create Business</h2>
          <button type="button" id="closeModalBtn" style="color: var(--text-muted); font-size: 1.5rem; line-height: 1;">&times;</button>
        </div>

        <div class="modal-body-split">
          <!-- Left: Form Inputs -->
          <form id="bizForm" style="display: flex; flex-direction: column; gap: 1.15rem;">
            <input type="hidden" id="formBizId" />

            <div class="form-group">
              <label class="form-label" for="formName">Business Name *</label>
              <input type="text" id="formName" class="form-input" placeholder="e.g. Bella Italia Trattoria" required />
            </div>

            <div class="form-group">
              <label class="form-label" for="formSlug">
                <span>Unique Counter URL Slug *</span>
                <span id="slugAvailabilityBadge" style="font-size: 0.75rem; color: #34d399;">Available</span>
              </label>
              <div style="display: flex; align-items: center;">
                <span style="background: #1f2937; padding: 0.75rem 0.85rem; border: 1px solid var(--border-subtle); border-right: none; border-radius: var(--radius-md) 0 0 var(--radius-md); font-size: 0.85rem; color: var(--text-dim);">
                  /
                </span>
                <input
                  type="text"
                  id="formSlug"
                  class="form-input"
                  placeholder="bella-italia"
                  style="border-radius: 0 var(--radius-md) var(--radius-md) 0;"
                  required
                />
              </div>
              <span class="form-helper">
                Pretty landing URL (can change). Printed QR codes use the shortener below, not this slug.
              </span>
            </div>

            <div class="form-group" id="shortLinkCreateGroup">
              <label class="form-label" for="formReuseShortCode">QR shortener link</label>
              <select id="formReuseShortCode" class="form-select">
                <option value="">Generate a new permanent short link</option>
              </select>
              <span class="form-helper">
                Choose an unused printed QR code after a business is rejected, or generate a new one.
              </span>
            </div>

            <div class="form-group" id="shortLinkEditGroup" style="display: none;">
              <label class="form-label">Permanent QR shortener (never changes)</label>
              <input type="text" id="formShortLinkDisplay" class="form-input" readonly />
              <span class="form-helper">
                This is the URL encoded in the physical QR. You can change the slug above without reprinting.
              </span>
            </div>

            <!-- Reassign Slug Warning Banner -->
            <div id="reassignSlugNotice" style="display: none; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 0.75rem; font-size: 0.8125rem; color: #fde68a;">
              ♻️ <strong>Printed QR stays valid:</strong> Keep the shortener link. Changing the business slug or destinations does not require a reprint.
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formLogoUrl">Logo Image URL</label>
                <input
                  type="url"
                  id="formLogoUrl"
                  class="form-input"
                  placeholder="https://images.unsplash.com/..."
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="formBrandColor">Brand Primary Color</label>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <input type="color" id="formBrandColor" value="#2563eb" style="width: 44px; height: 38px; border-radius: 8px; border: 1px solid var(--border-subtle); background: none; cursor: pointer;" />
                  <input type="text" id="formBrandColorText" class="form-input" value="#2563eb" style="width: 100px;" />
                  <div style="display: flex; gap: 4px;">
                    <button type="button" class="color-preset-dot" data-color="#2563eb" style="background: #2563eb;"></button>
                    <button type="button" class="color-preset-dot" data-color="#d97706" style="background: #d97706;"></button>
                    <button type="button" class="color-preset-dot" data-color="#059669" style="background: #059669;"></button>
                    <button type="button" class="color-preset-dot" data-color="#dc2626" style="background: #dc2626;"></button>
                    <button type="button" class="color-preset-dot" data-color="#7c3aed" style="background: #7c3aed;"></button>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formTagline">Short Tagline</label>
              <input type="text" id="formTagline" class="form-input" placeholder="e.g. Wood-fired pizza & handcrafted pasta" />
            </div>

            <div class="form-group">
              <label class="form-label" for="formGoogleUrl">
                <span>Google Review Link *</span>
                <a href="https://support.google.com/business/answer/7035772" target="_blank" rel="noopener noreferrer" style="font-size: 0.75rem; color: #60a5fa; text-decoration: underline;">
                  How to get link?
                </a>
              </label>
              <input
                type="url"
                id="formGoogleUrl"
                class="form-input"
                placeholder="https://search.google.com/local/writereview?placeid=..."
                required
              />
              <span class="form-helper">The direct URL that opens the 5-star Google review box.</span>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formWaNumber">WhatsApp Number</label>
                <input type="text" id="formWaNumber" class="form-input" placeholder="+15551234567" />
              </div>

              <div class="form-group">
                <label class="form-label" for="formPhone">Phone Number</label>
                <input type="text" id="formPhone" class="form-input" placeholder="+1 (555) 123-4567" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formWaMessage">WhatsApp Default Greeting</label>
              <input
                type="text"
                id="formWaMessage"
                class="form-input"
                placeholder="Hi! I am contacting you from your counter QR card."
              />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formInsta">Instagram Profile URL</label>
                <input type="url" id="formInsta" class="form-input" placeholder="https://instagram.com/yourbusiness" />
              </div>

              <div class="form-group">
                <label class="form-label" for="formFb">Facebook Page URL</label>
                <input type="url" id="formFb" class="form-input" placeholder="https://facebook.com/yourbusiness" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formCustomMsg">Custom Thank-You Message</label>
              <textarea
                id="formCustomMsg"
                class="form-textarea"
                rows="2"
                placeholder="Thank you for supporting our local team! Please take 10 seconds to share your review."
              ></textarea>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #111827; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
              <div>
                <div style="font-weight: 600; font-size: 0.9375rem; color: #ffffff;">Active Counter Stand</div>
                <div style="font-size: 0.75rem; color: var(--text-dim);">Inactive stands display a friendly pause notice.</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="formIsActive" checked />
                <span class="slider round"></span>
              </label>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem;">
              <button type="button" id="cancelFormBtn" class="btn btn-secondary">Cancel</button>
              <button type="submit" id="saveBizSubmitBtn" class="btn btn-primary">
                <Icon name="check" size={16} />
                <span>Save Business</span>
              </button>
            </div>
          </form>

          <!-- Right: Real-time Live Phone Mockup Preview -->
          <div class="phone-mockup-wrapper">
            <div style="text-align: center; margin-bottom: 0.75rem; font-size: 0.8125rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">
              Live Customer Mobile Preview
            </div>
            <div class="smartphone-frame" id="livePhoneMockup">
              <!-- Dynamically mirrored via JavaScript -->
              <div class="smartphone-screen" id="previewScreen">
                <div style="width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 0.75rem auto; border: 2px solid var(--brand); overflow: hidden; background: #1f2937;">
                  <img id="prevImg" src="" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <div style="font-size: 0.65rem; color: #60a5fa; font-weight: 600; margin-bottom: 0.25rem;">VERIFIED LOCAL BUSINESS</div>
                <div id="prevName" style="font-size: 1.15rem; font-weight: 800; color: #ffffff; line-height: 1.2;">Business Name</div>
                <div id="prevTagline" style="font-size: 0.75rem; color: #9ca3af; margin-bottom: 1rem;">Tagline appears here</div>

                <div style="background: rgba(255,255,255,0.04); border-radius: 8px; padding: 0.5rem; margin-bottom: 0.75rem;">
                  <div style="font-size: 0.7rem; color: #d1d5db; margin-bottom: 0.25rem;">Rate your experience</div>
                  <div style="color: #fbbf24; font-size: 1.1rem; letter-spacing: 2px;">★★★★★</div>
                </div>

                <div style="background: #ffffff; color: #111827; border-radius: 8px; padding: 0.65rem; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                  <span style="color: #4285f4; font-weight: 900;">G</span>
                  <span>Rate us on Google</span>
                </div>

                <div id="prevWa" style="display: none; background: #25d366; color: #ffffff; border-radius: 8px; padding: 0.55rem; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.75rem;">
                  Chat on WhatsApp
                </div>

                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-bottom: 0.75rem;">
                  <div style="background: rgba(255,255,255,0.06); padding: 6px 2px; border-radius: 6px; font-size: 0.6rem; color: #e5e7eb;">Call</div>
                  <div style="background: rgba(255,255,255,0.06); padding: 6px 2px; border-radius: 6px; font-size: 0.6rem; color: #e5e7eb;">WhatsApp</div>
                  <div style="background: rgba(255,255,255,0.06); padding: 6px 2px; border-radius: 6px; font-size: 0.6rem; color: #e5e7eb;">Instagram</div>
                  <div style="background: rgba(255,255,255,0.06); padding: 6px 2px; border-radius: 6px; font-size: 0.6rem; color: #e5e7eb;">Facebook</div>
                </div>

                <div id="prevMsg" style="font-size: 0.65rem; color: #6b7280; line-height: 1.3;">
                  Custom thank-you note
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         MODAL: SUPABASE SETUP & SQL MIGRATION VIEWER
         ====================================================================== -->
    <div id="supabaseModal" class="modal-backdrop" style="display: none;">
      <div class="modal-dialog" style="max-width: 720px;">
        <div class="modal-header">
          <h2 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚡ Supabase Backend Integration</span>
          </h2>
          <button type="button" id="closeSupabaseModalBtn" style="color: var(--text-muted); font-size: 1.5rem; line-height: 1;">&times;</button>
        </div>

        <div style="padding: 1.5rem;">
          <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
            ReviewHub connects to Supabase for PostgreSQL persistence, Row Level Security, and real-time analytics. 
            Paste the SQL schema below directly into your <strong>Supabase SQL Editor</strong> to create the tables, indexes, and security policies.
          </p>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8125rem; font-weight: 600; color: #d1d5db;">supabase/schema.sql</span>
            <button type="button" id="copySqlBtn" class="btn btn-outline btn-sm">
              <Icon name="copy" size={14} />
              <span id="copySqlBtnText">Copy Migration SQL</span>
            </button>
          </div>

          <textarea
            id="sqlCodeTextarea"
            readonly
            rows="12"
            style="width: 100%; font-family: monospace; font-size: 0.8125rem; background: #090d16; color: #34d399; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; resize: vertical;"
          >-- ReviewHub Supabase Schema
-- Run this in your Supabase project's SQL editor

CREATE TABLE IF NOT EXISTS public.businesses (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    logo_url TEXT DEFAULT '',
    brand_color VARCHAR(20) DEFAULT '#2563eb',
    tagline VARCHAR(255) DEFAULT '',
    google_review_url TEXT NOT NULL,
    whatsapp_number VARCHAR(50) DEFAULT '',
    whatsapp_message TEXT DEFAULT '',
    phone_number VARCHAR(50) DEFAULT '',
    instagram_url TEXT DEFAULT '',
    facebook_url TEXT DEFAULT '',
    custom_message TEXT DEFAULT '',
    is_active BOOLEAN DEFAULT true NOT NULL,
    user_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL
);

CREATE TABLE IF NOT EXISTS public.analytics_events (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    business_id UUID REFERENCES public.businesses(id) ON DELETE CASCADE NOT NULL,
    slug VARCHAR(100) NOT NULL,
    event_type VARCHAR(50) NOT NULL,
    user_agent TEXT,
    referrer TEXT,
    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL
);

CREATE TABLE IF NOT EXISTS public.short_links (
    code VARCHAR(12) PRIMARY KEY,
    business_id UUID REFERENCES public.businesses(id) ON DELETE SET NULL,
    last_label TEXT DEFAULT '',
    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- RLS Policies
ALTER TABLE public.businesses ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.analytics_events ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.short_links ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Public can view businesses by slug" ON public.businesses FOR SELECT TO anon, authenticated USING (true);
CREATE POLICY "Admins manage businesses" ON public.businesses FOR ALL TO authenticated
  USING (auth.uid() = user_id OR user_id IS NULL)
  WITH CHECK (auth.uid() = user_id OR user_id IS NULL);
CREATE POLICY "Public can log analytics" ON public.analytics_events FOR INSERT WITH CHECK (true);
CREATE POLICY "Admins can view analytics" ON public.analytics_events FOR SELECT TO authenticated USING (true);
CREATE POLICY "Public can resolve short links" ON public.short_links FOR SELECT TO anon, authenticated USING (true);
CREATE POLICY "Admins manage short links" ON public.short_links FOR ALL TO authenticated USING (true) WITH CHECK (true);
