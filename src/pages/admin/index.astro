    void downloadQrZip(unassignedShortLinks, label, qrStockDownloadAllBtn);
  });

  // ── Assign a stock QR to an existing business ───────────────────────────
  async function openAssignModal(code: string) {
    pendingAssignCode = code;
    if (!assignQrModal) return;

    const withQr = new Set(businesses.filter(b => b.short_code).map(b => b.id));
    const ordered = [...businesses].sort((a, b) => Number(withQr.has(a.id)) - Number(withQr.has(b.id)));

    if (assignBizSelect) {
      assignBizSelect.innerHTML = ordered.length
        ? ordered
            .map(b => `<option value="${b.id}">${b.name}${b.short_code ? ` — currently /s/${b.short_code}` : ' — no QR yet'}</option>`)
            .join('')
        : '<option value="">Add a business first</option>';
    }

    if (assignQrPreview) {
      assignQrPreview.innerHTML = `
        <div class="assign-qr-text">
          <span class="assign-qr-code">/s/${code}</span>
          Blank stand — pick the business that should answer this scan.
        </div>`;
      try {
        const svg = await QRCodeLib.toString(stockLinkUrl(code), {
          type: 'svg',
          margin: 1,
          width: 168,
          color: { dark: '#000000', light: '#ffffff' },
        });
        assignQrPreview.insertAdjacentHTML('afterbegin', svg);
      } catch {
        // The QR preview is optional; the code is still shown as text.
      }
    }

    assignQrModal.style.display = 'flex';
  }

  function closeAssignModal() {
    if (assignQrModal) assignQrModal.style.display = 'none';
    pendingAssignCode = '';
  }

  async function confirmAssignQr() {
    const businessId = assignBizSelect?.value || '';
    const code = pendingAssignCode;
    if (!code || !businessId) return;

    const biz = businesses.find(b => b.id === businessId);
    if (!biz) return;

    if (biz.short_code) {
      const ok = window.confirm(
        `"${biz.name}" currently uses /s/${biz.short_code}.\n\n` +
          `Assign /s/${code} instead? The old stand goes back to the unassigned list.`,
      );
      if (!ok) return;
    }

    if (confirmAssignQrBtn) { confirmAssignQrBtn.disabled = true; confirmAssignQrBtn.textContent = 'Assigning…'; }
    try {
      await DatabaseService.assignShortLink(biz.id, code, biz.name);
      closeAssignModal();
      await loadData();
    } catch (error) {
      alert(`Could not assign the QR.\n\n${getSupabaseErrorMessage(error)}`);
    } finally {
      if (confirmAssignQrBtn) { confirmAssignQrBtn.disabled = false; confirmAssignQrBtn.textContent = 'Assign QR'; }
    }
  }

  closeAssignQrBtn?.addEventListener('click', closeAssignModal);
  cancelAssignQrBtn?.addEventListener('click', closeAssignModal);
  assignQrModal?.addEventListener('click', e => { if (e.target === assignQrModal) closeAssignModal(); });
  confirmAssignQrBtn?.addEventListener('click', () => { void confirmAssignQr(); });

  // ── QR scanner (assign a printed stand from the business form) ──────────
  function extractShortCode(value: string): string {
    const raw = (value || '').trim();
    if (!raw) return '';
    const pathMatch = raw.match(/\/s\/([a-z0-9]{4,12})(?:[?#/]|$)/i);
    if (pathMatch) return pathMatch[1].toLowerCase();
    if (/^[a-z0-9]{4,12}$/i.test(raw)) return raw.toLowerCase();
    return '';
  }

  function setScanStatus(text: string) {
    if (qrScanStatus) qrScanStatus.textContent = text;
  }

  async function startScanner() {
    if (!qrScanVideo) return;
    scanBusy = false;
    if (qrScanResult) { qrScanResult.hidden = true; qrScanResult.innerHTML = ''; }
    setScanStatus('Requesting camera…');

    try {
      if (!qrScanner) {
        qrScanner = new QrScanner(
          qrScanVideo,
          result => { void handleScanResult(result.data); },
          {
            returnDetailedScanResult: true,
            preferredCamera: 'environment',
            highlightScanRegion: false,
            highlightCodeOutline: false,
            maxScansPerSecond: 6,
            onDecodeError: () => {},
          },
        );
      }
      await qrScanner.start();
      setScanStatus('Point the camera at the QR code printed on the stand.');
    } catch {
      setScanStatus('Camera unavailable — type the code below instead.');
    }
  }

  function stopScanner() {
    try { qrScanner?.stop(); } catch { /* the camera may already be closed */ }
    scanBusy = false;
  }

  async function handleScanResult(text: string) {
    if (scanBusy) return;
    const code = extractShortCode(text);
    if (!code) {
      setScanStatus('That QR is not a Qrivo stand. Try another.');
      return;
    }
    scanBusy = true;
    try { await qrScanner?.pause(); } catch { /* ignore */ }
    setScanStatus('Code found — checking stock…');
    await showScanResult(code);
    scanBusy = false;
  }

  async function showScanResult(code: string) {
    if (!qrScanResult) return;

    let link: (ShortLink & { business: Business | null }) | null = null;
    try {
      link = await DatabaseService.lookupShortLink(code);
    } catch {
      link = null;
    }

    const assignedName = link?.business?.name || '';
    let html = `<span class="qr-scan-result-code">/s/${code}</span>`;

    if (!link) {
      html += 'This code is not in your QR stock yet. Create it in <strong>Bulk QR Stands</strong> before printing.';
      setScanStatus('Code not found.');
    } else if (assignedName) {
      html += `Already in use by <strong>${assignedName}</strong>. Choosing it here moves the stand to this business.`;
      setScanStatus('Code found — already assigned.');
    } else {
      html += `Blank stand from stock${link.last_label ? ` (${link.last_label})` : ''}. Ready to assign.`;
      setScanStatus('Code found — ready to assign.');
    }

    const actions = link
      ? `<div class="qr-scan-result-actions">
           <button type="button" class="btn btn-primary btn-sm" data-scan-use>Use /s/${code}</button>
           <button type="button" class="btn btn-outline btn-sm" data-scan-again>Scan again</button>
         </div>`
      : `<div class="qr-scan-result-actions">
           <button type="button" class="btn btn-outline btn-sm" data-scan-again>Scan again</button>
         </div>`;

    qrScanResult.innerHTML = html + actions;
    qrScanResult.hidden = false;

    qrScanResult.querySelector('[data-scan-use]')?.addEventListener('click', () => {
      applyScannedCode(code, assignedName);
    });
    qrScanResult.querySelector('[data-scan-again]')?.addEventListener('click', () => { void startScanner(); });
  }

  function applyScannedCode(code: string, assignedName = '') {
    if (!formQrCode) return;
    const exists = Array.from(formQrCode.options).some(option => option.value === code);
    if (!exists) {
      const option = document.createElement('option');
      option.value = code;
      option.textContent = assignedName
        ? `/s/${code} — currently ${assignedName}`
        : `/s/${code} — scanned stand`;
      formQrCode.appendChild(option);
    }
    formQrCode.value = code;
    updateQrFormBanner();
    closeQrScanModal();
  }

  function openQrScanModal() {
    if (!qrScanModal) return;
    if (qrScanResult) { qrScanResult.hidden = true; qrScanResult.innerHTML = ''; }
    if (qrScanManualInput) qrScanManualInput.value = '';
    qrScanModal.style.display = 'flex';
    void startScanner();
  }

  function closeQrScanModal() {
    stopScanner();
    if (qrScanModal) qrScanModal.style.display = 'none';
  }

  openQrScanBtn?.addEventListener('click', openQrScanModal);
  closeQrScanBtn?.addEventListener('click', closeQrScanModal);
  qrScanModal?.addEventListener('click', e => { if (e.target === qrScanModal) closeQrScanModal(); });

  qrScanManualBtn?.addEventListener('click', () => {
    const code = extractShortCode(qrScanManualInput?.value || '');
    if (!code) {
      setScanStatus('That is not a Qrivo code. Try something like /s/abc123.');
      return;
    }
    void showScanResult(code);
  });

  qrScanManualInput?.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      e.preventDefault();
      (qrScanManualBtn as HTMLButtonElement | null)?.click();
    }
  });

  // ── Google review link generator ────────────────────────────────────────
  const WRITE_REVIEW_BASE = 'https://search.google.com/local/writereview?placeid=';
  let builtReviewUrl = '';

  // Accept a raw Place ID, or pull one out of a Google Maps link.
  function extractPlaceId(value: string): string {
    const raw = (value || '').trim();
    if (!raw) return '';
    if (/^[A-Za-z0-9_-]{15,}$/.test(raw)) return raw;
    const explicit = raw.match(/place_?id(?:=|%3D|:)\s*([A-Za-z0-9_-]{10,})/i);
    if (explicit) return decodeURIComponent(explicit[1]);
    const legacy = raw.match(/ChIJ[A-Za-z0-9_-]{5,}/);
    if (legacy) return legacy[0];
    return '';
  }

  function applyReviewLink(url: string) {
    const clean = (url || '').trim();
    if (!/^https?:\/\//i.test(clean)) {
      alert('Paste a full link that starts with https://');
      return;
    }
    formGoogleUrl.value = clean;
    formGoogleUrl.dispatchEvent(new Event('input', { bubbles: true }));
    closeGoogleLinkModal();
  }

  function openGoogleLinkModal() {
    if (!googleLinkModal) return;
    // Load the embedded generator only the first time it is needed.
    if (glFrame && !glFrame.getAttribute('src')) {
      if (glFrameLoading) glFrameLoading.style.display = 'grid';
      glFrame.src = glFrame.dataset.src || '';
    }
    if (glPasteInput) glPasteInput.value = '';
    googleLinkModal.style.display = 'flex';
  }

  function closeGoogleLinkModal() {
    if (googleLinkModal) googleLinkModal.style.display = 'none';
  }

  function showBuiltError(message: string) {
    if (!glBuiltError) return;
    glBuiltError.textContent = message;
    glBuiltError.hidden = !message;
  }

  function showBuiltResult(url: string, placeId = '') {
    builtReviewUrl = url;
    if (glBuiltUrl) glBuiltUrl.textContent = url;
    if (glBuiltPlaceId && glBuiltPlaceIdRow) {
      glBuiltPlaceId.textContent = placeId;
      glBuiltPlaceIdRow.hidden = !placeId;
    }
    if (glBuiltPreview) glBuiltPreview.hidden = false;
    showBuiltError('');
  }

  function hideBuiltResult() {
    builtReviewUrl = '';
    if (glBuiltPreview) glBuiltPreview.hidden = true;
    if (glBuiltPlaceIdRow) glBuiltPlaceIdRow.hidden = true;
  }

  // A Place ID can become a review link without any network call.
  function buildFromPlaceId(value: string): string {
    const id = extractPlaceId(value);
    if (!id) return '';
    const url = WRITE_REVIEW_BASE + encodeURIComponent(id);
    showBuiltResult(url, id);
    return url;
  }

  // Maps links (including maps.app.goo.gl share links) are resolved server-side
  // through /api/review-link, because the upstream API sends no CORS headers.
  async function resolveReviewLink() {
    const raw = (glPlaceIdInput?.value || '').trim();
    if (!raw) {
      showBuiltError('Paste a Google Maps link or a Place ID first.');
      return;
    }

    if (!/^https?:\/\//i.test(raw)) {
      if (buildFromPlaceId(raw)) return;
      showBuiltError('Paste the business\'s Google Maps link (Share → Copy link) or a Place ID starting with "ChIJ".');
      return;
    }

    hideBuiltResult();
    const btn = glBuildBtn as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = 'Finding…'; }

    try {
      const res = await fetch('/api/review-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ maps_url: raw }),
      });
      const data = (await res.json().catch(() => null)) as
        | { review_url?: string; place_id?: string; error?: { message?: string } }
        | null;

      if (!res.ok || !data?.review_url) {
        showBuiltError(
          data?.error?.message || 'Could not read that link. Try the Share link for the exact business.',
        );
        return;
      }

      showBuiltResult(data.review_url, data.place_id || '');
    } catch {
      showBuiltError('Could not reach the lookup service. Use the generator below instead.');
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = 'Get link'; }
    }
  }

