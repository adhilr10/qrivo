  function isQrMakingExpense(expense: QrExpense): boolean {
    return (expense.category || '').trim().toLowerCase() === 'qr making';
  }

  function moneyTotals() {
    let revenue = 0;
    let soldMakingCost = 0;
    let qrMakingExpenses = 0;
    let otherExpenses = 0;
    let pending = 0;
    let unitsPaid = 0;

    for (const sale of sales) {
      const amount = Number(sale.amount) || 0;
      const cost = Number(sale.cost) || 0;
      if (sale.status === 'pending') {
        pending += amount;
        continue;
      }
      revenue += amount;
      soldMakingCost += cost;
      unitsPaid += Number(sale.quantity) || 0;
    }

    for (const expense of expenses) {
      const amount = Number(expense.amount) || 0;
      if (isQrMakingExpense(expense)) qrMakingExpenses += amount;
      else otherExpenses += amount;
    }

    // Blank QR batches are making cost, not general running expenses.
    const makingCost = soldMakingCost + qrMakingExpenses;

    return {
      revenue,
      makingCost,
      soldMakingCost,
      qrMakingExpenses,
      expenseTotal: otherExpenses,
      pending,
      unitsPaid,
      profit: revenue - makingCost - otherExpenses,
    };
  }

  async function loadMoneyData() {
    try {
      const [saleRows, expenseRows] = await Promise.all([
        DatabaseService.getSales(),
        DatabaseService.getExpenses(),
      ]);
      sales = saleRows;
      expenses = expenseRows;
    } catch (error) {
      sales = [];
      expenses = [];
      if (!(error instanceof MissingTableError)) {
        console.error('Unable to load sales/expenses:', error);
      }
    }

    populateSaleBusinessSelect();
    renderMoney();
    // Sales drive the Paid / Not paid badge on each business card.
    renderBusinessesList(searchBizInput?.value || '');
  }

  function renderMoney() {
    const totals = moneyTotals();

    if (statRevenue) statRevenue.textContent = formatMoney(totals.revenue);
    if (statMakingCost) statMakingCost.textContent = formatMoney(totals.makingCost);
    if (statExpenses) statExpenses.textContent = formatMoney(totals.expenseTotal);
    if (statProfit) statProfit.textContent = formatMoney(totals.profit);
    if (statUnits) statUnits.textContent = String(totals.unitsPaid);
    if (statPending) statPending.textContent = formatMoney(totals.pending);
    statProfit?.parentElement?.classList.toggle('is-negative', totals.profit < 0);

    renderSales();
    renderExpenses();
    renderMoneyChart();
  }

  function renderSales() {
    if (!salesList) return;
    const filter = salesFilter?.value || 'all';
    const visible = filter === 'all' ? sales : sales.filter(sale => sale.status === filter);

    if (salesCountBadge) salesCountBadge.textContent = String(sales.length);

    if (visible.length === 0) {
      salesList.innerHTML = `<div class="money-empty">${sales.length === 0 ? 'No sales recorded yet.' : 'No sales match this filter.'}</div>`;
      return;
    }

    salesList.innerHTML = visible.map(sale => {
      const amount = Number(sale.amount) || 0;
      const cost = Number(sale.cost) || 0;
      const profit = amount - cost;
      const paid = sale.status === 'paid';
      const name = sale.business_name || 'Walk-in customer';
      return `
        <div class="money-row">
          <div class="money-row-main">
            <div class="money-row-title">
              ${escapeHtml(name)}
              <span class="money-status-pill ${paid ? 'is-paid' : 'is-pending'}">${paid ? 'Paid' : 'Pending'}</span>
            </div>
            <div class="money-row-meta">
              ${Number(sale.quantity) || 0} QR × ${formatMoney(Number(sale.unit_price) || 0)} ·
              ${formatShortDate(sale.sale_date)}
            </div>
            ${sale.note ? `<div class="money-row-note">${escapeHtml(sale.note)}</div>` : ''}
          </div>
          <div class="money-row-amount">
            <span class="money-row-total">${formatMoney(amount)}</span>
            <span class="money-row-profit ${profit >= 0 ? 'is-up' : 'is-down'}">
              ${paid ? `Profit ${formatMoney(profit)}` : 'Not collected'}
            </span>
          </div>
          <div class="money-row-actions">
            <button type="button" class="btn btn-outline" data-sale-edit="${sale.id}">Edit</button>
            <button type="button" class="btn btn-outline" data-sale-delete="${sale.id}">Delete</button>
          </div>
        </div>`;
    }).join('');

    salesList.querySelectorAll<HTMLElement>('[data-sale-edit]').forEach(button => {
      button.addEventListener('click', () => {
