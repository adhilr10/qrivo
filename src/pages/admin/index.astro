  confirmAssignQrBtn?.addEventListener('click', () => { void confirmAssignQr(); });

  // ── QR scanner (assign a printed stand from the business form) ──────────
  function extractShortCode(value: string): string {
    const raw = (value || '').trim();
    if (!raw) return '';
    const pathMatch = raw.match(/\/s\/([a-z0-9]{4,12})(?:[?#/]|$)/i);
    if (pathMatch) return pathMatch[1].toLowerCase();
    if (/^[a-z0-9]{4,12}$/i.test(raw)) return raw.toLowerCase();
    return '';
  }

  function setScanStatus(text: string) {
    if (qrScanStatus) qrScanStatus.textContent = text;
  }

  async function startScanner() {
    if (!qrScanVideo) return;
    scanBusy = false;
    if (qrScanResult) { qrScanResult.hidden = true; qrScanResult.innerHTML = ''; }
    setScanStatus('Requesting camera…');

    try {
      if (!qrScanner) {
        qrScanner = new QrScanner(
          qrScanVideo,
          result => { void handleScanResult(result.data); },
          {
            returnDetailedScanResult: true,
            preferredCamera: 'environment',
            highlightScanRegion: false,
            highlightCodeOutline: false,
            maxScansPerSecond: 6,
            onDecodeError: () => {},
          },
        );
      }
      await qrScanner.start();
      setScanStatus('Point the camera at the QR code printed on the stand.');
    } catch {
      setScanStatus('Camera unavailable — type the code below instead.');
    }
  }

  function stopScanner() {
    try { qrScanner?.stop(); } catch { /* the camera may already be closed */ }
    scanBusy = false;
  }

  async function handleScanResult(text: string) {
    if (scanBusy) return;
    const code = extractShortCode(text);
    if (!code) {
      setScanStatus('That QR is not a Qrivo stand. Try another.');
      return;
    }
    scanBusy = true;
    try { await qrScanner?.pause(); } catch { /* ignore */ }
    setScanStatus('Code found — checking stock…');
    await showScanResult(code);
    scanBusy = false;
  }

  async function showScanResult(code: string) {
    if (!qrScanResult) return;

    let link: (ShortLink & { business: Business | null }) | null = null;
    try {
      link = await DatabaseService.lookupShortLink(code);
    } catch {
      link = null;
    }

    const assignedName = link?.business?.name || '';
    let html = `<span class="qr-scan-result-code">/s/${code}</span>`;

    if (!link) {
      html += 'This code is not in your QR stock yet. Create it in <strong>Bulk QR Stands</strong> before printing.';
      setScanStatus('Code not found.');
    } else if (assignedName) {
      html += `Already in use by <strong>${assignedName}</strong>. Choosing it here moves the stand to this business.`;
      setScanStatus('Code found — already assigned.');
    } else {
      html += `Blank stand from stock${link.last_label ? ` (${link.last_label})` : ''}. Ready to assign.`;
      setScanStatus('Code found — ready to assign.');
    }

    const actions = link
      ? `<div class="qr-scan-result-actions">
           <button type="button" class="btn btn-primary btn-sm" data-scan-use>Use /s/${code}</button>
           <button type="button" class="btn btn-outline btn-sm" data-scan-again>Scan again</button>
         </div>`
      : `<div class="qr-scan-result-actions">
           <button type="button" class="btn btn-outline btn-sm" data-scan-again>Scan again</button>
         </div>`;

    qrScanResult.innerHTML = html + actions;
    qrScanResult.hidden = false;

    qrScanResult.querySelector('[data-scan-use]')?.addEventListener('click', () => {
      applyScannedCode(code, assignedName);
    });
    qrScanResult.querySelector('[data-scan-again]')?.addEventListener('click', () => { void startScanner(); });
  }

  function applyScannedCode(code: string, assignedName = '') {
    if (!formQrCode) return;
    const exists = Array.from(formQrCode.options).some(option => option.value === code);
    if (!exists) {
      const option = document.createElement('option');
      option.value = code;
      option.textContent = assignedName
        ? `/s/${code} — currently ${assignedName}`
        : `/s/${code} — scanned stand`;
      formQrCode.appendChild(option);
    }
    formQrCode.value = code;
    updateQrFormBanner();
    closeQrScanModal();
  }

  function openQrScanModal() {
    if (!qrScanModal) return;
    if (qrScanResult) { qrScanResult.hidden = true; qrScanResult.innerHTML = ''; }
    if (qrScanManualInput) qrScanManualInput.value = '';
    qrScanModal.style.display = 'flex';
    void startScanner();
  }

  function closeQrScanModal() {
    stopScanner();
    if (qrScanModal) qrScanModal.style.display = 'none';
  }

  openQrScanBtn?.addEventListener('click', openQrScanModal);
  closeQrScanBtn?.addEventListener('click', closeQrScanModal);
  qrScanModal?.addEventListener('click', e => { if (e.target === qrScanModal) closeQrScanModal(); });

  qrScanManualBtn?.addEventListener('click', () => {
    const code = extractShortCode(qrScanManualInput?.value || '');
    if (!code) {
      setScanStatus('That is not a Qrivo code. Try something like /s/abc123.');
      return;
