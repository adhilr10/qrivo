---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Qrivo Admin | Manage Businesses & Counter QR Codes" hideNav={false}>
  <div class="admin-page-container">

    <!-- ======================================================================
         TOP HEADER (collapses on mobile to just title + action row)
         ====================================================================== -->
    <div class="admin-header no-print">
      <div class="container">
        <!-- Row 1: title + status + sign-out -->
        <div class="admin-header-top">
          <div class="admin-header-title-group">
            <h1 class="admin-header-title">Admin Portal</h1>
            <span id="backendStatusPill" class="status-pill local">
              <span class="status-dot"></span>
              <span id="backendStatusText">Checking…</span>
            </span>
          </div>
          <div class="admin-header-actions">
            <span id="adminUserEmail" class="admin-user-email"></span>
            <button id="supabaseSetupModalBtn" class="btn btn-outline btn-sm" title="Supabase SQL">
              <Icon name="settings" size={15} />
              <span class="hide-xs">SQL</span>
            </button>
            <button id="signOutBtn" class="btn btn-outline btn-sm">
              <span>Sign out</span>
            </button>
            <button id="openNewBizBtn" class="btn btn-primary btn-sm">
              <Icon name="plus" size={16} />
              <span>Add</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         DESKTOP TABS (hidden on mobile – replaced by bottom bar)
         ====================================================================== -->
    <div class="container">
      <div class="admin-tabs no-print desktop-tabs">
        <button class="tab-btn active" data-tab="businessesTab">
          <Icon name="shield-check" size={17} />
          <span>Businesses (<span id="bizCountBadge">0</span>)</span>
        </button>
        <button class="tab-btn" data-tab="qrStudioTab">
          <Icon name="qrcode" size={17} />
          <span>QR Codes</span>
        </button>
      </div>
    </div>

    <!-- ======================================================================
         MAIN CONTENT AREA
         ====================================================================== -->
    <div class="container tab-container">

      <!-- ── TAB 1: BUSINESSES ─────────────────────────────────────────── -->
      <div id="businessesTab" class="tab-content">

        <!-- Search bar -->
        <div class="search-bar-row">
          <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              id="searchBizInput"
              placeholder="Search businesses…"
              class="form-input search-input"
            />
          </div>
          <div class="search-tip hide-sm">
            💡 <em>Printed /s/ links never change — reassign after rejection, no reprint.</em>
          </div>
        </div>

        <!-- Business cards grid -->
        <div class="business-list-grid" id="businessListContainer">
          <div class="loading-placeholder">Loading businesses…</div>
        </div>
      </div>

      <!-- ── TAB 2: QR CODES (STOCK + STUDIO) ──────────────────────────── -->
      <div id="qrStudioTab" class="tab-content" style="display:none;">

        <!-- Bulk blank stock: print first, assign to a business later -->
        <div class="glass-card qr-stock-panel">
          <div class="qr-stock-head">
            <div class="qr-stock-heading">
              <h2 class="section-title" style="margin-bottom:.15rem;">Bulk QR Stands — Blank Stock</h2>
              <p class="section-desc" style="margin-bottom:0;">
                Print QR codes before a business signs up. Each code is permanent, so a stand can be
                reassigned when a shop says no — no reprint.
              </p>
            </div>
            <span class="qr-stock-badge" id="qrStockCountBadge">0 in stock</span>
          </div>

          <div class="qr-bulk-row">
            <div class="form-group">
              <label class="form-label" for="qrBulkCount">How many codes?</label>
              <input type="number" id="qrBulkCount" class="form-input" min="1" max="200" step="1" value="10" />
            </div>
            <div class="form-group">
              <label class="form-label" for="qrBulkLabel">Batch label (optional)</label>
              <input type="text" id="qrBulkLabel" class="form-input" placeholder="e.g. October batch A" />
            </div>
            <button type="button" id="qrBulkCreateBtn" class="btn btn-primary qr-bulk-submit">
              <Icon name="plus" size={16} />
              <span>Create QR codes</span>
            </button>
          </div>

          <div id="qrBulkResult" class="qr-bulk-result" hidden></div>

          <div class="qr-stock-toolbar">
            <span class="qr-stock-toolbar-label">Unassigned stands</span>
            <div class="qr-stock-toolbar-actions">
              <button type="button" id="qrStockDownloadAllBtn" class="btn btn-secondary btn-sm">
                <Icon name="download" size={14} />
                <span>Download all (ZIP)</span>
              </button>
              <button type="button" id="qrStockRefreshBtn" class="btn btn-outline btn-sm">Refresh</button>
            </div>
          </div>

          <div id="qrStockList" class="qr-stock-list">
            <div class="qr-stock-empty">Loading QR stock…</div>
          </div>
        </div>

        <div class="qr-studio-grid">

          <!-- Left panel -->
          <div class="glass-card qr-panel">
            <h2 class="section-title" style="margin-bottom:.25rem;">Dynamic QR Studio</h2>
            <p class="section-desc">Branded counter cards with the QR printed on the Qrivo board, plus raw SVG. Always encodes the permanent <code>/s/xxxxxx</code> link.</p>

            <div class="form-group" style="margin-bottom:1.25rem;">
              <label class="form-label" for="qrBizSelect">Business Destination</label>
              <select id="qrBizSelect" class="form-select"></select>
            </div>

            <div class="form-group" style="margin-bottom:1.25rem;">
              <label class="form-label">Encoded URL</label>
              <div style="display:flex;gap:.5rem;">
                <input type="text" id="qrEncodedUrlInput" class="form-input" readonly />
                <button type="button" id="copyQrUrlBtn" class="btn btn-secondary btn-sm" title="Copy">
                  <Icon name="copy" size={16} />
                </button>
              </div>
              <span class="form-helper">Permanent shortener link encoded in the QR matrix.</span>
            </div>

            <div class="form-group" style="margin-bottom:1.5rem;">
              <label class="form-label">QR Color</label>
              <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
                <input type="color" id="qrColorPicker" value="#000000" class="color-input" />
                <button type="button" class="btn btn-outline btn-sm" id="qrMatchBrandBtn">Match Brand</button>
                <button type="button" class="btn btn-outline btn-sm" id="qrResetBlackBtn">Classic Black</button>
              </div>
            </div>

            <div class="qr-action-stack">
              <button type="button" id="downloadPngBtn" class="btn btn-primary" style="width:100%;">
                <Icon name="download" size={18} />
                <span>Download Card (1050×1500)</span>
              </button>
              <button type="button" id="downloadSvgBtn" class="btn btn-secondary" style="width:100%;">
                <Icon name="download" size={18} />
                <span>Download SVG (Vector)</span>
              </button>
              <button type="button" id="openPrintCardBtn" class="btn btn-outline" style="width:100%;border-color:#6366f1;color:#a5b4fc;">
                🖨️ Print Counter Tent Stand
              </button>
            </div>
          </div>

          <!-- Right: live QR preview -->
          <div class="glass-card qr-preview-panel">
            <div class="qr-preview-label">Live QR Preview</div>
            <div class="qr-preview-frame">
              <div id="qrPreviewContainer" class="qr-preview-inner"></div>
            </div>
            <div id="qrPreviewBizName" class="qr-biz-name">Select a business</div>
            <div id="qrPreviewTagline" class="qr-biz-tag">Point phone camera to test</div>
          </div>

        </div>
      </div>

    </div><!-- /.container -->

    <!-- ======================================================================
         MOBILE BOTTOM TAB BAR (visible only on mobile)
         ====================================================================== -->
    <nav class="mobile-bottom-bar no-print" aria-label="Admin navigation">
      <button class="mobile-tab-btn active" data-tab="businessesTab">
        <span class="mobile-tab-icon">🏢</span>
        <span class="mobile-tab-label">Shops</span>
        <span class="mobile-tab-badge" id="mobileBizBadge">0</span>
      </button>
      <button class="mobile-tab-btn" data-tab="qrStudioTab">
        <span class="mobile-tab-icon">⬛</span>
        <span class="mobile-tab-label">QR Codes</span>
      </button>
      <button class="mobile-tab-btn" id="mobileAddBizBtn">
        <span class="mobile-tab-icon">➕</span>
        <span class="mobile-tab-label">Add Shop</span>
      </button>
    </nav>

    <!-- ======================================================================
         MODAL: CREATE / EDIT BUSINESS
         ====================================================================== -->
    <div id="bizModal" class="modal-backdrop" style="display:none;">
      <div class="modal-dialog">
        <div class="modal-header">
          <h2 id="modalTitle" class="modal-title">Create Business</h2>
          <button type="button" id="closeModalBtn" class="modal-close-btn">&times;</button>
        </div>

        <div class="modal-body-split">
          <!-- Form -->
          <form id="bizForm" class="biz-form">
            <input type="hidden" id="formBizId" />

            <div class="form-group">
              <label class="form-label" for="formName">Business Name *</label>
              <input type="text" id="formName" class="form-input" placeholder="e.g. Bella Italia Trattoria" required />
            </div>

            <div class="form-group">
              <label class="form-label" for="formSlug">
                <span>Counter URL Slug *</span>
                <span id="slugAvailabilityBadge" style="font-size:.75rem;color:#34d399;">Available</span>
              </label>
              <div style="display:flex;align-items:center;">
                <span class="slug-prefix">/</span>
                <input type="text" id="formSlug" class="form-input slug-input" placeholder="bella-italia" required />
              </div>
              <span class="form-helper">Printed QR codes use the shortener link below, not this slug.</span>
            </div>

            <div class="form-group" id="qrAssignGroup">
              <label class="form-label" for="formQrCode">
                <span>Counter QR Stand</span>
                <button type="button" id="openQrScanBtn" class="gl-label-btn">📷 Scan QR</button>
              </label>
              <select id="formQrCode" class="form-select"></select>
              <span class="form-helper" id="formQrHelper">
                Pick a blank QR from stock, or leave empty and assign one later from QR Codes.
              </span>
              <div id="formQrBanner" class="qr-form-banner" hidden></div>
            </div>

            <div id="reassignSlugNotice" class="notice-banner" style="display:none;">
              ♻️ <strong>QR stays valid:</strong> Changing the slug or links never requires a reprint.
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formLogoUrl">Logo URL</label>
                <input type="url" id="formLogoUrl" class="form-input" placeholder="Optional — default logo used" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formBrandColor">Brand Color</label>
                <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
                  <input type="color" id="formBrandColor" value="#2563eb" class="color-input" />
                  <input type="text" id="formBrandColorText" class="form-input" value="#2563eb" style="width:100px;flex:0 1 100px;" />
                  <div style="display:flex;gap:4px;">
                    <button type="button" class="color-preset-dot" data-color="#2563eb" style="background:#2563eb;"></button>
                    <button type="button" class="color-preset-dot" data-color="#d97706" style="background:#d97706;"></button>
                    <button type="button" class="color-preset-dot" data-color="#059669" style="background:#059669;"></button>
                    <button type="button" class="color-preset-dot" data-color="#dc2626" style="background:#dc2626;"></button>
                    <button type="button" class="color-preset-dot" data-color="#7c3aed" style="background:#7c3aed;"></button>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formTagline">Short Tagline</label>
              <input type="text" id="formTagline" class="form-input" placeholder="e.g. Wood-fired pizza & handcrafted pasta" />
            </div>

            <div class="form-group">
              <label class="form-label" for="formGoogleUrl">
                <span>Google Review Link *</span>
                <button type="button" id="openGoogleLinkBtn" class="gl-label-btn">
                  🔍 Find my link
                </button>
              </label>
              <input type="url" id="formGoogleUrl" class="form-input" placeholder="https://search.google.com/local/writereview?placeid=…" required />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formWaNumber">WhatsApp Number</label>
                <input type="text" id="formWaNumber" class="form-input" value="91" placeholder="91XXXXXXXXXX" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formPhone">Phone Number</label>
                <input type="text" id="formPhone" class="form-input" value="91" placeholder="91XXXXXXXXXX" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formWaMessage">WhatsApp Greeting</label>
              <input type="text" id="formWaMessage" class="form-input" placeholder="Hi" />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formInsta">Instagram Username</label>
                <input type="text" id="formInsta" class="form-input" placeholder="username" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formFb">Facebook Username</label>
                <input type="text" id="formFb" class="form-input" placeholder="username" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formCustomMsg">Custom Thank-You Message</label>
              <textarea id="formCustomMsg" class="form-textarea" rows="2" placeholder="Thank you for supporting our local team!"></textarea>
            </div>

            <div class="active-toggle-row">
              <div>
                <div class="active-toggle-title">Active Counter Stand</div>
                <div class="active-toggle-desc">Inactive stands show a friendly pause notice.</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="formIsActive" checked />
                <span class="slider round"></span>
              </label>
            </div>

            <div class="form-actions">
              <button type="button" id="cancelFormBtn" class="btn btn-secondary">Cancel</button>
              <button type="submit" id="saveBizSubmitBtn" class="btn btn-primary">
                <Icon name="check" size={16} />
                <span>Save Business</span>
              </button>
            </div>
          </form>

          <!-- Phone mockup (hidden on mobile) -->
          <div class="phone-mockup-wrapper">
            <div class="phone-mockup-label">Live Preview</div>
            <div class="smartphone-frame" id="livePhoneMockup">
              <div class="smartphone-screen" id="previewScreen">
                <div class="preview-logo-wrap">
                  <img id="prevImg" src="" class="preview-logo-img" />
                </div>
                <div id="prevName" style="font-size:1.1rem;font-weight:800;color:#0a0a0a;">Business Name</div>
                <div id="prevTagline" style="font-size:.75rem;color:#4a4a4a;margin-bottom:.75rem;">Tagline</div>
                <div style="background:#fff8e7;border:2px solid #0a0a0a;border-radius:6px;padding:.5rem;margin-bottom:.6rem;">
                  <div style="display:flex;align-items:center;justify-content:center;gap:.3rem;font-size:.7rem;color:#0a0a0a;font-weight:700;margin-bottom:.2rem;"><span style="color:#4285f4;font-weight:900;">G</span>How was your experience today?</div>
                  <div style="color:#0a0a0a;font-size:1rem;letter-spacing:2px;">★★★★★</div>
                </div>
                <div id="prevWa" style="display:none;background:#25d366;color:#fff;border:2px solid #0a0a0a;border-radius:6px;padding:.5rem;font-size:.78rem;font-weight:700;margin-bottom:.6rem;box-shadow:2px 2px 0 #0a0a0a;">Chat on WhatsApp</div>
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:3px;margin-bottom:.6rem;">
                  <div style="background:#fffdf5;border:1.5px solid #0a0a0a;padding:5px 2px;border-radius:4px;font-size:.58rem;color:#0a0a0a;font-weight:700;">Call</div>
                  <div style="background:#fffdf5;border:1.5px solid #0a0a0a;padding:5px 2px;border-radius:4px;font-size:.58rem;color:#0a0a0a;font-weight:700;">WA</div>
                  <div style="background:#fffdf5;border:1.5px solid #0a0a0a;padding:5px 2px;border-radius:4px;font-size:.58rem;color:#0a0a0a;font-weight:700;">Insta</div>
                  <div style="background:#fffdf5;border:1.5px solid #0a0a0a;padding:5px 2px;border-radius:4px;font-size:.58rem;color:#0a0a0a;font-weight:700;">FB</div>
                </div>
                <div id="prevMsg" style="font-size:.62rem;color:#6b7280;line-height:1.3;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         MODAL: GOOGLE REVIEW LINK GENERATOR
         Embeds productmate.com's generator (allows framing) and adds a
         native place-ID builder + "paste & use" bar wired to #formGoogleUrl.
         ====================================================================== -->
    <div id="googleLinkModal" class="modal-backdrop" style="display:none;">
      <div class="modal-dialog gl-dialog">
        <div class="modal-header">
          <h2 class="modal-title gl-title">
            <span class="gl-g">G</span>
            <span>Google Review Link Generator</span>
          </h2>
          <button type="button" id="closeGoogleLinkBtn" class="modal-close-btn">&times;</button>
        </div>

        <div class="gl-body">
          <div class="gl-steps">
            <span class="gl-step">1 · Paste a Google Maps link</span>
            <span class="gl-step">2 · Get the review link</span>
            <span class="gl-step">3 · Click Use this link</span>
          </div>

          <div class="gl-quick">
            <label class="gl-quick-label" for="glPlaceIdInput">
              Fastest — paste the business's Google Maps link (or its Place ID)
            </label>
            <div class="gl-quick-row">
              <input
                type="text"
                id="glPlaceIdInput"
                class="form-input"
                placeholder="https://maps.app.goo.gl/… or ChIJ…"
                autocomplete="off"
              />
              <button type="button" id="glBuildBtn" class="btn btn-secondary btn-sm">Get link</button>
            </div>
            <div id="glBuiltError" class="gl-error" hidden></div>
            <div id="glBuiltPreview" class="gl-preview" hidden>
              <div class="gl-preview-label">Direct review link</div>
              <code id="glBuiltUrl"></code>
              <div id="glBuiltPlaceIdRow" class="gl-place-id" hidden>
                Place ID: <code id="glBuiltPlaceId"></code>
              </div>
              <div class="gl-manual-actions">
                <button type="button" id="glCopyBuiltBtn" class="btn btn-outline btn-sm">Copy link</button>
                <button type="button" id="glUseBuiltBtn" class="btn btn-primary btn-sm">Use this link</button>
              </div>
            </div>
          </div>

          <div class="gl-toolbar">
            <a class="btn btn-outline btn-sm" href="https://productmate.com/google-review-link-generator" target="_blank" rel="noopener noreferrer">
              <Icon name="external-link" size={14} />
              <span>Open generator in new tab</span>
            </a>
            <a class="btn btn-outline btn-sm" href="https://www.google.com/maps/search/" target="_blank" rel="noopener noreferrer">
              <Icon name="google" size={14} />
              <span>Find on Google Maps</span>
            </a>
          </div>

          <div class="gl-frame-label">Or search by name in the generator</div>

          <div class="gl-frame-wrap">
            <div id="glFrameLoading" class="gl-frame-loading">Loading generator…</div>
            <iframe
              id="glFrame"
              class="gl-frame"
              title="Google Review Link Generator"
              data-src="https://productmate.com/google-review-link-generator"
              allow="clipboard-write; clipboard-read"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <div class="gl-footer">
          <input
            type="url"
            id="glPasteInput"
            class="form-input gl-paste-input"
            placeholder="Paste the review link here…"
          />
          <button type="button" id="glUsePasteBtn" class="btn btn-primary">Use link</button>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         MODAL: QR SCANNER
         Reads the printed stand's /s/<code> link and assigns that exact
         permanent code to the business being created or edited.
         ====================================================================== -->
    <div id="qrScanModal" class="modal-backdrop" style="display:none;">
      <div class="modal-dialog qr-scan-dialog">
        <div class="modal-header">
          <h2 class="modal-title">📷 Scan QR Stand</h2>
          <button type="button" id="closeQrScanBtn" class="modal-close-btn">&times;</button>
        </div>

        <div class="qr-scan-body">
          <p class="qr-scan-help">
            Point the camera at the QR printed on the counter stand. The permanent
            <code>/s/…</code> code is read from the link, so the same physical card can be
            reassigned any time.
          </p>

          <div class="qr-scan-video-wrap">
            <video id="qrScanVideo" playsinline muted></video>
            <div class="qr-scan-frame" aria-hidden="true"></div>
          </div>

          <div id="qrScanStatus" class="qr-scan-status">Camera is off.</div>

          <div id="qrScanResult" class="qr-scan-result" hidden></div>

          <div class="qr-scan-manual">
            <input
              type="text"
              id="qrScanManualInput"
              class="form-input"
              placeholder="Or type the code — /s/abc123"
              autocomplete="off"
            />
            <button type="button" id="qrScanManualBtn" class="btn btn-secondary btn-sm">Check code</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         MODAL: ASSIGN A STOCK QR TO A BUSINESS
         ====================================================================== -->
    <div id="assignQrModal" class="modal-backdrop" style="display:none;">
      <div class="modal-dialog assign-dialog">
        <div class="modal-header">
          <h2 class="modal-title">Assign QR to a business</h2>
          <button type="button" id="closeAssignQrBtn" class="modal-close-btn">&times;</button>
        </div>

        <div class="assign-body">
          <div id="assignQrPreview" class="assign-qr-preview"></div>

          <div class="form-group">
            <label class="form-label" for="assignBizSelect">Business</label>
            <select id="assignBizSelect" class="form-select"></select>
            <span class="form-helper">Businesses without a QR are listed first. Assigning moves the stand.</span>
          </div>

          <div class="assign-actions">
            <button type="button" id="cancelAssignQrBtn" class="btn btn-secondary">Cancel</button>
            <button type="button" id="confirmAssignQrBtn" class="btn btn-primary">Assign QR</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         MODAL: SUPABASE SQL VIEWER
         ====================================================================== -->
    <div id="supabaseModal" class="modal-backdrop" style="display:none;">
      <div class="modal-dialog" style="max-width:720px;">
        <div class="modal-header">
          <h2 class="modal-title">⚡ Supabase Backend Setup</h2>
          <button type="button" id="closeSupabaseModalBtn" class="modal-close-btn">&times;</button>
        </div>
        <div style="padding:1.5rem;">
          <p style="font-size:.875rem;color:var(--text-muted);line-height:1.5;margin-bottom:1.25rem;">
            Paste this SQL directly into your <strong>Supabase SQL Editor</strong> to create all tables, indexes, and Row Level Security policies.
            It is safe to re-run, and it fixes admins not seeing businesses created by another admin.
          </p>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;">
            <span style="font-size:.8125rem;font-weight:600;color:#d1d5db;">supabase/schema.sql</span>
            <button type="button" id="copySqlBtn" class="btn btn-outline btn-sm">
              <Icon name="copy" size={14} />
              <span id="copySqlBtnText">Copy SQL</span>
            </button>
          </div>
          <textarea id="sqlCodeTextarea" readonly rows="12" class="sql-textarea">-- Qrivo Supabase Schema
-- Run this in your Supabase project's SQL editor

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

CREATE TABLE IF NOT EXISTS public.businesses (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    logo_url TEXT DEFAULT '',
    brand_color VARCHAR(20) DEFAULT '#2563eb',
    tagline VARCHAR(255) DEFAULT '',
    google_review_url TEXT NOT NULL,
    whatsapp_number VARCHAR(50) DEFAULT '',
    whatsapp_message TEXT DEFAULT '',
    phone_number VARCHAR(50) DEFAULT '',
    instagram_url TEXT DEFAULT '',
    facebook_url TEXT DEFAULT '',
    custom_message TEXT DEFAULT '',
    is_active BOOLEAN DEFAULT true NOT NULL,
    user_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
    owner_email TEXT DEFAULT '',
    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL
);

ALTER TABLE public.businesses
    ADD COLUMN IF NOT EXISTS whatsapp_message TEXT DEFAULT '',
    ADD COLUMN IF NOT EXISTS custom_message TEXT DEFAULT '',
    ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
    ADD COLUMN IF NOT EXISTS owner_email TEXT DEFAULT '';

CREATE TABLE IF NOT EXISTS public.short_links (
    code VARCHAR(12) PRIMARY KEY,
    business_id UUID REFERENCES public.businesses(id) ON DELETE SET NULL,
    last_label TEXT DEFAULT '',
    created_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT timezone('utc'::text, now()) NOT NULL
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_short_links_business_id
    ON public.short_links (business_id) WHERE business_id IS NOT NULL;

-- Row Level Security
ALTER TABLE public.businesses ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.short_links ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "Public can view businesses by slug" ON public.businesses;
CREATE POLICY "Public can view businesses by slug" ON public.businesses FOR SELECT TO anon, authenticated USING (true);

-- Shared admin workspace: any signed-in admin sees/manages every business,
-- not just the rows they created.
DROP POLICY IF EXISTS "Admins manage businesses" ON public.businesses;
CREATE POLICY "Admins manage businesses" ON public.businesses FOR ALL TO authenticated
  USING (true)
  WITH CHECK (true);

DROP POLICY IF EXISTS "Public can resolve short links" ON public.short_links;
CREATE POLICY "Public can resolve short links" ON public.short_links FOR SELECT TO anon, authenticated USING (true);
DROP POLICY IF EXISTS "Admins manage short links" ON public.short_links;
CREATE POLICY "Admins manage short links" ON public.short_links FOR ALL TO authenticated USING (true) WITH CHECK (true);
