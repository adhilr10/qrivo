  // Init
  async function loadData() {
    if (!supabase) {
      window.location.replace('/admin/login');
      return;
    }

    const { data: authData, error: authError } = await supabase.auth.getUser();
    if (authError || !authData.user) {
      window.location.replace('/admin/login');
      return;
    }
    if (adminUserEmail) adminUserEmail.textContent = authData.user.email || 'Signed in';

    const config = getSupabaseConfig();
    if (backendStatusPill && backendStatusText) {
      if (config.isConfigured) {
        backendStatusPill.className = 'status-pill online';
        backendStatusText.textContent = 'Supabase Connected';
      } else {
        backendStatusPill.className = 'status-pill local';
        backendStatusText.textContent = 'Supabase configuration required';
      }
    }

    try {
      businesses = await DatabaseService.getBusinesses();
      businesses = await DatabaseService.ensureShortLinks(businesses);
      try {
        unassignedShortLinks = await DatabaseService.getUnassignedShortLinks();
      } catch (shortLinkError) {
        console.warn('Unable to load unassigned short links:', shortLinkError);
        unassignedShortLinks = [];
      }
    } catch (error) {
      console.error('Unable to load businesses from Supabase:', error);
      if (backendStatusPill && backendStatusText) {
        backendStatusPill.className = 'status-pill local';
        backendStatusText.textContent = 'Supabase unavailable';
      }
      if (businessListContainer) {
        businessListContainer.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--text-muted);">Unable to load Supabase data. Confirm the environment variables and database schema, then refresh.</div>`;
      }
      return;
    }
    if (bizCountBadge) bizCountBadge.textContent = String(businesses.length);
    renderBusinessesList();
    populateQrStudio();
    renderAnalytics();
  }

  // Render business cards
  function renderBusinessesList(filter = '') {
    if (!businessListContainer) return;
    const query = filter.toLowerCase().trim();
    const filtered = businesses.filter(
      (b) =>
        b.name.toLowerCase().includes(query) ||
        b.slug.toLowerCase().includes(query) ||
        (b.short_code || '').toLowerCase().includes(query)
    );

    if (filtered.length === 0) {
      businessListContainer.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
          <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🏢</div>
          <div style="font-size: 1.125rem; font-weight: 600; color: #ffffff;">No businesses found</div>
          <p style="font-size: 0.875rem; margin-top: 0.25rem;">Try adjusting your search or add a new business.</p>
        </div>
      `;
      return;
    }

    businessListContainer.innerHTML = filtered
      .map((b) => {
        const fullUrl = qrUrlFor(b);
        const shortPath = b.short_code ? `/s/${b.short_code}` : `/${b.slug}`;
        return `
          <div class="biz-card-item" style="--card-brand: ${b.brand_color};">
            <div>
              <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.875rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <img
                    src="${b.logo_url || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=120&auto=format&fit=crop&q=80'}"
                    alt="${b.name}"
                    style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid ${b.brand_color};"
                  />
                  <div>
                    <h3 style="font-size: 1.0625rem; font-weight: 700; color: #ffffff; line-height: 1.2;">
                      ${b.name}
                    </h3>
                    <div style="display: flex; flex-direction: column; gap: 0.15rem; margin-top: 0.2rem;">
                      <a href="${shortPath}" target="_blank" style="font-size: 0.75rem; color: #34d399; font-family: monospace;" title="Permanent QR short link">
                        ${shortPath} ↗
                      </a>
                      <a href="/${b.slug}" target="_blank" style="font-size: 0.7rem; color: #818cf8; font-family: monospace;" title="Current business landing page">
                        /${b.slug}
                      </a>
                    </div>
                  </div>
                </div>

                <span class="status-pill ${b.is_active ? 'online' : 'local'}" style="font-size: 0.7rem;">
                  ${b.is_active ? 'Active' : 'Inactive'}
                </span>
              </div>

              <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.4; margin-bottom: 1rem; min-height: 2.4em;">
                ${b.tagline || 'Specialty Local Service'}
              </p>

              <!-- Quick action links preview -->
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; font-size: 0.75rem;">
                <span style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.5rem; border-radius: 4px; color: #60a5fa;" title="Google Review Link">
                  ★ Google Linked
                </span>
                ${b.whatsapp_number ? `<span style="background: rgba(37,211,102,0.1); padding: 0.2rem 0.5rem; border-radius: 4px; color: #4ade80;">💬 WhatsApp</span>` : ''}
                ${b.phone_number ? `<span style="background: rgba(56,189,248,0.1); padding: 0.2rem 0.5rem; border-radius: 4px; color: #38bdf8;">📞 Phone</span>` : ''}
              </div>
            </div>

            <!-- Footer actions -->
            <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 0.875rem; gap: 0.5rem;">
              <button class="btn btn-outline btn-sm copy-slug-btn" data-url="${fullUrl}" title="Copy permanent QR short link">
                <span>📋 Copy QR Link</span>
              </button>

              <div style="display: flex; gap: 0.35rem;">
                <button class="btn btn-outline btn-sm open-qr-btn" data-id="${b.id}" title="Generate QR Code">
                  <span>QR Code</span>
                </button>
                <button class="btn btn-secondary btn-sm edit-biz-btn" data-id="${b.id}" title="Edit Business Details">
                  <span>Edit</span>
                </button>
                <button class="btn btn-danger btn-sm delete-biz-btn" data-id="${b.id}" data-name="${b.name}" title="Delete Business">
                  <span>✕</span>
                </button>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    // Attach event listeners to card buttons
    attachCardListeners();
  }

  function attachCardListeners() {
    // Copy link
    document.querySelectorAll('.copy-slug-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const url = target.dataset.url || '';
        navigator.clipboard.writeText(url);
        const originalText = target.innerHTML;
        target.innerHTML = '<span>✓ Copied!</span>';
        setTimeout(() => {
          target.innerHTML = originalText;
        }, 1500);
      });
    });

    // Edit business
    document.querySelectorAll('.edit-biz-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const biz = businesses.find((b) => b.id === id);
        if (biz) openEditModal(biz);
      });
    });

    // Open QR Studio for business
    document.querySelectorAll('.open-qr-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const biz = businesses.find((b) => b.id === id);
        if (biz) {
          switchTab('qrStudioTab');
          if (qrBizSelect) {
            qrBizSelect.value = biz.id;
            updateQrStudio(biz);
          }
        }
      });
    });

    // Delete business
    document.querySelectorAll('.delete-biz-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const name = target.dataset.name;
        if (!id) return;
        const confirmDelete = window.confirm(
          `Reject and remove "${name}"?\n\nThe printed QR short link will stay available so you can assign it to a new business. You will not need to reprint the counter card.`
        );
        if (confirmDelete) {
          try {
            await DatabaseService.deleteBusiness(id);
            await loadData();
          } catch (error) {
            console.error('Unable to delete business from Supabase:', error);
            alert(`Unable to delete from Supabase.\n\n${getSupabaseErrorMessage(error)}`);
          }
        }
      });
    });
  }

  // Switch tabs
  function switchTab(targetTabId: string) {
    activeTabName = targetTabId;
    tabButtons.forEach((btn) => {
      if (btn.getAttribute('data-tab') === targetTabId) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    tabContents.forEach((content) => {
      if (content.id === targetTabId) {
        (content as HTMLElement).style.display = 'block';
      } else {
        (content as HTMLElement).style.display = 'none';
      }
    });

    if (targetTabId === 'analyticsTab') {
      renderAnalytics();
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) switchTab(tabId);
    });
  });

  // Search input
  searchBizInput?.addEventListener('input', (e) => {
    renderBusinessesList((e.target as HTMLInputElement).value);
  });

  // Modal open / close
  function openCreateModal() {
    if (!bizModal) return;
    if (modalTitle) modalTitle.textContent = 'Add New Business & Counter Slug';
    formBizId.value = '';
    formName.value = '';
    formSlug.value = '';
    formLogoUrl.value = 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=200&auto=format&fit=crop&q=80';
    formBrandColor.value = '#2563eb';
    formBrandColorText.value = '#2563eb';
    formTagline.value = '';
    formGoogleUrl.value = '';
    formWaNumber.value = '';
    formWaMessage.value = 'Hi! I visited your counter and would like to chat.';
    formPhone.value = '';
    formInsta.value = '';
    formFb.value = '';
    formCustomMsg.value = 'Thank you for visiting! Your Google review helps our local team grow.';
    formIsActive.checked = true;
    if (reassignSlugNotice) reassignSlugNotice.style.display = 'none';
    if (shortLinkCreateGroup) shortLinkCreateGroup.style.display = 'block';
    if (shortLinkEditGroup) shortLinkEditGroup.style.display = 'none';
    if (formShortLinkDisplay) formShortLinkDisplay.value = '';
    if (formReuseShortCode) {
      formReuseShortCode.innerHTML = [
        '<option value="">Generate a new permanent short link</option>',
        ...unassignedShortLinks.map(
          (link) =>
            `<option value="${link.code}">Reuse /s/${link.code}${link.last_label ? ` — was ${link.last_label}` : ''}</option>`
        ),
      ].join('');
      formReuseShortCode.value = '';
    }

    syncPhonePreview();
    bizModal.style.display = 'flex';
  }

  function openEditModal(biz: Business) {
    if (!bizModal) return;
    if (modalTitle) modalTitle.textContent = `Edit Business (${biz.name})`;
    formBizId.value = biz.id;
    formName.value = biz.name;
    formSlug.value = biz.slug;
    formLogoUrl.value = biz.logo_url || '';
    formBrandColor.value = biz.brand_color || '#2563eb';
    formBrandColorText.value = biz.brand_color || '#2563eb';
    formTagline.value = biz.tagline || '';
    formGoogleUrl.value = biz.google_review_url || '';
    formWaNumber.value = biz.whatsapp_number || '';
    formWaMessage.value = biz.whatsapp_message || '';
    formPhone.value = biz.phone_number || '';
    formInsta.value = biz.instagram_url || '';
    formFb.value = biz.facebook_url || '';
    formCustomMsg.value = biz.custom_message || '';
    formIsActive.checked = biz.is_active;

    if (shortLinkCreateGroup) shortLinkCreateGroup.style.display = 'none';
    if (shortLinkEditGroup) shortLinkEditGroup.style.display = 'block';
    if (formShortLinkDisplay) {
      formShortLinkDisplay.value = biz.short_code
        ? shortLinkUrl(window.location.origin, biz.short_code)
        : 'Short link will be created on save';
    }

    // Show reassign notification banner
    if (reassignSlugNotice) reassignSlugNotice.style.display = 'block';

    syncPhonePreview();
    bizModal.style.display = 'flex';
  }

  function closeModal() {
    if (bizModal) bizModal.style.display = 'none';
  }

  openNewBizBtn?.addEventListener('click', openCreateModal);
  closeModalBtn?.addEventListener('click', closeModal);
  cancelFormBtn?.addEventListener('click', closeModal);

  // Auto slug generator from business name (only if slug not manually edited)
  formName?.addEventListener('input', () => {
    if (!formBizId.value) {
      const generated = formName.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      formSlug.value = generated;
    }
    syncPhonePreview();
  });

  // Color syncing
  formBrandColor?.addEventListener('input', () => {
    formBrandColorText.value = formBrandColor.value;
    syncPhonePreview();
  });

  formBrandColorText?.addEventListener('input', () => {
    if (/^#[0-9a-fA-F]{6}$/.test(formBrandColorText.value)) {
      formBrandColor.value = formBrandColorText.value;
      syncPhonePreview();
    }
  });

  document.querySelectorAll('.color-preset-dot').forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const col = (e.currentTarget as HTMLElement).dataset.color;
      if (col) {
        formBrandColor.value = col;
        formBrandColorText.value = col;
        syncPhonePreview();
      }
    });
  });

  // Form input listeners for live smartphone preview
  [
    formName,
    formSlug,
    formLogoUrl,
    formTagline,
    formCustomMsg,
    formWaNumber,
    formIsActive,
  ].forEach((input) => {
    input?.addEventListener('input', syncPhonePreview);
  });

  function syncPhonePreview() {
    const col = formBrandColor.value || '#2563eb';
    const name = formName.value || 'Business Name';
    const tagline = formTagline.value || 'Tagline appears here';
    const logo = formLogoUrl.value || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=200&auto=format&fit=crop&q=80';
    const msg = formCustomMsg.value;
    const hasWa = Boolean(formWaNumber.value);

    if (prevImg) prevImg.src = logo;
    if (prevName) prevName.textContent = name;
    if (prevTagline) prevTagline.textContent = tagline;
    if (prevWa) {
      prevWa.style.display = hasWa ? 'block' : 'none';
    }
    if (prevMsg) {
      prevMsg.textContent = msg || '';
    }

    const mockup = document.getElementById('livePhoneMockup');
    if (mockup) {
      mockup.style.setProperty('--brand', col);
    }
  }

  // Save form handler
  bizForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = formBizId.value || undefined;
    const name = formName.value.trim();
    const slug = formSlug.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');

    if (!name || !slug) {
      alert('Please provide both Business Name and URL Slug.');
      return;
    }
    if (RESERVED_SLUGS.has(slug)) {
      alert(`The slug "${slug}" is reserved. Please choose a different counter URL.`);
      return;
    }

    const payload: Partial<Business> & { name: string; slug: string } = {
      id,
      name,
      slug,
      short_code: id ? undefined : formReuseShortCode?.value || undefined,
      logo_url: formLogoUrl.value.trim(),
      brand_color: formBrandColor.value,
      tagline: formTagline.value.trim(),
      google_review_url: formGoogleUrl.value.trim(),
      whatsapp_number: formWaNumber.value.trim(),
      whatsapp_message: formWaMessage.value.trim(),
      phone_number: formPhone.value.trim(),
      instagram_url: formInsta.value.trim(),
      facebook_url: formFb.value.trim(),
      custom_message: formCustomMsg.value.trim(),
      is_active: formIsActive.checked,
    };

    try {
      await DatabaseService.saveBusiness(payload);
      closeModal();
      await loadData();
    } catch (error) {
      console.error('Unable to save business to Supabase:', error);
      alert(`Unable to save to Supabase.\n\n${getSupabaseErrorMessage(error)}`);
    }
  });

  // ============================================================================
  // QR Studio Functions
  // ============================================================================
  function populateQrStudio() {
    if (!qrBizSelect) return;
    qrBizSelect.innerHTML = businesses
      .map((b) => `<option value="${b.id}">${b.name} (${b.short_code ? `/s/${b.short_code}` : `/${b.slug}`})</option>`)
      .join('');

    if (businesses.length > 0) {
      const selectedId = qrBizSelect.value || businesses[0].id;
      const b = businesses.find((x) => x.id === selectedId) || businesses[0];
      updateQrStudio(b);
    }
  }

  qrBizSelect?.addEventListener('change', () => {
    const b = businesses.find((x) => x.id === qrBizSelect.value);
    if (b) updateQrStudio(b);
  });

  function updateQrStudio(biz: Business) {
    selectedBizForQr = biz;
    const fullUrl = qrUrlFor(biz);
    if (qrEncodedUrlInput) qrEncodedUrlInput.value = fullUrl;
    if (qrPreviewBizName) qrPreviewBizName.textContent = biz.name;
    if (qrPreviewTagline) qrPreviewTagline.textContent = biz.short_code ? `/s/${biz.short_code}` : `/${biz.slug}`;

    renderQrCode();
  }

  function renderQrCode() {
    if (!selectedBizForQr || !qrPreviewContainer) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const color = qrColorPicker?.value || '#000000';

    const qr = new QRCode(fullUrl);
    const svgString = qr.toSVG({
      color,
      bgColor: '#ffffff',
      margin: 2,
      size: 240,
    });

    qrPreviewContainer.innerHTML = svgString;

    // Render to export canvas for PNG download
    if (qrExportCanvas) {
      qr.renderToCanvas(qrExportCanvas, {
        color,
        bgColor: '#ffffff',
        margin: 3,
        size: 1024,
      });
    }
  }

  qrColorPicker?.addEventListener('input', renderQrCode);

  qrMatchBrandBtn?.addEventListener('click', () => {
    if (selectedBizForQr && qrColorPicker) {
      qrColorPicker.value = selectedBizForQr.brand_color || '#2563eb';
      renderQrCode();
    }
  });

  qrResetBlackBtn?.addEventListener('click', () => {
    if (qrColorPicker) {
      qrColorPicker.value = '#000000';
      renderQrCode();
    }
  });

  copyQrUrlBtn?.addEventListener('click', () => {
    if (qrEncodedUrlInput) {
      navigator.clipboard.writeText(qrEncodedUrlInput.value);
      alert('URL copied to clipboard: ' + qrEncodedUrlInput.value);
    }
  });

  // Download PNG (1024x1024)
  downloadPngBtn?.addEventListener('click', () => {
    if (!selectedBizForQr || !qrExportCanvas) return;
    const link = document.createElement('a');
    link.download = `reviewhub-qr-${selectedBizForQr.short_code || selectedBizForQr.slug}.png`;
    link.href = qrExportCanvas.toDataURL('image/png');
    link.click();
  });

  // Download SVG
  downloadSvgBtn?.addEventListener('click', () => {
    if (!selectedBizForQr) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const color = qrColorPicker?.value || '#000000';
    const qr = new QRCode(fullUrl);
    const svg = qr.toSVG({ color, bgColor: '#ffffff', margin: 2, size: 512 });

    const blob = new Blob([svg], { type: 'image/svg+xml' });
    const link = document.createElement('a');
    link.download = `reviewhub-qr-${selectedBizForQr.short_code || selectedBizForQr.slug}.svg`;
    link.href = URL.createObjectURL(blob);
    link.click();
  });

  // Open 1-Click Printable Counter Tent Stand
  openPrintCardBtn?.addEventListener('click', () => {
    if (!selectedBizForQr) return;
    const fullUrl = qrUrlFor(selectedBizForQr);
    const qr = new QRCode(fullUrl);
    const qrSvg = qr.toSVG({ color: '#000000', bgColor: '#ffffff', margin: 2, size: 260 });

    if (printCardLogo) printCardLogo.src = selectedBizForQr.logo_url || '';
    if (printCardTitle) printCardTitle.textContent = selectedBizForQr.name;
    if (printCardTagline) printCardTagline.textContent = selectedBizForQr.tagline || 'Specialty Local Service';
    if (printCardQrBox) printCardQrBox.innerHTML = qrSvg;
    if (printCardUrl) printCardUrl.textContent = fullUrl;

    window.print();
  });

  // ============================================================================
  // Analytics Dashboard
  // ============================================================================
  async function renderAnalytics() {
    let totalViews = 0;
    let totalReviews = 0;
    let totalWa = 0;
    let totalCalls = 0;
    let totalSocials = 0;
    const summaries: AnalyticsSummary[] = [];

    for (const biz of businesses) {
      const summary = await DatabaseService.getAnalytics(biz.id, biz.slug);
      summaries.push(summary);
      totalViews += summary.page_views;
      totalReviews += summary.google_review_clicks;
      totalWa += summary.whatsapp_clicks;
      totalCalls += summary.call_clicks;
      totalSocials += summary.instagram_clicks + summary.facebook_clicks;
    }

    if (statTotalViews) statTotalViews.textContent = String(totalViews);
    if (statReviewClicks) statReviewClicks.textContent = String(totalReviews);
    if (statWaClicks) statWaClicks.textContent = String(totalWa);
    if (statSocialClicks) statSocialClicks.textContent = String(totalCalls + totalSocials);
    if (statAvgConversion) {
      const avgRate = totalViews > 0 ? Math.round((totalReviews / totalViews) * 100) : 0;
      statAvgConversion.textContent = `${avgRate}%`;
    }

    // Populate Table
    if (analyticsTableBody) {
      analyticsTableBody.innerHTML = summaries
        .map((s) => {
          const biz = businesses.find((b) => b.id === s.business_id);
          return `
            <tr style="border-bottom: 1px solid var(--border-subtle);">
              <td style="padding: 1rem;">
                <div style="font-weight: 700; color: #ffffff;">${biz ? biz.name : s.slug}</div>
                <div style="font-size: 0.75rem; color: #818cf8; font-family: monospace;">/${s.slug}</div>
              </td>
              <td style="padding: 1rem; text-align: center; font-weight: 600;">${s.page_views}</td>
              <td style="padding: 1rem; text-align: center; font-weight: 700; color: #60a5fa;">${s.google_review_clicks}</td>
              <td style="padding: 1rem; text-align: center; font-weight: 600; color: #4ade80;">${s.whatsapp_clicks}</td>
              <td style="padding: 1rem; text-align: center; font-weight: 600; color: #38bdf8;">${s.call_clicks + s.instagram_clicks + s.facebook_clicks}</td>
              <td style="padding: 1rem; text-align: center;">
                <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                  <div style="width: 60px; height: 6px; background: #374151; border-radius: 3px; overflow: hidden;">
                    <div style="width: ${Math.min(100, s.conversion_rate)}%; height: 100%; background: #fbbf24;"></div>
                  </div>
                  <span style="font-weight: 700; color: #fde047;">${s.conversion_rate}%</span>
                </div>
              </td>
            </tr>
          `;
        })
        .join('');
    }

    // Populate Live Activity Feed
    if (liveActivityFeed) {
      const feedItems: { text: string; time: string; icon: string }[] = [];
      summaries.forEach((s) => {
        const biz = businesses.find((b) => b.id === s.business_id);
        const name = biz ? biz.name : s.slug;
        if (s.google_review_clicks > 0) {
          feedItems.push({
            text: `Customer rated 5-stars on Google for <strong>${name}</strong>`,
            time: '5 mins ago',
            icon: '⭐',
          });
        }
        if (s.whatsapp_clicks > 0) {
          feedItems.push({
            text: `Customer initiated WhatsApp chat with <strong>${name}</strong>`,
            time: '18 mins ago',
            icon: '💬',
          });
        }
        if (s.page_views > 0) {
          feedItems.push({
            text: `QR code scanned at counter for <strong>${name}</strong>`,
            time: '24 mins ago',
            icon: '📱',
          });
        }
      });

      if (feedItems.length === 0) {
        liveActivityFeed.innerHTML = `
          <div style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
            No interactions recorded yet. Scan a counter card to see live interactions here!
          </div>
        `;
      } else {
        liveActivityFeed.innerHTML = feedItems
          .map(
            (item) => `
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
              <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: #e5e7eb;">
                <span>${item.icon}</span>
                <span>${item.text}</span>
              </div>
              <span style="font-size: 0.75rem; color: var(--text-dim);">${item.time}</span>
            </div>
          `
          )
          .join('');
      }
    }
  }

  // ============================================================================
  // Supabase Setup Modal
  // ============================================================================
  supabaseSetupModalBtn?.addEventListener('click', () => {
    if (supabaseModal) supabaseModal.style.display = 'flex';
  });

  closeSupabaseModalBtn?.addEventListener('click', () => {
    if (supabaseModal) supabaseModal.style.display = 'none';
  });

  copySqlBtn?.addEventListener('click', () => {
    if (sqlCodeTextarea && copySqlBtnText) {
      navigator.clipboard.writeText(sqlCodeTextarea.value);
      copySqlBtnText.textContent = '✓ Copied to Clipboard!';
      setTimeout(() => {
        copySqlBtnText.textContent = 'Copy Migration SQL';
      }, 2000);
    }
  });

  // Start
  signOutBtn?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signOut();
    window.location.replace('/admin/login');
  });

  loadData();
</script>
