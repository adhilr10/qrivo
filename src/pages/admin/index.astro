  // ── Bulk QR stock ───────────────────────────────────────────────────────
  function stockLinkUrl(code: string): string {
    return shortLinkUrl(window.location.origin, code);
  }

  function renderQrStock() {
    if (!qrStockList) return;
    const count = unassignedShortLinks.length;
    if (qrStockCountBadge) qrStockCountBadge.textContent = `${count} in stock`;

    if (count === 0) {
      stockGroups = [];
      qrStockList.innerHTML =
        '<div class="qr-stock-empty">No blank QR codes yet. Create a batch above — print them now and assign each one when a business signs up.</div>';
      return;
    }

    // Group by the batch label stored on the short link, so a whole print run
    // can be downloaded again as one ZIP later.
    const groups = new Map<string, ShortLink[]>();
    for (const link of unassignedShortLinks) {
      const key = (link.last_label || '').trim();
      const bucket = groups.get(key);
      if (bucket) bucket.push(link);
      else groups.set(key, [link]);
    }

    stockGroups = [...groups.entries()]
      .map(([label, links]) => ({ label, links }))
      .sort((a, b) => a.label.localeCompare(b.label));

    qrStockList.innerHTML = stockGroups.map((group, groupIndex) => {
      const batchName = group.label || 'Unlabeled batch';
      const items = group.links.map(link => {
        const created = link.created_at
          ? new Date(link.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
          : '';
        return `
          <div class="qr-stock-item">
            <span class="qr-stock-code">/s/${link.code}</span>
            <span class="qr-stock-meta">${created || 'blank stand'}</span>
            <div class="qr-stock-actions">
              <button type="button" class="btn btn-outline btn-sm" data-stock-act="copy" data-code="${link.code}">Copy</button>
              <button type="button" class="btn btn-outline btn-sm" data-stock-act="png" data-code="${link.code}">Card</button>
              <button type="button" class="btn btn-secondary btn-sm" data-stock-act="assign" data-code="${link.code}">Assign</button>
            </div>
          </div>`;
      }).join('');

      return `
        <div class="qr-stock-batch">
          <div class="qr-stock-batch-head">
            <span class="qr-stock-batch-name">${escapeHtml(batchName)}</span>
            <span class="qr-stock-batch-count">${group.links.length} ${group.links.length === 1 ? 'code' : 'codes'}</span>
            <button
              type="button"
              class="btn btn-secondary btn-sm qr-stock-batch-download"
              data-stock-batch="${groupIndex}"
              title="Download this batch as a ZIP of printable card images"
            >⬇ Download ZIP</button>
          </div>
          ${items}
        </div>`;
    }).join('');

    qrStockList.querySelectorAll<HTMLElement>('[data-stock-act]').forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.dataset.code || '';
        const act = btn.dataset.stockAct;
        if (act === 'copy') void copyStockLink(btn, code);
        else if (act === 'png') void downloadStockPng(code);
        else if (act === 'assign') void openAssignModal(code);
      });
    });

    qrStockList.querySelectorAll<HTMLElement>('[data-stock-batch]').forEach(btn => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.stockBatch || -1);
        const group = stockGroups[index];
        if (!group) return;
        void downloadQrZip(group.links, group.label, btn);
      });
    });
  }

  function sanitizeFilePart(value: string, fallback: string): string {
    const cleaned = (value || '')
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60);
    return cleaned || fallback;
  }

  // ── Branded counter cards ─────────────────────────────────────────────
  // The QR is drawn onto the white board of the Qrivo template. The server
  // route uses sharp (best quality); Cloudflare Workers cannot run native
  // modules, so the same geometry is replayed on a Canvas in the browser.
  let cardRendererMode: 'unknown' | 'server' | 'canvas' = 'unknown';

  function cardFileName(code: string, format: 'png' | 'jpeg'): string {
    return `qrivo-card-${code}.${format === 'jpeg' ? 'jpg' : 'png'}`;
  }

  function downloadBlob(blob: Blob, fileName: string) {
    const href = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = href;
    a.download = fileName;
    a.click();
    setTimeout(() => URL.revokeObjectURL(href), 5000);
  }

  async function generateQrCard(url: string, format: 'png' | 'jpeg'): Promise<Blob> {
    if (cardRendererMode !== 'canvas') {
      try {
        const response = await fetch('/api/qr-card', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, format }),
        });
        if (response.ok) {
          const blob = await response.blob();
          if (blob.size > 0 && blob.type.startsWith('image/')) {
            cardRendererMode = 'server';
            return blob;
          }
        } else if (response.status === 501) {
          // Native sharp is not available on this runtime — stop probing and
          // render every card in this batch on the Canvas.
          cardRendererMode = 'canvas';
        }
      } catch (error) {
        console.warn('Server card renderer unavailable, using Canvas:', error);
        cardRendererMode = 'canvas';
      }
    }
    return renderQrCardOnCanvas(url, format);
  }

  async function downloadQrCard(url: string, code: string, format: 'png' | 'jpeg' = 'png') {
    const blob = await generateQrCard(url, format);
    downloadBlob(blob, cardFileName(code, format));
  }

  async function downloadQrZip(links: ShortLink[], batchLabel: string, button?: HTMLElement | null) {
    if (links.length === 0) return;

    const fallback = `batch-${new Date().toISOString().slice(0, 10)}`;
    const zipName = `qrivo-qr-${sanitizeFilePart(batchLabel, fallback)}`;
    const originalHtml = button?.innerHTML;
    if (button) button.setAttribute('disabled', 'true');

    try {
      const zip = new JSZip();
      const folder = zip.folder(zipName);
      if (!folder) throw new Error('Could not create the ZIP folder.');

      const rows = ['code,url,file'];
      for (let index = 0; index < links.length; index++) {
        const code = links[index].code;
        const url = stockLinkUrl(code);
        if (button) button.textContent = `Preparing ${index + 1}/${links.length}…`;

        // JPEG keeps a 100-code batch to a few megabytes; the card artwork has
        // no transparency, so there is nothing to lose versus PNG.
        const blob = await generateQrCard(url, 'jpeg');
        folder.file(`${code}.jpg`, blob);
        rows.push(`${code},${url},${code}.jpg`);
      }

      folder.file('codes.csv', rows.join('\n'));
      folder.file(
        'README.txt',
        [
          'Qrivo counter cards',
          `Batch: ${batchLabel || 'unlabeled'}`,
          `Cards: ${links.length}`,
          '',
          'Every card has a QR encoding a permanent /s/<code> link.',
          'Print the JPGs, then assign each code in Admin -> QR Codes.',
          'If a shop says no, reassign the same stand — no reprint needed.',
        ].join('\n'),
      );

      const blob = await zip.generateAsync({ type: 'blob' });
      const href = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = href;
      a.download = `${zipName}.zip`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(href), 5000);
    } catch (error) {
      alert(`Could not build the ZIP.\n\n${String(error)}`);
    } finally {
      if (button) {
        button.removeAttribute('disabled');
        if (originalHtml) button.innerHTML = originalHtml;
      }
    }
  }

  async function copyStockLink(btn: HTMLElement, code: string) {
