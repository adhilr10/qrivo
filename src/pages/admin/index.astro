---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Qrivo Admin | Manage Businesses & Counter QR Codes" hideNav={false} noindex={true}>
  <div class="admin-page-container">

    <!-- ======================================================================
         TOP HEADER (collapses on mobile to just title + action row)
         ====================================================================== -->
    <div class="admin-header no-print">
      <div class="container">
        <!-- Row 1: title + status + sign-out -->
        <div class="admin-header-top">
          <div class="admin-header-title-group">
            <h1 class="admin-header-title">Admin Portal</h1>
            <span id="backendStatusPill" class="status-pill local">
              <span class="status-dot"></span>
              <span id="backendStatusText">Checking…</span>
            </span>
          </div>
          <div class="admin-header-actions">
            <span id="adminUserEmail" class="admin-user-email"></span>
            <button id="supabaseSetupModalBtn" class="btn btn-outline btn-sm" title="Supabase SQL">
              <Icon name="settings" size={15} />
              <span class="hide-xs">SQL</span>
            </button>
            <button id="signOutBtn" class="btn btn-outline btn-sm">
              <span>Sign out</span>
            </button>
            <button id="openNewBizBtn" class="btn btn-primary btn-sm">
              <Icon name="plus" size={16} />
              <span>Add</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         DESKTOP TABS (hidden on mobile – replaced by bottom bar)
         ====================================================================== -->
    <div class="container">
      <div class="admin-tabs no-print desktop-tabs">
        <button class="tab-btn active" data-tab="businessesTab">
          <Icon name="shield-check" size={17} />
          <span>Businesses (<span id="bizCountBadge">0</span>)</span>
        </button>
        <button class="tab-btn" data-tab="recordsTab">
          <Icon name="receipt" size={17} />
          <span>Sales &amp; Expenses</span>
        </button>
        <button class="tab-btn" data-tab="moneyTab">
          <Icon name="bar-chart" size={17} />
          <span>Money</span>
        </button>
        <button class="tab-btn" data-tab="qrStudioTab">
          <Icon name="qrcode" size={17} />
          <span>QR Codes</span>
        </button>
      </div>
    </div>

    <!-- ======================================================================
         MAIN CONTENT AREA
         ====================================================================== -->
    <div class="container tab-container">

      <!-- ── TAB 1: BUSINESSES ─────────────────────────────────────────── -->
      <div id="businessesTab" class="tab-content">

        <!-- Search bar -->
        <div class="search-bar-row">
          <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              id="searchBizInput"
              placeholder="Search businesses…"
              class="form-input search-input"
            />
          </div>
          <div class="biz-pay-filter" id="bizPayFilter" role="group" aria-label="Filter businesses by payment">
            <button type="button" class="biz-pay-filter-btn is-active" data-pay-filter="all">
              All <span class="biz-pay-count" id="bizPayAllCount">0</span>
            </button>
            <button type="button" class="biz-pay-filter-btn" data-pay-filter="paid">
              Paid <span class="biz-pay-count" id="bizPayPaidCount">0</span>
            </button>
            <button type="button" class="biz-pay-filter-btn" data-pay-filter="unpaid">
              Not paid <span class="biz-pay-count" id="bizPayUnpaidCount">0</span>
            </button>
          </div>
          <button
            type="button"
            id="fixSlugsBtn"
            class="btn btn-outline btn-sm"
            title="Rewrite every business URL from name, category, area and road"
          >
            Fix URLs
          </button>
          <div class="search-tip hide-sm">
            💡 <em>Printed /s/ links never change — reassign after rejection, no reprint.</em>
          </div>
        </div>

        <!-- Business cards grid -->
        <div class="business-list-grid" id="businessListContainer">
          <div class="loading-placeholder">Loading businesses…</div>
        </div>
      </div>

      <!-- ── TAB 2: QR CODES (STOCK + STUDIO) ──────────────────────────── -->
      <div id="qrStudioTab" class="tab-content" style="display:none;">

        <!-- Bulk blank stock: print first, assign to a business later -->
        <div class="glass-card qr-stock-panel">
          <div class="qr-stock-head">
            <div class="qr-stock-heading">
              <h2 class="section-title" style="margin-bottom:.15rem;">Bulk QR Stands — Blank Stock</h2>
              <p class="section-desc" style="margin-bottom:0;">
                Print QR codes before a business signs up. Each code is permanent, so a stand can be
                reassigned when a shop says no — no reprint.
              </p>
            </div>
            <span class="qr-stock-badge" id="qrStockCountBadge">0 in stock</span>
          </div>

          <div class="qr-bulk-row">
            <div class="form-group">
              <label class="form-label" for="qrBulkCount">How many codes?</label>
              <input type="number" id="qrBulkCount" class="form-input" min="1" max="200" step="1" value="10" />
            </div>
            <div class="form-group">
              <label class="form-label" for="qrBulkLabel">Batch label (optional)</label>
              <input type="text" id="qrBulkLabel" class="form-input" placeholder="e.g. October batch A" />
            </div>
            <button type="button" id="qrBulkCreateBtn" class="btn btn-primary qr-bulk-submit">
              <Icon name="plus" size={16} />
              <span id="qrBulkCreateLabel">Create QR codes</span>
            </button>
          </div>

          <p class="qr-bulk-cost" id="qrBulkCostHint"></p>

          <div id="qrBulkResult" class="qr-bulk-result" hidden></div>

          <div class="qr-stock-toolbar">
            <span class="qr-stock-toolbar-label">Unassigned stands</span>
            <div class="qr-stock-toolbar-actions">
              <button type="button" id="qrStockDownloadAllBtn" class="btn btn-secondary btn-sm">
                <Icon name="download" size={14} />
                <span>Download all (ZIP)</span>
              </button>
              <button type="button" id="qrStockRefreshBtn" class="btn btn-outline btn-sm">Refresh</button>
            </div>
          </div>

          <div id="qrStockList" class="qr-stock-list">
            <div class="qr-stock-empty">Loading QR stock…</div>
          </div>
        </div>

        <div class="qr-studio-grid">

          <!-- Left panel -->
          <div class="glass-card qr-panel">
            <h2 class="section-title" style="margin-bottom:.25rem;">Dynamic QR Studio</h2>
            <p class="section-desc">Branded counter cards with the QR printed on the Qrivo board, plus raw SVG. Always encodes the permanent <code>/s/xxxxxx</code> link.</p>

            <div class="form-group" style="margin-bottom:1.25rem;">
              <label class="form-label" for="qrBizSelect">Business Destination</label>
              <select id="qrBizSelect" class="form-select"></select>
            </div>

            <div class="form-group" style="margin-bottom:1.25rem;">
              <label class="form-label">Encoded URL</label>
              <div style="display:flex;gap:.5rem;">
                <input type="text" id="qrEncodedUrlInput" class="form-input" readonly />
                <button type="button" id="copyQrUrlBtn" class="btn btn-secondary btn-sm" title="Copy">
                  <Icon name="copy" size={16} />
                </button>
              </div>
              <span class="form-helper">Permanent shortener link encoded in the QR matrix.</span>
            </div>

            <div class="form-group" style="margin-bottom:1.5rem;">
              <label class="form-label">QR Color</label>
              <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
                <input type="color" id="qrColorPicker" value="#000000" class="color-input" />
                <button type="button" class="btn btn-outline btn-sm" id="qrMatchBrandBtn">Match Brand</button>
                <button type="button" class="btn btn-outline btn-sm" id="qrResetBlackBtn">Classic Black</button>
              </div>
            </div>

            <div class="qr-action-stack">
              <button type="button" id="downloadPngBtn" class="btn btn-primary" style="width:100%;">
                <Icon name="download" size={18} />
                <span>Download Card (1050×1500)</span>
              </button>
              <button type="button" id="downloadSvgBtn" class="btn btn-secondary" style="width:100%;">
                <Icon name="download" size={18} />
                <span>Download SVG (Vector)</span>
              </button>
              <button type="button" id="openPrintCardBtn" class="btn btn-outline" style="width:100%;border-color:#6366f1;color:#a5b4fc;">
                🖨️ Print Counter Tent Stand
              </button>
            </div>
          </div>

          <!-- Right: live QR preview -->
          <div class="glass-card qr-preview-panel">
            <div class="qr-preview-label">Live QR Preview</div>
            <div class="qr-preview-frame">
              <div id="qrPreviewContainer" class="qr-preview-inner"></div>
            </div>
            <div id="qrPreviewBizName" class="qr-biz-name">Select a business</div>
            <div id="qrPreviewTagline" class="qr-biz-tag">Point phone camera to test</div>
          </div>

        </div>
      </div>

      <!-- ── TAB 3: MONEY (summary + chart) ─────────────────────────────── -->
      <div id="moneyTab" class="tab-content" style="display:none;">

        <div class="money-summary-grid">
          <div class="money-stat money-stat-revenue">
            <span class="money-stat-label">Revenue collected</span>
            <span class="money-stat-value" id="statRevenue">₹0</span>
            <span class="money-stat-hint">Paid QR sales</span>
          </div>
          <div class="money-stat money-stat-cost">
            <span class="money-stat-label">Making cost</span>
            <span class="money-stat-value" id="statMakingCost">₹0</span>
            <span class="money-stat-hint">Sold QR cost + stock batches</span>
          </div>
          <div class="money-stat money-stat-expense">
            <span class="money-stat-label">Other expenses</span>
            <span class="money-stat-value" id="statExpenses">₹0</span>
            <span class="money-stat-hint">Travel, ads, packaging…</span>
          </div>
          <div class="money-stat money-stat-profit">
            <span class="money-stat-label">Profit</span>
            <span class="money-stat-value" id="statProfit">₹0</span>
            <span class="money-stat-hint">Revenue − cost − expenses</span>
          </div>
          <div class="money-stat">
            <span class="money-stat-label">QR stands sold</span>
            <span class="money-stat-value" id="statUnits">0</span>
            <span class="money-stat-hint">Paid units</span>
          </div>
          <div class="money-stat money-stat-pending">
            <span class="money-stat-label">Payment pending</span>
            <span class="money-stat-value" id="statPending">₹0</span>
            <span class="money-stat-hint">Not collected yet</span>
          </div>
        </div>

        <div class="glass-card money-rate-card">
          <div class="money-rate-copy">
            <h2 class="section-title" style="margin-bottom:.15rem;">Default pricing</h2>
            <p class="section-desc" style="margin-bottom:0;">
              New sales start with these numbers. Sales already saved keep their own price, so old profit never changes.
            </p>
          </div>
          <div class="money-rate-inputs">
            <label class="form-group">
              <span class="form-label">Sale price / QR (₹)</span>
              <input type="number" id="defaultSalePrice" class="form-input" min="0" step="1" value="400" />
            </label>
            <label class="form-group">
              <span class="form-label">Making cost / QR (₹)</span>
              <input type="number" id="defaultUnitCost" class="form-input" min="0" step="1" value="55" />
            </label>
            <span class="money-rate-margin" id="defaultMargin">Profit ₹345 per QR</span>
          </div>
        </div>

        <div class="glass-card money-chart-card">
          <div class="money-chart-head">
            <div>
              <h2 class="section-title" style="margin-bottom:.15rem;">Money trend</h2>
              <p class="section-desc" style="margin-bottom:0;">Sales against making cost + expenses, month by month.</p>
            </div>
            <select id="moneyChartMonths" class="form-select money-chart-range" aria-label="Chart range">
              <option value="6">Last 6 months</option>
              <option value="12">Last 12 months</option>
            </select>
          </div>
          <div id="moneyChart" class="money-chart"></div>
          <div class="money-legend">
            <span><i class="money-dot money-dot-revenue"></i>Revenue</span>
            <span><i class="money-dot money-dot-spend"></i>Cost + expenses</span>
            <span><i class="money-dot money-dot-profit"></i>Profit</span>
          </div>
        </div>

        <div class="money-records-cta">
          <button type="button" class="btn btn-outline" id="goRecordsBtn">
            <Icon name="receipt" size={16} />
            <span>View sales &amp; expense records</span>
          </button>
        </div>
      </div>

      <!-- ── TAB 4: SALES & EXPENSES ───────────────────────────────────── -->
      <div id="recordsTab" class="tab-content" style="display:none;">

        <div class="glass-card money-panel money-list-panel">
          <div class="money-panel-head">
            <h2 class="section-title" style="margin-bottom:0;">
              Sales <span id="salesCountBadge" class="money-count">0</span>
            </h2>
            <div class="money-panel-actions">
              <select id="salesFilter" class="form-select money-filter" aria-label="Filter sales">
                <option value="all">All payments</option>
                <option value="paid">Paid only</option>
                <option value="pending">Pending only</option>
              </select>
              <button type="button" id="openSaleModalBtn" class="btn btn-primary btn-sm">+ Add sale</button>
            </div>
          </div>
          <div id="salesList" class="money-list">
            <div class="money-empty">No sales recorded yet.</div>
          </div>
        </div>

        <div class="glass-card money-panel money-list-panel">
          <div class="money-panel-head">
            <h2 class="section-title" style="margin-bottom:0;">
              Expenses <span id="expensesCountBadge" class="money-count">0</span>
            </h2>
            <button type="button" id="openExpenseModalBtn" class="btn btn-primary btn-sm">+ Add expense</button>
          </div>
          <div id="expenseList" class="money-list">
            <div class="money-empty">No expenses recorded yet.</div>
          </div>
        </div>
      </div>

    </div><!-- /.container -->

    <!-- ======================================================================
         MOBILE BOTTOM TAB BAR (visible only on mobile)
         ====================================================================== -->
    <nav class="mobile-bottom-bar no-print" aria-label="Admin navigation">
      <button class="mobile-tab-btn active" data-tab="businessesTab">
        <span class="mobile-tab-icon">🏢</span>
        <span class="mobile-tab-label">Shops</span>
        <span class="mobile-tab-badge" id="mobileBizBadge">0</span>
      </button>
      <button class="mobile-tab-btn" data-tab="recordsTab">
        <span class="mobile-tab-icon">🧾</span>
        <span class="mobile-tab-label">Records</span>
      </button>
      <button class="mobile-tab-btn" data-tab="moneyTab">
        <span class="mobile-tab-icon">📈</span>
        <span class="mobile-tab-label">Money</span>
      </button>
      <button class="mobile-tab-btn" data-tab="qrStudioTab">
        <span class="mobile-tab-icon">⬛</span>
        <span class="mobile-tab-label">QR Codes</span>
      </button>
      <button class="mobile-tab-btn" id="mobileAddBizBtn">
        <span class="mobile-tab-icon">➕</span>
        <span class="mobile-tab-label">Add Shop</span>
      </button>
    </nav>

    <!-- ======================================================================
         MODAL: CREATE / EDIT BUSINESS
         ====================================================================== -->
    <div id="bizModal" class="modal-backdrop" style="display:none;">
      <div class="modal-dialog">
        <div class="modal-header">
          <h2 id="modalTitle" class="modal-title">Create Business</h2>
          <button type="button" id="closeModalBtn" class="modal-close-btn">&times;</button>
        </div>

        <div class="modal-body-split">
          <!-- Form -->
          <form id="bizForm" class="biz-form">
            <input type="hidden" id="formBizId" />

            <div class="form-group">
              <label class="form-label" for="formName">Business Name *</label>
              <input type="text" id="formName" class="form-input" placeholder="e.g. Bella Italia Trattoria" required />
            </div>

            <div class="form-group">
              <label class="form-label" for="formSlug">
                <span>Counter URL Slug *</span>
                <span id="slugAvailabilityBadge" style="font-size:.75rem;color:#34d399;">Available</span>
              </label>
              <div class="slug-row">
                <div class="slug-field">
                  <span class="slug-prefix">/</span>
                  <input type="text" id="formSlug" class="form-input slug-input" placeholder="bella-italia-restaurant-mg-road" required />
                </div>
                <button type="button" id="descriptiveSlugBtn" class="btn btn-outline btn-sm slug-descriptive-btn" title="Build from name, category, area and road">
                  Auto
                </button>
              </div>
              <span class="form-helper">Built from name + category + area + road. Printed QR codes use the shortener link, so changing it never needs a reprint.</span>
            </div>

            <div class="form-group" id="qrAssignGroup">
              <label class="form-label" for="formQrCode">
                <span>Counter QR Stand</span>
                <button type="button" id="openQrScanBtn" class="gl-label-btn">📷 Scan QR</button>
              </label>
              <select id="formQrCode" class="form-select"></select>
              <span class="form-helper" id="formQrHelper">
                Pick a blank QR from stock, or leave empty and assign one later from QR Codes.
              </span>
              <div id="formQrBanner" class="qr-form-banner" hidden></div>
            </div>

            <div id="reassignSlugNotice" class="notice-banner" style="display:none;">
              ♻️ <strong>QR stays valid:</strong> Changing the slug or links never requires a reprint.
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formLogoFile">Business Logo</label>
                <div class="logo-upload-row">
                  <div class="logo-upload-preview" id="logoUploadPreview">
                    <img id="logoUploadImg" alt="Selected logo preview" hidden />
                    <span class="logo-upload-empty" id="logoUploadEmpty">No logo</span>
                  </div>
                  <div class="logo-upload-actions">
                    <input type="file" id="formLogoFile" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" hidden />
                    <button type="button" id="logoUploadBtn" class="btn btn-secondary btn-sm">⬆ Upload image</button>
                    <button type="button" id="logoRemoveBtn" class="btn btn-outline btn-sm" hidden>Remove</button>
                    <span class="form-helper" id="logoUploadStatus" role="status" aria-live="polite">
                      PNG, JPG, WebP or SVG · up to 5 MB
                    </span>
                  </div>
                </div>
                <input type="hidden" id="formLogoUrl" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formBrandColor">Brand Color</label>
                <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
                  <input type="color" id="formBrandColor" value="#2563eb" class="color-input" />
                  <input type="text" id="formBrandColorText" class="form-input" value="#2563eb" style="width:100px;flex:0 1 100px;" />
                  <div style="display:flex;gap:4px;">
                    <button type="button" class="color-preset-dot" data-color="#2563eb" style="background:#2563eb;"></button>
                    <button type="button" class="color-preset-dot" data-color="#d97706" style="background:#d97706;"></button>
                    <button type="button" class="color-preset-dot" data-color="#059669" style="background:#059669;"></button>
                    <button type="button" class="color-preset-dot" data-color="#dc2626" style="background:#dc2626;"></button>
                    <button type="button" class="color-preset-dot" data-color="#7c3aed" style="background:#7c3aed;"></button>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formCategory">Shop Category</label>
              <input type="text" id="formCategory" class="form-input" list="shopCategoryOptions" placeholder="e.g. Restaurant, Bakery, Salon" />
              <datalist id="shopCategoryOptions">
                <option value="Restaurant"></option>
                <option value="Cafe"></option>
                <option value="Bakery"></option>
                <option value="Sweet Shop"></option>
                <option value="Grocery Store"></option>
                <option value="Salon"></option>
                <option value="Spa"></option>
                <option value="Gym"></option>
                <option value="Clinic"></option>
                <option value="Pharmacy"></option>
                <option value="Hotel"></option>
                <option value="Retail Store"></option>
                <option value="Service Center"></option>
              </datalist>
              <span class="form-helper">What kind of shop is this? Used in Google title and description.</span>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formPlaceName">Area / Locality</label>
                <input type="text" id="formPlaceName" class="form-input" placeholder="e.g. Connaught Place" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formRoad">Road / Street</label>
                <input type="text" id="formRoad" class="form-input" placeholder="e.g. MG Road" />
              </div>
            </div>
            <span class="form-helper" style="display:block;margin-top:-.5rem;margin-bottom:1rem;">
              Optional — shown under the shop name so customers recognise the location.
            </span>

            <div class="form-group">
              <label class="form-label" for="formGoogleUrl">
                <span>Google Review Link *</span>
                <button type="button" id="openGoogleLinkBtn" class="gl-label-btn">
                  🔍 Find my link
                </button>
              </label>
              <input type="url" id="formGoogleUrl" class="form-input" placeholder="https://search.google.com/local/writereview?placeid=…" required />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formWaNumber">WhatsApp Number</label>
                <input type="text" id="formWaNumber" class="form-input" value="91" placeholder="91XXXXXXXXXX" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formPhone">Phone Number</label>
                <input type="text" id="formPhone" class="form-input" value="91" placeholder="91XXXXXXXXXX" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formWaMessage">WhatsApp Greeting</label>
              <input type="text" id="formWaMessage" class="form-input" placeholder="Hi" />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="formInsta">Instagram Username</label>
                <input type="text" id="formInsta" class="form-input" placeholder="username" />
              </div>
              <div class="form-group">
                <label class="form-label" for="formFb">Facebook Username</label>
                <input type="text" id="formFb" class="form-input" placeholder="username" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="formCustomMsg">Custom Thank-You Message</label>
              <textarea id="formCustomMsg" class="form-textarea" rows="2" placeholder="Thank you for supporting our local team!"></textarea>
            </div>

            <div class="active-toggle-row">
              <div>
                <div class="active-toggle-title">Active Counter Stand</div>
                <div class="active-toggle-desc">Inactive stands show a friendly pause notice.</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="formIsActive" checked />
                <span class="slider round"></span>
              </label>
            </div>

            <div class="form-actions">
              <button type="button" id="cancelFormBtn" class="btn btn-secondary">Cancel</button>
              <button type="submit" id="saveBizSubmitBtn" class="btn btn-primary">
                <Icon name="check" size={16} />
                <span>Save Business</span>
              </button>
            </div>
          </form>

          <!-- Phone mockup (hidden on mobile) -->
          <div class="phone-mockup-wrapper">
            <div class="phone-mockup-label">Live Preview</div>
            <div class="smartphone-frame" id="livePhoneMockup">
              <div class="smartphone-screen" id="previewScreen">
                <div class="preview-logo-wrap">
                  <img id="prevImg" src="" class="preview-logo-img" />
                </div>
                <div id="prevName" style="font-size:1.1rem;font-weight:800;color:#0a0a0a;">Business Name</div>
                <div id="prevLocation" style="font-size:.68rem;color:#6b7280;font-weight:600;margin-bottom:.15rem;" hidden>Area · Road</div>
                <div id="prevCategory" style="font-size:.75rem;color:#4a4a4a;margin-bottom:.75rem;">Shop category</div>
