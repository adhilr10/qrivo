  // Prefix Indian numbers with 91; treat the bare default prefix as empty.
  function normalizePhone(value: string): string {
    const digits = value.replace(/\D/g, '');
    if (!digits || digits === DEFAULT_COUNTRY_CODE) return '';
    if (digits.length === 10) return `${DEFAULT_COUNTRY_CODE}${digits}`;
    if (digits.length === 11 && digits.startsWith('0')) return `${DEFAULT_COUNTRY_CODE}${digits.slice(1)}`;
    return digits;
  }

  // Accept a bare username (@handle or handle) and expand it to a full profile URL.
  function normalizeSocialHandle(value: string, base: string): string {
    const raw = value.trim().replace(/^@+/, '');
    if (!raw) return '';
    if (/^https?:\/\//i.test(raw)) return raw;
    return `${base}/${raw.replace(/^\/+/, '')}`;
  }

  // Show just the username in the edit form, not the full profile URL.
  function socialHandleFromUrl(value: string | undefined, domain: RegExp): string {
    if (!value) return '';
