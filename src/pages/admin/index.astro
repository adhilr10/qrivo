  async function createBulkQrCodes() {
    const count = Number(qrBulkCount?.value || 0);
    if (!Number.isFinite(count) || count < 1 || count > 200) {
      alert('Choose between 1 and 200 QR codes.');
      return;
    }
    const label = (qrBulkLabel?.value || '').trim() || defaultBatchLabel();
    if (qrBulkCreateBtn) qrBulkCreateBtn.disabled = true;
    if (qrBulkCreateLabel) qrBulkCreateLabel.textContent = 'Creating…';

    try {
      const created = await DatabaseService.createShortLinks(count, label);
      if (qrBulkLabel) qrBulkLabel.value = '';
      await reloadStock();
      showBulkResult(label, created);

      // Printing blank stands costs money. Record it automatically against the
      // current making cost so the Money tab always matches real spend. A
      // failure here must never block QR creation.
      if (created.length > 0) {
        const unitCost = Math.max(0, Number(moneySettings.unitCost) || 0);
        try {
          await DatabaseService.saveExpense({
            title: `Made ${created.length} QR ${created.length === 1 ? 'stand' : 'stands'}`,
            category: 'QR Making',
            amount: created.length * unitCost,
            expense_date: todayInputValue(),
            note: `Batch: ${label}`,
          });
          await loadMoneyData();
        } catch (expenseError) {
          console.warn('QR codes created, but the making expense could not be saved:', expenseError);
        }
      }
    } catch (error) {
      alert(`Could not create QR codes.\n\n${getSupabaseErrorMessage(error)}`);
    } finally {
      if (qrBulkCreateBtn) qrBulkCreateBtn.disabled = false;
      if (qrBulkCreateLabel) qrBulkCreateLabel.textContent = 'Create QR codes';
    }
  }

  function defaultBatchLabel(): string {
    const now = new Date();
    const pad = (value: number) => String(value).padStart(2, '0');
    return `Batch ${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
  }

  function escapeHtml(value: string): string {
    return (value || '').replace(/[&<>"']/g, char => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[char] || char;
    });
  }

  function showBulkResult(label: string, created: ShortLink[]) {
    if (!qrBulkResult) return;
    qrBulkResult.hidden = false;
    qrBulkResult.innerHTML = `
      <div class="qr-bulk-result-text">
        ✓ Created <strong>${created.length}</strong> QR ${created.length === 1 ? 'code' : 'codes'} in
        <strong>${escapeHtml(label)}</strong>.
        Download the batch as one ZIP of ready-to-print cards, then assign each code when a shop signs up.
      </div>
      <button type="button" class="btn btn-primary btn-sm" data-bulk-zip>
        ⬇ Download ${created.length} card${created.length === 1 ? '' : 's'} (ZIP)
      </button>`;
    qrBulkResult.querySelector('[data-bulk-zip]')?.addEventListener('click', event => {
      void downloadQrZip(created, label, event.currentTarget as HTMLElement);
    });
  }

  qrBulkCreateBtn?.addEventListener('click', () => { void createBulkQrCodes(); });
  qrStockRefreshBtn?.addEventListener('click', () => { void reloadStock(); });
  qrStockDownloadAllBtn?.addEventListener('click', () => {
