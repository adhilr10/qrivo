  function populateSaleBusinessSelect() {
    if (!saleBusinessInput) return;
    const current = saleBusinessInput.value;
    const options = ['<option value="">— Not linked / walk-in —</option>'];
    for (const biz of [...businesses].sort((a, b) => a.name.localeCompare(b.name))) {
      options.push(`<option value="${biz.id}">${escapeHtml(biz.name)}</option>`);
