  // ── Assign a stock QR to an existing business ───────────────────────────
  async function openAssignModal(code: string) {
    pendingAssignCode = code;
    if (!assignQrModal) return;

    const withQr = new Set(businesses.filter(b => b.short_code).map(b => b.id));
    const ordered = [...businesses].sort((a, b) => Number(withQr.has(a.id)) - Number(withQr.has(b.id)));

    if (assignBizSelect) {
      assignBizSelect.innerHTML = ordered.length
        ? ordered
            .map(b => `<option value="${b.id}">${b.name}${b.short_code ? ` — currently /s/${b.short_code}` : ' — no QR yet'}</option>`)
            .join('')
        : '<option value="">Add a business first</option>';
    }

    if (assignQrPreview) {
      assignQrPreview.innerHTML = `
        <div class="assign-qr-text">
          <span class="assign-qr-code">/s/${code}</span>
          Blank stand — pick the business that should answer this scan.
        </div>`;
      try {
        const svg = await QRCodeLib.toString(stockLinkUrl(code), {
          type: 'svg',
          margin: 1,
          width: 168,
          color: { dark: '#000000', light: '#ffffff' },
        });
        assignQrPreview.insertAdjacentHTML('afterbegin', svg);
      } catch {
        // The QR preview is optional; the code is still shown as text.
      }
    }

    assignQrModal.style.display = 'flex';
  }

  function closeAssignModal() {
    if (assignQrModal) assignQrModal.style.display = 'none';
    pendingAssignCode = '';
  }

  async function confirmAssignQr() {
    const businessId = assignBizSelect?.value || '';
    const code = pendingAssignCode;
    if (!code || !businessId) return;

    const biz = businesses.find(b => b.id === businessId);
    if (!biz) return;

    if (biz.short_code) {
      const ok = window.confirm(
        `"${biz.name}" currently uses /s/${biz.short_code}.\n\n` +
          `Assign /s/${code} instead? The old stand goes back to the unassigned list.`,
      );
      if (!ok) return;
    }

    if (confirmAssignQrBtn) { confirmAssignQrBtn.disabled = true; confirmAssignQrBtn.textContent = 'Assigning…'; }
    try {
      await DatabaseService.assignShortLink(biz.id, code, biz.name);
      closeAssignModal();
      await loadData();
    } catch (error) {
      alert(`Could not assign the QR.\n\n${getSupabaseErrorMessage(error)}`);
    } finally {
      if (confirmAssignQrBtn) { confirmAssignQrBtn.disabled = false; confirmAssignQrBtn.textContent = 'Assign QR'; }
    }
  }

