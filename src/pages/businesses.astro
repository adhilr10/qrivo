---
import Layout from '../layouts/Layout.astro';
import { DatabaseService } from '../lib/supabase';
import { businessCategory, businessLocationLine } from '../lib/seo';
import type { Business } from '../types';

let businesses: Business[] = [];

try {
  if (DatabaseService.isConfigured()) {
    businesses = (await DatabaseService.getBusinesses())
      .filter(business => business.is_active)
      .sort((a, b) => a.name.localeCompare(b.name));
  }
} catch (error) {
  console.warn('Unable to load the business directory at build time:', error);
}

const site = Astro.site ?? new URL('https://qrivo.amazementtech521.workers.dev');
const directoryUrl = new URL('/businesses/', site).href;
const pageTitle = 'Local Business Directory | Qrivo';
const pageDescription =
  'Browse local shops and businesses using Qrivo counter QR cards. Find restaurants, cafes, salons, clinics and more by area and road.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${directoryUrl}#page`,
      url: directoryUrl,
      name: pageTitle,
      description: pageDescription,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: 'Businesses', item: directoryUrl },
      ],
    },
    {
      '@type': 'ItemList',
      itemListElement: businesses.map((business, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: business.name,
        url: new URL(`/${business.slug}/`, site).href,
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <section class="directory-page container">
    <header class="directory-head">
      <p class="directory-kicker">LOCAL BUSINESS DIRECTORY</p>
      <h1>Businesses on Qrivo</h1>
      <p class="directory-intro">
        Find local shops by name, category, area or road. Every business below uses a Qrivo counter
        QR stand, so you can leave a Google review in seconds.
      </p>
    </header>

    {businesses.length === 0 ? (
      <div class="directory-empty">
        <p>No active businesses yet.</p>
      </div>
    ) : (
      <div class="directory-grid">
        {businesses.map(business => {
          const category = businessCategory(business);
          const location = businessLocationLine(business);
          return (
            <a class="directory-card" href={`/${business.slug}/`}>
              <img
                class="directory-logo"
                src={business.logo_url || '/qrivo-logo.svg'}
                alt={`${business.name} logo`}
                loading="lazy"
              />
              <div class="directory-card-copy">
                <h2>{business.name}</h2>
                {category && <p class="directory-category">{category}</p>}
                {location && <p class="directory-location">📍 {location}</p>}
              </div>
              <span class="directory-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    )}
  </section>
</Layout>

<style>
  .directory-page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    max-width: 960px;
  }

  .directory-head {
    margin-bottom: 2rem;
  }

  .directory-kicker {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--brand);
    margin-bottom: 0.5rem;
  }

  .directory-head h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .directory-intro {
    max-width: 42rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .directory-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    background: var(--surface, #fffdf5);
    border: 2.5px solid var(--border-main, #0a0a0a);
    border-radius: 8px;
    box-shadow: 4px 4px 0 var(--border-main, #0a0a0a);
    color: inherit;
    text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .directory-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--border-main, #0a0a0a);
  }

  .directory-logo {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-main, #0a0a0a);
    background: #f0ede4;
  }

  .directory-card-copy {
    flex: 1;
    min-width: 0;
  }

  .directory-card-copy h2 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.25;
  }

  .directory-category {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand);
    margin-top: 0.2rem;
  }

  .directory-location {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .directory-arrow {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--brand);
  }

  .directory-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-muted);
    border: 2px dashed var(--border-main, #0a0a0a);
    border-radius: 8px;
  }

  @media (min-width: 640px) {
    .directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
