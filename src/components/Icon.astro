    | 'google'
    | 'whatsapp'
    | 'instagram'
    | 'facebook'
    | 'phone'
    | 'star'
    | 'shield-check'
    | 'qrcode'
    | 'copy'
    | 'download'
    | 'external-link'
    | 'sparkles'
    | 'settings'
    | 'bar-chart'
    | 'plus'
    | 'edit'
    | 'trash'
    | 'arrow-right'
    | 'check';
